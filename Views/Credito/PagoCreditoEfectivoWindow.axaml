<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        x:Class="NovaCoreESDM.Views.Credito.PagoCreditoEfectivoWindow"

        Width="720"
        Height="650"

        CanResize="False"
        WindowStartupLocation="CenterOwner"

        Title="Pago en efectivo"
        Background="#F3F6FA">

    <Border Margin="14"
            Padding="30"
            Background="White"
            CornerRadius="18">

        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="20">

            <!-- ================================================= -->
            <!-- ENCABEZADO                                        -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Spacing="5">

                <TextBlock Text="Pago en efectivo"
                           FontSize="34"
                           FontWeight="Bold"
                           Foreground="#0B3D6E"/>

                <TextBlock Text="Captura el efectivo recibido para calcular el cambio"
                           FontSize="14"
                           Foreground="#5F7591"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- TOTAL                                             -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="#4B36DD"
                    CornerRadius="15"
                    Padding="22">

                <Grid ColumnDefinitions="70,*,Auto"
                      ColumnSpacing="16">

                    <Border Grid.Column="0"
                            Width="60"
                            Height="60"
                            Background="#25FFFFFF"
                            CornerRadius="13"
                            VerticalAlignment="Center">

                        <TextBlock Text="🛒"
                                   FontSize="29"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">

                        <TextBlock Text="Total a pagar"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#E8E7FF"/>

                        <TextBlock Text="Importe total del abono de crédito"
                                   FontSize="11"
                                   Foreground="#CFCBFF"/>

                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               x:Name="TextoTotal"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- EFECTIVO RECIBIDO                                 -->
            <!-- ================================================= -->

            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#D7E0EB"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">

                <Grid ColumnDefinitions="58,*"
                      ColumnSpacing="16">

                    <Border Grid.Column="0"
                            Width="52"
                            Height="52"
                            Background="#E7F8EC"
                            CornerRadius="12"
                            VerticalAlignment="Center">

                        <TextBlock Text="💵"
                                   FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                Spacing="8">

                        <TextBlock Text="Efectivo recibido"
                                   Foreground="#17365D"
                                   FontSize="14"
                                   FontWeight="Bold"/>

                        <TextBox x:Name="CantidadRecibidaTextBox"
                                 Height="58"
                                 FontSize="24"
                                 HorizontalContentAlignment="Right"
                                 VerticalContentAlignment="Center"
                                 TextChanged="CantidadRecibida_TextChanged"
                                 Watermark="$0.00"
                                 BorderBrush="#BFD0E3"
                                 BorderThickness="1"
                                 CornerRadius="10"
                                 Padding="14,0"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- CAMBIO                                            -->
            <!-- ================================================= -->

            <Border Grid.Row="3"
                    Background="#EFFAF2"
                    BorderBrush="#B8E8C3"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="20">

                <Grid ColumnDefinitions="58,*,Auto"
                      ColumnSpacing="16">

                    <Border Grid.Column="0"
                            Width="52"
                            Height="52"
                            Background="#DDF5E5"
                            CornerRadius="12"
                            VerticalAlignment="Center">

                        <TextBlock Text="↩"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="#16803B"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">

                        <TextBlock Text="Cambio"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="#16803B"/>

                        <TextBlock Text="Cantidad que debe devolverse al cliente"
                                   FontSize="11"
                                   Foreground="#4F765C"/>

                    </StackPanel>

                    <TextBlock Grid.Column="2"
                               x:Name="TextoCambio"
                               Text="$0.00"
                               Foreground="#16803B"
                               FontSize="30"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- MENSAJE                                           -->
            <!-- ================================================= -->

            <Border Grid.Row="4"
                    Background="#FFF7F7"
                    BorderBrush="#F4C7CB"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12"
                    IsVisible="{Binding #TextoMensaje.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">

                <TextBlock x:Name="TextoMensaje"
                           Foreground="#C61F2B"
                           FontSize="11"
                           TextWrapping="Wrap"/>

            </Border>


            <!-- ================================================= -->
            <!-- BOTONES                                           -->
            <!-- ================================================= -->

            <Grid Grid.Row="5"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="16"
                  Margin="0,4,0,0">

                <Button Grid.Column="0"
                        Height="52"
                        Content="✕   Cancelar"
                        Click="Cancelar_Click"
                        Background="White"
                        Foreground="#C61F2B"
                        BorderBrush="#F3A7AD"
                        BorderThickness="1"
                        CornerRadius="10"
                        FontSize="14"
                        FontWeight="SemiBold"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>

                <Button Grid.Column="1"
                        x:Name="ConfirmarButton"
                        Height="52"
                        Content="✓   Confirmar pago"
                        Click="Confirmar_Click"
                        Background="#16A34A"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="10"
                        FontSize="14"
                        FontWeight="Bold"
                        IsEnabled="False"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>

            </Grid>

        </Grid>

    </Border>

</Window>