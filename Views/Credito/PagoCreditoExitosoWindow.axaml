<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:creditoModels="using:NovaCoreESDM.Models.Credito"

        x:Class="NovaCoreESDM.Views.Credito.PagoCreditoExitosoWindow"

        Width="560"
        Height="650"

        MinWidth="520"
        MinHeight="600"

        CanResize="False"

        WindowStartupLocation="CenterOwner"

        Title="Pago aplicado"

        Background="#F3F6FA">

    <Border Margin="18"
            Padding="24"
            Background="White"
            BorderBrush="#D7E0EB"
            BorderThickness="1"
            CornerRadius="18">

        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
              RowSpacing="18">


            <!-- ================================================= -->
            <!-- ENCABEZADO                                        -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Spacing="10"
                        HorizontalAlignment="Center">

                <Border Width="70"
                        Height="70"
                        CornerRadius="35"
                        Background="#EAF8EF">

                    <TextBlock Text="✓"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="#16A34A"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <TextBlock Text="Pago aplicado correctamente"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#17365D"
                           HorizontalAlignment="Center"/>


                <TextBlock Text="El abono fue registrado y aplicado al crédito del cliente."
                           FontSize="11"
                           Foreground="#64748B"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- MONTO                                            -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="#F6F4FF"
                    BorderBrush="#D7D0FF"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="18">

                <StackPanel Spacing="5"
                            HorizontalAlignment="Center">

                    <TextBlock Text="Monto aplicado"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#7065B5"
                               HorizontalAlignment="Center"/>


                    <StackPanel Orientation="Horizontal"
                                Spacing="2"
                                HorizontalAlignment="Center">

                        <TextBlock Text="$"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#4938D6"/>

                        <TextBlock x:Name="TextoMontoAplicado"
                                   Text="0.00"
                                   FontSize="30"
                                   FontWeight="Bold"
                                   Foreground="#4938D6"/>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- RESUMEN                                          -->
            <!-- ================================================= -->

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12">

                <!-- DOCUMENTOS -->

                <Border Grid.Column="0"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">

                    <StackPanel Spacing="5">

                        <TextBlock Text="Documentos afectados"
                                   FontSize="10"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="TextoDocumentosAfectados"
                                   Text="0"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#17365D"/>

                    </StackPanel>

                </Border>


                <!-- ESTADO -->

                <Border Grid.Column="1"
                        Background="#EFFAF2"
                        BorderBrush="#B8E8C3"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="14">

                    <StackPanel Spacing="5">

                        <TextBlock Text="Estado"
                                   FontSize="10"
                                   Foreground="#4F765C"/>

                        <TextBlock x:Name="TextoEstadoAbono"
                                   Text="APLICADO"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#16803B"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- DOCUMENTOS APLICADOS                             -->
            <!-- ================================================= -->

            <Border Grid.Row="3"
                    Background="#FBFCFE"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="13"
                    Padding="14">

                <Grid RowDefinitions="Auto,*"
                      RowSpacing="10">

                    <TextBlock Grid.Row="0"
                               Text="Detalle de documentos"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#17365D"/>


                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">

                        <ItemsControl x:Name="ListaDocumentosAplicados">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate x:DataType="creditoModels:DocumentoCreditoAplicado">
                                    
                                    <Border Margin="0,0,0,8"
                                            Padding="10"
                                            Background="White"
                                            BorderBrush="#E2E8F0"
                                            BorderThickness="1"
                                            CornerRadius="9">

                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="12">

                                            <StackPanel Grid.Column="0"
                                                        Spacing="3">

                                                <TextBlock Text="{Binding Folio}"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="#17365D"/>

                                                <TextBlock Text="{Binding TipoDocumento}"
                                                           FontSize="9"
                                                           Foreground="#64748B"/>

                                            </StackPanel>


                                            <StackPanel Grid.Column="1"
                                                        Spacing="2"
                                                        HorizontalAlignment="Right">

                                                <TextBlock Text="Aplicado"
                                                           FontSize="9"
                                                           Foreground="#64748B"
                                                           HorizontalAlignment="Right"/>

                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="2"
                                                            HorizontalAlignment="Right">

                                                    <TextBlock Text="$"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="#16803B"/>

                                                    <TextBlock Text="{Binding MontoAplicado}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               Foreground="#16803B"/>

                                                </StackPanel>

                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- BOTÓN CERRAR                                     -->
            <!-- ================================================= -->

            <Button Grid.Row="4"
                    Content="Cerrar"
                    Click="Cerrar_Click"

                    Height="58"
                    MinHeight="58"

                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"

                    Background="#0B4775"
                    Foreground="White"

                    BorderThickness="0"
                    CornerRadius="13"

                    FontSize="17"
                    FontWeight="Bold"

                    Padding="24,0"

                    Cursor="Hand"/>

        </Grid>

    </Border>

</Window>