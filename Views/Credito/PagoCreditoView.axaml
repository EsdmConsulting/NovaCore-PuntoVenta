<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

             xmlns:vm="using:NovaCoreESDM.ViewModels.Credito"
             xmlns:clientes="using:NovaCoreESDM.Models.Clientes"

             x:Class="NovaCoreESDM.Views.Credito.PagoCreditoView"

             x:Name="PagoCreditoRoot"

             x:DataType="vm:PagoCreditoViewModel"

             Background="#F3F6FA">


    <!-- ========================================================= -->
    <!-- CONTENEDOR PRINCIPAL                                      -->
    <!-- ========================================================= -->

    <Grid RowDefinitions="Auto,Auto,*"
          Margin="18"
          RowSpacing="14">


        <!-- ===================================================== -->
        <!-- ENCABEZADO                                            -->
        <!-- ===================================================== -->

        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto">


            <StackPanel Spacing="3">

                <TextBlock Text="Pagar crédito"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#0B3D6E"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Consulta saldos, documentos pendientes y registra abonos de crédito."
                           FontSize="12"
                           Foreground="#64748B"
                           TextWrapping="Wrap"/>

            </StackPanel>


            <!-- ESTADO DEL MÓDULO -->

            <Border Grid.Column="1"
                    Background="#EFFAF2"
                    BorderBrush="#B8E8C3"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,7"
                    VerticalAlignment="Center">

                <StackPanel Orientation="Horizontal"
                            Spacing="7">

                    <Border Width="8"
                            Height="8"
                            CornerRadius="4"
                            Background="#16A34A"
                            VerticalAlignment="Center"/>

                    <TextBlock Text="Módulo de crédito"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#16803B"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- CLIENTE                                               -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#D7E0EB"
                BorderThickness="1"
                CornerRadius="14"
                Padding="14">

            <Grid ColumnDefinitions="48,1.05*,1.4*,Auto"
                  ColumnSpacing="12">


                <!-- ================================================= -->
                <!-- ICONO                                             -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Width="44"
                        Height="44"
                        Background="#EEF2FF"
                        CornerRadius="11"
                        VerticalAlignment="Center">

                    <TextBlock Text="👤"
                               FontSize="21"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <!-- ================================================= -->
                <!-- CLIENTE SELECCIONADO                              -->
                <!-- ================================================= -->

                <StackPanel Grid.Column="1"
                            Spacing="3"
                            VerticalAlignment="Center">

                    <TextBlock Text="Cliente seleccionado"
                               FontSize="10"
                               Foreground="#64748B"/>

                    <TextBlock Text="{Binding ClienteSeleccionado.Nombre}"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#17365D"
                               TextWrapping="Wrap"
                               MaxLines="2"/>


                    <WrapPanel Orientation="Horizontal">

                        <TextBlock Text="{Binding ClienteSeleccionado.Codigo}"
                                   FontSize="9"
                                   Foreground="#64748B"
                                   Margin="0,0,6,0"/>

                        <TextBlock Text="•"
                                   FontSize="9"
                                   Foreground="#94A3B8"
                                   Margin="0,0,6,0"/>

                        <TextBlock Text="{Binding ClienteSeleccionado.Rfc}"
                                   FontSize="9"
                                   Foreground="#64748B"/>

                    </WrapPanel>

                </StackPanel>


                <!-- ================================================= -->
                <!-- BUSCADOR                                          -->
                <!-- ================================================= -->

                <Grid Grid.Column="2"
                      RowDefinitions="Auto,Auto">

                    <TextBox Grid.Row="0"
                             Text="{Binding TextoBusquedaCliente,
                                            Mode=TwoWay,
                                            UpdateSourceTrigger=PropertyChanged}"

                             Height="42"

                             Watermark="Buscar cliente por nombre..."

                             Padding="13,0"

                             FontSize="11"

                             CornerRadius="9"

                             BorderBrush="#CBD5E1"/>


                    <!-- ================================================= -->
                    <!-- SUGERENCIAS                                       -->
                    <!-- ================================================= -->

                    <Border Grid.Row="1"
                            IsVisible="{Binding MostrarSugerenciasClientes}"

                            Background="White"

                            BorderBrush="#CBD5E1"
                            BorderThickness="1"

                            CornerRadius="9"

                            Margin="0,5,0,0"

                            MaxHeight="210"

                            ZIndex="100">

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <ItemsControl ItemsSource="{Binding ClientesEncontrados}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate x:DataType="clientes:ClientePos">

                                        <Button Content="{Binding Nombre}"

                                                Command="{ReflectionBinding DataContext.SeleccionarClienteCommand,
                                                                            ElementName=PagoCreditoRoot}"

                                                CommandParameter="{Binding}"

                                                MinHeight="38"

                                                Padding="11,0"

                                                Background="White"

                                                Foreground="#334155"

                                                BorderThickness="0"

                                                HorizontalContentAlignment="Left"/>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- LIMPIAR CLIENTE                                   -->
                <!-- ================================================= -->

                <Button Grid.Column="3"

                        MinWidth="90"
                        Height="42"

                        Content="Limpiar"

                        Command="{Binding LimpiarClienteCommand}"

                        Background="White"

                        Foreground="#64748B"

                        BorderBrush="#CBD5E1"
                        BorderThickness="1"

                        CornerRadius="9"

                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"

                        VerticalAlignment="Center"/>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- CONTENIDO                                             -->
        <!-- ===================================================== -->

        <Grid Grid.Row="2"
              ColumnDefinitions="*,390"
              ColumnSpacing="14">


            <!-- ================================================= -->
            <!-- COLUMNA IZQUIERDA                                 -->
            <!-- ================================================= -->

            <Grid Grid.Column="0"
                  RowDefinitions="Auto,*"
                  RowSpacing="14">


                <!-- ================================================= -->
                <!-- RESUMEN                                           -->
                <!-- ================================================= -->

                <Grid Grid.Row="0"
                      ColumnDefinitions="*,*,*"
                      ColumnSpacing="10">


                    <!-- ================================================= -->
                    <!-- SALDO PENDIENTE                                   -->
                    <!-- ================================================= -->

                    <Border Grid.Column="0"
                            Background="#4B36DD"
                            CornerRadius="13"
                            Padding="15">

                        <StackPanel Spacing="6">

                            <TextBlock Text="Saldo pendiente"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#E4E1FF"/>


                            <StackPanel Orientation="Horizontal"
                                        Spacing="2">

                                <TextBlock Text="$"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                                <TextBlock Text="{Binding SaldoTotalTexto}"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="White"/>

                            </StackPanel>


                            <TextBlock Text="Deuda total actual"
                                       FontSize="9"
                                       Foreground="#CFCBFF"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- ================================================= -->
                    <!-- DISPONIBLE                                        -->
                    <!-- ================================================= -->

                    <Border Grid.Column="1"
                            Background="#EFFAF2"
                            BorderBrush="#B8E8C3"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="15">

                        <StackPanel Spacing="6">

                            <TextBlock Text="Crédito disponible"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#4F765C"/>


                            <StackPanel Orientation="Horizontal"
                                        Spacing="2">

                                <TextBlock Text="$"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#16803B"/>

                                <TextBlock Text="{Binding CreditoDisponibleTexto}"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#16803B"/>

                            </StackPanel>


                            <TextBlock Text="Disponible para nuevas compras"
                                       FontSize="9"
                                       Foreground="#65846C"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>


                    <!-- ================================================= -->
                    <!-- VENCIDO                                           -->
                    <!-- ================================================= -->

                    <Border Grid.Column="2"
                            Background="#FFF7F7"
                            BorderBrush="#F4C7CB"
                            BorderThickness="1"
                            CornerRadius="13"
                            Padding="15">

                        <StackPanel Spacing="6">

                            <TextBlock Text="Saldo vencido"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="#8A4A50"/>


                            <StackPanel Orientation="Horizontal"
                                        Spacing="2">

                                <TextBlock Text="$"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#C61F2B"/>

                                <TextBlock Text="{Binding SaldoVencidoTexto}"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#C61F2B"/>

                            </StackPanel>


                            <TextBlock Text="Documentos fuera de plazo"
                                       FontSize="9"
                                       Foreground="#9A656A"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                </Grid>


                <!-- ================================================= -->
                <!-- DOCUMENTOS                                        -->
                <!-- ================================================= -->

                <Border Grid.Row="1"
                        Background="White"
                        BorderBrush="#D7E0EB"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="15">

                    <Grid RowDefinitions="Auto,Auto,*"
                          RowSpacing="10">


                        <!-- ================================================= -->
                        <!-- ENCABEZADO                                        -->
                        <!-- ================================================= -->

                        <Grid Grid.Row="0"
                              ColumnDefinitions="*,Auto,Auto"
                              ColumnSpacing="8">

                            <StackPanel Spacing="2">

                                <TextBlock Text="Documentos pendientes"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#17365D"/>


                                <WrapPanel Orientation="Horizontal">

                                    <TextBlock Text="{Binding DocumentosSeleccionados}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#4B36DD"
                                               Margin="0,0,4,0"/>

                                    <TextBlock Text="documento(s) seleccionado(s)"
                                               FontSize="10"
                                               Foreground="#64748B"/>

                                </WrapPanel>

                            </StackPanel>


                            <Button Grid.Column="1"
                                    Height="36"

                                    Content="Seleccionar todos"

                                    Command="{Binding SeleccionarTodosCommand}"

                                    Background="#F8FAFC"
                                    Foreground="#475569"

                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"

                                    CornerRadius="8"

                                    Padding="12,0"/>


                            <Button Grid.Column="2"
                                    Height="36"

                                    Content="Limpiar"

                                    Command="{Binding LimpiarSeleccionCommand}"

                                    Background="White"
                                    Foreground="#64748B"

                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"

                                    CornerRadius="8"

                                    Padding="12,0"/>

                        </Grid>


                        <!-- ================================================= -->
                        <!-- CABECERA TABLA                                    -->
                        <!-- ================================================= -->

                        <Border Grid.Row="1"
                                Background="#F8FAFC"
                                CornerRadius="8"
                                Padding="10,7">

                            <Grid ColumnDefinitions="30,1.45*,0.8*,0.72*,1*"
                                  ColumnSpacing="9">

                                <TextBlock Grid.Column="1"
                                           Text="Documento"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>

                                <TextBlock Grid.Column="2"
                                           Text="Saldo"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>

                                <TextBlock Grid.Column="3"
                                           Text="Estado"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"/>

                                <TextBlock Grid.Column="4"
                                           Text="Monto a aplicar"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           Foreground="#64748B"
                                           TextWrapping="Wrap"/>

                            </Grid>

                        </Border>


                        <!-- ================================================= -->
                        <!-- LISTADO                                           -->
                        <!-- ================================================= -->

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <ItemsControl ItemsSource="{Binding DocumentosPendientes}">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate x:DataType="vm:DocumentoPagoCreditoItem">

                                        <Border Margin="0,0,0,8"
                                                Padding="10"
                                                Background="#FBFCFE"
                                                BorderBrush="#E2E8F0"
                                                BorderThickness="1"
                                                CornerRadius="10">

                                            <Grid ColumnDefinitions="30,1.45*,0.8*,0.72*,1*"
                                                  ColumnSpacing="9">


                                                <!-- ================================================= -->
                                                <!-- CHECK                                             -->
                                                <!-- ================================================= -->

                                                <CheckBox Grid.Column="0"
                                                          IsChecked="{Binding Seleccionado}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Center"/>


                                                <!-- ================================================= -->
                                                <!-- DOCUMENTO                                         -->
                                                <!-- ================================================= -->

                                                <StackPanel Grid.Column="1"
                                                            Spacing="2"
                                                            VerticalAlignment="Center">

                                                    <TextBlock Text="{Binding Folio}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#17365D"
                                                               TextTrimming="CharacterEllipsis"/>


                                                    <WrapPanel Orientation="Horizontal">

                                                        <TextBlock Text="{Binding TipoDocumento}"
                                                                   FontSize="8"
                                                                   Foreground="#64748B"
                                                                   Margin="0,0,4,0"/>

                                                        <TextBlock Text="•"
                                                                   FontSize="8"
                                                                   Foreground="#94A3B8"
                                                                   Margin="0,0,4,0"/>

                                                        <TextBlock Text="Vence:"
                                                                   FontSize="8"
                                                                   Foreground="#64748B"
                                                                   Margin="0,0,3,0"/>

                                                        <TextBlock Text="{Binding FechaVencimiento}"
                                                                   FontSize="8"
                                                                   Foreground="#64748B"/>

                                                    </WrapPanel>

                                                </StackPanel>


                                                <!-- ================================================= -->
                                                <!-- SALDO                                             -->
                                                <!-- ================================================= -->

                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="2"
                                                            VerticalAlignment="Center">

                                                    <TextBlock Text="$"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#17253B"/>

                                                    <TextBlock Text="{Binding SaldoTexto}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="#17253B"/>

                                                </StackPanel>


                                                <!-- ================================================= -->
                                                <!-- ESTADO                                            -->
                                                <!-- ================================================= -->

                                                <Border Grid.Column="3"
                                                        Background="#F1F5F9"
                                                        CornerRadius="7"
                                                        Padding="7,4"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center">

                                                    <TextBlock Text="{Binding EstadoTexto}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="#475569"/>

                                                </Border>


                                                <!-- ================================================= -->
                                                <!-- MONTO                                             -->
                                                <!-- ================================================= -->

                                                <Grid Grid.Column="4"
                                                      ColumnDefinitions="Auto,*"
                                                      VerticalAlignment="Center">

                                                    <TextBlock Text="$"
                                                               Margin="5,0,0,0"
                                                               FontSize="11"
                                                               Foreground="#475569"
                                                               VerticalAlignment="Center"/>

                                                    <TextBox Grid.Column="1"

                                                             Text="{Binding MontoAplicarTexto,
                                                                            Mode=TwoWay,
                                                                            UpdateSourceTrigger=PropertyChanged}"

                                                             LostFocus="MontoAplicarTextBox_LostFocus"

                                                             Height="36"

                                                             FontSize="10"

                                                             HorizontalContentAlignment="Right"
                                                             VerticalContentAlignment="Center"

                                                             BorderBrush="#CBD5E1"
                                                             BorderThickness="1"

                                                             CornerRadius="7"

                                                             Padding="7,0"/>

                                                </Grid>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </ScrollViewer>

                    </Grid>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- COLUMNA DERECHA                                   -->
            <!-- REGISTRAR PAGO                                    -->
            <!-- ================================================= -->

            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#D7E0EB"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">

                <!--
                    Auto = título
                    Auto = total
                    Auto = forma
                    Auto = referencia
                    Auto = info
                    *    = mensajes / espacio flexible
                    Auto = botones SIEMPRE visibles
                -->

                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto"
                      RowSpacing="10">


                    <!-- ================================================= -->
                    <!-- TÍTULO                                            -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Row="0"
                                Spacing="2">

                        <TextBlock Text="Registrar pago"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#17365D"/>

                        <TextBlock Text="Selecciona los documentos y define cómo se aplicará el abono."
                                   FontSize="9"
                                   Foreground="#64748B"
                                   TextWrapping="Wrap"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- TOTAL SELECCIONADO                                -->
                    <!-- ================================================= -->

                    <Border Grid.Row="1"
                            Background="#F6F4FF"
                            BorderBrush="#D7D0FF"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="12">

                        <StackPanel Spacing="3">

                            <TextBlock Text="Total seleccionado"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       Foreground="#7065B5"/>


                            <StackPanel Orientation="Horizontal"
                                        Spacing="2">

                                <TextBlock Text="$"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#4938D6"/>

                                <TextBlock Text="{Binding TotalSeleccionadoTexto}"
                                           FontSize="22"
                                           FontWeight="Bold"
                                           Foreground="#4938D6"/>

                            </StackPanel>


                            <WrapPanel Orientation="Horizontal">

                                <TextBlock Text="{Binding DocumentosSeleccionados}"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           Foreground="#7065B5"
                                           Margin="0,0,4,0"/>

                                <TextBlock Text="documento(s) seleccionado(s)"
                                           FontSize="8"
                                           Foreground="#7065B5"/>

                            </WrapPanel>

                        </StackPanel>

                    </Border>


                    <!-- ================================================= -->
                    <!-- FORMA DE PAGO                                     -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Row="2"
                                Spacing="4">

                        <TextBlock Text="Forma de pago"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <ComboBox ItemsSource="{Binding FormasPago}"
                                  SelectedItem="{Binding FormaPagoSeleccionada}"
                                  Height="40"
                                  HorizontalAlignment="Stretch"
                                  Padding="10,0"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- REFERENCIA                                        -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Row="3"
                                Spacing="4">

                        <TextBlock Text="Referencia"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"/>

                        <TextBox Text="{Binding Referencia}"
                                 Height="40"
                                 Watermark="Opcional"

                                 BorderBrush="#CBD5E1"
                                 BorderThickness="1"

                                 CornerRadius="8"

                                 Padding="10,0"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- INFORMACIÓN                                       -->
                    <!-- ================================================= -->

                    <Border Grid.Row="4"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="9">

                        <Grid ColumnDefinitions="24,*"
                              ColumnSpacing="8">

                            <Border Grid.Column="0"
                                    Width="23"
                                    Height="23"
                                    CornerRadius="6"
                                    Background="#EEF2FF"
                                    VerticalAlignment="Top">

                                <TextBlock Text="i"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#4B36DD"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <TextBlock Grid.Column="1"
                                       Text="Puedes pagar un documento completo, realizar un abono parcial, seleccionar varios documentos o liquidar todo el crédito."
                                       FontSize="8"
                                       Foreground="#64748B"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Border>


                    <!-- ================================================= -->
                    <!-- MENSAJES / ESPACIO FLEXIBLE                      -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="5"
                          MinHeight="8">

                        <StackPanel VerticalAlignment="Bottom"
                                    Spacing="3">

                            <TextBlock Text="{Binding MensajeError}"
                                       Foreground="#C61F2B"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>

                            <TextBlock Text="{Binding MensajeExito}"
                                       Foreground="#16803B"
                                       FontSize="9"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>

                        </StackPanel>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- BOTONES                                           -->
                    <!-- ================================================= -->

                    <Grid Grid.Row="6"
                          ColumnDefinitions="*,*"
                          ColumnSpacing="8">


                        <!-- ================================================= -->
                        <!-- PAGAR SELECCIONADOS                               -->
                        <!-- ================================================= -->

                        <Button Grid.Column="0"
                                Height="48"

                                Command="{Binding PagarSeleccionadosCommand}"

                                Background="#4B36DD"
                                Foreground="White"

                                BorderThickness="0"

                                CornerRadius="10"

                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">

                            <StackPanel Orientation="Horizontal"
                                        Spacing="5"
                                        HorizontalAlignment="Center">

                                <TextBlock Text="✓"
                                           FontSize="12"
                                           FontWeight="Bold"/>

                                <TextBlock Text="Pagar seleccionados"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Button>


                        <!-- ================================================= -->
                        <!-- LIQUIDAR TODO                                     -->
                        <!-- ================================================= -->

                        <Button Grid.Column="1"
                                Height="48"

                                Command="{Binding PagarTodoCommand}"

                                Background="#EFFAF2"
                                Foreground="#16803B"

                                BorderBrush="#B8E8C3"
                                BorderThickness="1"

                                CornerRadius="10"

                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center">

                            <TextBlock Text="Liquidar todo"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>

                        </Button>

                    </Grid>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</UserControl>