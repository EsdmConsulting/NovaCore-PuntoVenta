<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovaCoreESDM.ViewModels"
        x:Class="NovaCoreESDM.Views.LoginWindow"
        x:DataType="vm:LoginViewModel"
        Title="Grupo Luis Fer - Punto de Venta"
        Icon="/Assets/Brand/esdm-app-icon-2.ico"
        Width="1100"
        Height="680"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC">

    <Grid>

        <!-- Fondo -->
        <Border Background="#F8FAFC"/>

        <!-- Acentos decorativos inferiores -->
        <Ellipse Width="650"
                 Height="650"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-370,0,0,-380"
                 Fill="#17B455"/>

        <Ellipse Width="620"
                 Height="620"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-350,-360"
                 Fill="#C61F2B"/>

        <!-- Franja superior azul -->
        <Border Height="10"
                VerticalAlignment="Top"
                Background="#123B69"/>

        <!-- Contenedor -->
        <Border Width="510"
                Padding="48"
                CornerRadius="26"
                Background="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 12 35 0 #22000000">

            <StackPanel Spacing="12">

                <!-- Logo -->
                <Image Source="avares://NovaCoreESDM/Assets/logo_grupo_luisfer.png"
                       Width="240"
                       Height="145"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"/>

                <TextBlock Text="PUNTO DE VENTA"
                           Foreground="#123B69"
                           FontSize="26"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,0"/>

                <TextBlock Text="Ingresa tus credenciales para continuar"
                           Foreground="#64748B"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>
                


                <!-- Usuario -->
                <TextBlock Text="Usuario"
                           Foreground="#334155"
                           FontSize="13"
                           FontWeight="SemiBold"/>

                <TextBox Text="{Binding Usuario}"
                         Watermark="Escribe tu usuario"
                         Height="50"
                         Padding="14,0"
                         FontSize="14"
                         CornerRadius="10"/>


                <!-- Contraseña -->
                <TextBlock Text="Contraseña"
                           Foreground="#334155"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,8,0,0"/>

                <TextBox Text="{Binding Contrasena}"
                         Watermark="Escribe tu contraseña"
                         PasswordChar="●"
                         Height="50"
                         Padding="14,0"
                         FontSize="14"
                         CornerRadius="10"/>


                <!-- Error -->
                <TextBlock Text="{Binding MensajeError}"
                           Foreground="#C61F2B"
                           FontSize="12"
                           TextWrapping="Wrap"
                           MinHeight="20"
                           Margin="0,5,0,0"/>


                <!-- Botón principal -->
                <Button Command="{Binding IniciarSesionCommand}"
                        Height="54"
                        Margin="0,8,0,0"
                        Background="#16A34A"
                        Foreground="White"
                        CornerRadius="10"
                        HorizontalContentAlignment="Center"
                        FontSize="15"
                        FontWeight="Bold">

                    <Grid>

                        <TextBlock Text="INICIAR SESIÓN"
                                   IsVisible="{Binding !EstaCargando}"
                                   HorizontalAlignment="Center"/>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    IsVisible="{Binding EstaCargando}"
                                    HorizontalAlignment="Center">

                            <ProgressBar Width="24"
                                         Height="4"
                                         IsIndeterminate="True"
                                         VerticalAlignment="Center"/>

                            <TextBlock Text="Validando..."
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </Grid>

                </Button>


                <!-- ===================================================== -->
                <!-- TEMPORAL: PRUEBA DEL CAJÓN                            -->
                <!-- ===================================================== -->

                <Button Content="PRUEBA: ABRIR CAJÓN"
                        Click="AbrirCajonPrueba_Click"
                        Height="42"
                        Margin="0,4,0,0"
                        Background="White"
                        Foreground="#08783D"
                        BorderBrush="#16A34A"
                        BorderThickness="1"
                        CornerRadius="10"
                        HorizontalContentAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"/>


                <!-- Footer -->
                <TextBlock Text="Grupo Luis Fer"
                           Foreground="#475569"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>

                <TextBlock Text="Versión 0.1.0 · ESDM Consulting"
                           Foreground="#94A3B8"
                           FontSize="10"
                           HorizontalAlignment="Center"/>

            </StackPanel>
        </Border>

    </Grid>
</Window> 