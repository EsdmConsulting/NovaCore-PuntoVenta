<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:NovaCoreESDM.Desktop.Views.MercadoPago"
    xmlns:mp="clr-namespace:NovaCoreESDM.Desktop.Models.MercadoPago"
    x:Class="NovaCoreESDM.Desktop.Views.MercadoPago.MercadoPagoTerminalWindow"
    x:DataType="views:MercadoPagoTerminalWindow"
    Width="520"
    Height="480"
    MinWidth="520"
    MinHeight="420"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Title="Seleccionar terminal Mercado Pago">

    <Grid
        Margin="28"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="16">

        <!-- ================================================== -->
        <!-- TÍTULO -->
        <!-- ================================================== -->

        <StackPanel
            Grid.Row="0"
            Spacing="5">

            <TextBlock
                Text="Seleccionar terminal"
                FontSize="25"
                FontWeight="SemiBold" />

            <TextBlock
                Text="Selecciona la Point donde se realizará el cobro."
                FontSize="14"
                Opacity="0.65" />

        </StackPanel>


        <!-- ================================================== -->
        <!-- IMPORTE -->
        <!-- ================================================== -->

        <Border
            Grid.Row="1"
            Padding="14"
            CornerRadius="8"
            Background="#10000000">

            <Grid
                ColumnDefinitions="*,Auto">

                <TextBlock
                    Grid.Column="0"
                    Text="Total a cobrar"
                    VerticalAlignment="Center"
                    FontSize="14" />

                <TextBlock
                    Grid.Column="1"
                    Text="{Binding Importe, StringFormat='{}{0:C2}'}"
                    VerticalAlignment="Center"
                    FontSize="20"
                    FontWeight="Bold" />

            </Grid>

        </Border>


        <!-- ================================================== -->
        <!-- TERMINALES -->
        <!-- ================================================== -->

        <ListBox
            Grid.Row="2"
            ItemsSource="{Binding Terminales}"
            SelectedItem="{Binding TerminalSeleccionada, Mode=TwoWay}">

            <ListBox.ItemTemplate>

                <DataTemplate
                    x:DataType="mp:MercadoPagoTerminal">

                    <Border
                        Padding="14"
                        Margin="0,4"
                        CornerRadius="8">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto">

                            <!-- NOMBRE -->

                            <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="{Binding NombreVisual}"
                                FontSize="16"
                                FontWeight="SemiBold" />


                            <!-- DESCRIPCIÓN -->

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding DescripcionVisual}"
                                FontSize="13"
                                Opacity="0.65"
                                Margin="0,4,0,0" />


                            <!-- PREDETERMINADA -->

                            <Border
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="1"
                                Padding="10,5"
                                Margin="12,0,0,0"
                                CornerRadius="10"
                                VerticalAlignment="Center"
                                IsVisible="{Binding EsPredeterminada}">

                                <TextBlock
                                    Text="Predeterminada"
                                    FontSize="11"
                                    FontWeight="SemiBold" />

                            </Border>

                        </Grid>

                    </Border>

                </DataTemplate>

            </ListBox.ItemTemplate>

        </ListBox>


        <!-- ================================================== -->
        <!-- BOTONES -->
        <!-- ================================================== -->

        <Grid
            Grid.Row="3"
            ColumnDefinitions="*,*"
            ColumnSpacing="12">

            <Button
                Grid.Column="0"
                Content="Cancelar"
                Click="Cancelar_Click"
                Height="44"
                HorizontalContentAlignment="Center" />

            <Button
                Grid.Column="1"
                Content="Continuar"
                Click="Continuar_Click"
                Height="44"
                HorizontalContentAlignment="Center" />

        </Grid>

    </Grid>

</Window>