<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NovaCoreESDM.ViewModels.Reimpresion"
    xmlns:models="clr-namespace:NovaCoreESDM.Models.Cancelaciones"
    xmlns:controls="using:NovaCoreESDM.Controls"

    x:Class="NovaCoreESDM.Views.Reimpresion.ReimpresionView"
    x:DataType="vm:ReimpresionViewModel"
    x:Name="Root"

    Background="#F4F6F8">


    <!-- ========================================================= -->
    <!-- ESTILOS                                                   -->
    <!-- ========================================================= -->

    <UserControl.Styles>

        <Style Selector="Border.seccion">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EAEEF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BoxShadow" Value="0 1 2 0 #0A0F172A"/>
        </Style>

        <Style Selector="TextBlock.tituloSeccion">
            <Setter Property="Foreground" Value="#0B1220"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBlock.subtituloSeccion">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="17"/>
        </Style>

        <Style Selector="TextBlock.etiquetaCampo">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Campos -->
        <Style Selector="TextBox.campo, DatePicker.campo">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="TextBox.campo">
            <Setter Property="Padding" Value="4,0,14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.campo:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#16A34A"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BoxShadow" Value="0 0 0 4 #1F16A34A"/>
        </Style>

        <!-- Botones -->
        <Style Selector="Button.boton">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.verde">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#22C55E"/>
                    <GradientStop Offset="1" Color="#0E9A46"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.verde:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#16A34A"/>
        </Style>

        <Style Selector="Button.verde:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EEF1F4"/>
            <Setter Property="Foreground" Value="#B4BEC9"/>
        </Style>

        <Style Selector="Button.gris">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style Selector="Button.gris:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style Selector="Button.vidrio">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.vidrio:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C61F2B"/>
            <Setter Property="BorderBrush" Value="#C61F2B"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Renglón de ticket -->
        <Style Selector="Border.ticket">
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#EEF1F4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.ticket:pointerover">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CDE9D7"/>
        </Style>

        <Style Selector="Border.ticket.cancelado">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <!-- Etiqueta de estado -->
        <Style Selector="Border.estado">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="#EAF7EF"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.estado TextBlock">
            <Setter Property="Foreground" Value="#0B6B33"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="0.6"/>
        </Style>

        <Style Selector="Border.estado.cancelada">
            <Setter Property="Background" Value="#FEE2E2"/>
        </Style>

        <Style Selector="Border.estado.cancelada TextBlock">
            <Setter Property="Foreground" Value="#B91C1C"/>
        </Style>

    </UserControl.Styles>


    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <StackPanel
            Margin="28,24,28,28"
            Spacing="20">


            <!-- ================================================= -->
            <!-- ENCABEZADO                                        -->
            <!-- ================================================= -->

            <Border x:Name="BannerReimpresion"
                    CornerRadius="24"
                    ClipToBounds="True"
                    Background="#050607"
                    MinHeight="160">

                <Panel>

                    <Ellipse Width="520" Height="520"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-200,-280,0,0"
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#8816A34A"/>
                                <GradientStop Offset="1" Color="#0016A34A"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="460" Height="460"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-160,-300"
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#662563EB"/>
                                <GradientStop Offset="1" Color="#002563EB"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="24"
                          Margin="34,28">

                        <StackPanel VerticalAlignment="Center">

                            <Border HorizontalAlignment="Left"
                                    Padding="12,6"
                                    CornerRadius="999"
                                    Background="#14FFFFFF"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="7" Height="7"
                                             Fill="#22C55E"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Foreground="#D9E2EC"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1.2"
                                               VerticalAlignment="Center">
                                        <Run Text="AUTORIZADO POR  "/><Run Text="{Binding AdministradorAutorizado}" Foreground="White" FontWeight="Bold"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Reimpresión de tickets"
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       LetterSpacing="-0.8"
                                       Margin="0,14,0,0"/>

                            <TextBlock Text="Busca una venta finalizada y vuelve a imprimir su ticket."
                                       Foreground="#A8B4C2"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>

                        </StackPanel>

                        <!-- Escena animada: la lupa encuentra el ticket y sale la copia -->
                        <controls:EscenaReimpresionAnimada x:Name="EscenaReimpresion"
                                                           Grid.Column="1"
                                                           MaxWidth="420"
                                                           VerticalAlignment="Center"/>

                        <Button Grid.Column="2"
                                Classes="boton vidrio"
                                Height="50"
                                VerticalAlignment="Center"
                                Command="{Binding CerrarAccesoCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <PathIcon Width="16" Height="16"
                                          Data="M18 8h-1V6c0-2.8-2.2-5-5-5S7 3.2 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.7 1.4-3.1 3.1-3.1s3.1 1.4 3.1 3.1v2z"/>
                                <TextBlock Text="Cerrar acceso de administrador"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </Grid>

                </Panel>

            </Border>


            <!-- ================================================= -->
            <!-- FILTROS                                           -->
            <!-- ================================================= -->

            <Border Classes="seccion">

                <StackPanel Spacing="12">

                    <Grid ColumnDefinitions="250,250,*,Auto,Auto"
                          ColumnSpacing="14">

                        <StackPanel Grid.Column="0" Spacing="7">
                            <TextBlock Classes="etiquetaCampo" Text="Desde"/>
                            <DatePicker Classes="campo"
                                        SelectedDate="{Binding FechaDesde}"
                                        MinWidth="240"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="7">
                            <TextBlock Classes="etiquetaCampo" Text="Hasta"/>
                            <DatePicker Classes="campo"
                                        SelectedDate="{Binding FechaHasta}"
                                        MinWidth="240"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="7">
                            <TextBlock Classes="etiquetaCampo" Text="Folio del ticket"/>
                            <TextBox Classes="campo"
                                     Text="{Binding FolioBusqueda}"
                                     PlaceholderText="Ej. PV-001-B-00000001">
                                <TextBox.InnerLeftContent>
                                    <PathIcon Width="16" Height="16"
                                              Margin="14,0,8,0"
                                              Foreground="#94A3B8"
                                              Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                                </TextBox.InnerLeftContent>
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter"
                                                Command="{Binding BuscarCommand}"/>
                                </TextBox.KeyBindings>
                            </TextBox>
                        </StackPanel>

                        <Button Grid.Column="3"
                                Classes="boton verde"
                                MinWidth="120"
                                VerticalAlignment="Bottom"
                                Command="{Binding BuscarCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Width="16" Height="16"
                                          Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                                <TextBlock Text="Buscar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="4"
                                Classes="boton gris"
                                MinWidth="100"
                                VerticalAlignment="Bottom"
                                Command="{Binding LimpiarFiltrosCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Width="15" Height="15"
                                          Data="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11zM7 11h5v5H7z"/>
                                <TextBlock Text="Hoy" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <PathIcon Width="14" Height="14"
                                  Foreground="#94A3B8"
                                  Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                        <TextBlock Text="Puedes buscar un solo día (Desde = Hasta) o un rango de hasta 31 días. Enter en el folio también busca."
                                   Foreground="#94A3B8"
                                   FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- MENSAJES                                          -->
            <!-- ================================================= -->

            <Border Padding="16,12"
                    CornerRadius="14"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    IsVisible="{Binding HayError}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Width="18" Height="18"
                              Foreground="#C61F2B"
                              Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="#9F1239"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Padding="16,12"
                    CornerRadius="14"
                    Background="#EAF7EF"
                    BorderBrush="#BFE6CD"
                    BorderThickness="1"
                    IsVisible="{Binding HayExito}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Width="18" Height="18"
                              Foreground="#16A34A"
                              Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    <TextBlock Text="{Binding MensajeExito}"
                               Foreground="#0B6B33"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>


            <!-- ================================================= -->
            <!-- TICKETS (alto fijo: unos 10, el resto con scroll) -->
            <!-- ================================================= -->

            <Border Classes="seccion"
                    Height="860">

                <Grid RowDefinitions="Auto,Auto,*"
                      RowSpacing="12">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="tituloSeccion" Text="Tickets encontrados"/>
                            <TextBlock Classes="subtituloSeccion" Text="Las ventas canceladas se muestran, pero no se pueden reimprimir"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="12,6"
                                CornerRadius="999"
                                Background="#EAF7EF"
                                VerticalAlignment="Center">
                            <TextBlock Foreground="#0B6B33"
                                       FontSize="13"
                                       FontWeight="Bold">
                                <Run Text="{Binding Ventas.Count}"/><Run Text=" tickets"/>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <!-- Cargando / imprimiendo -->
                    <StackPanel Grid.Row="1" Spacing="8">
                        <ProgressBar IsVisible="{Binding EstaCargando}"
                                     IsIndeterminate="True"
                                     Height="3"
                                     MinHeight="3"
                                     Foreground="#16A34A"
                                     Background="#EAF7EF"/>
                        <Border IsVisible="{Binding EstaImprimiendo}"
                                Padding="12,8"
                                CornerRadius="12"
                                Background="#EEF4FB">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Width="16" Height="16"
                                          Foreground="#2563EB"
                                          Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/>
                                <TextBlock Text="Enviando ticket a la impresora…"
                                           Foreground="#1E4F8A"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>
                                <ProgressBar IsIndeterminate="True"
                                             Width="60"
                                             MinWidth="60"
                                             Height="4"
                                             Foreground="#2563EB"
                                             Background="#DCE8F8"
                                             VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Sin resultados -->
                    <StackPanel Grid.Row="2"
                                IsVisible="{Binding SinResultados}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="10">
                        <Panel Width="96" Height="96" HorizontalAlignment="Center">
                            <Ellipse Fill="#F4F6F8"/>
                            <Ellipse Width="70" Height="70" Fill="#EAEEF2"/>
                            <PathIcon Width="30" Height="30"
                                      Foreground="#94A3B8"
                                      Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                        </Panel>
                        <TextBlock Text="No se encontraron tickets con esos filtros."
                                   Foreground="#334155"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Lista -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl ItemsSource="{Binding Ventas}"
                                      Margin="0,0,10,0">

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:VentaCancelacionItem">

                                    <Border Classes="ticket"
                                            Classes.cancelado="{Binding EstaCancelada}">

                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                              ColumnSpacing="14">

                                            <Border Width="42" Height="42"
                                                    CornerRadius="13"
                                                    Background="#EEF2F6"
                                                    VerticalAlignment="Center">
                                                <PathIcon Width="19" Height="19"
                                                          Foreground="#475569"
                                                          Data="M18 17H6v-2h12v2zm0-4H6v-2h12v2zm0-4H6V7h12v2zM3 22l1.5-1.5L6 22l1.5-1.5L9 22l1.5-1.5L12 22l1.5-1.5L15 22l1.5-1.5L18 22l1.5-1.5L21 22V2l-1.5 1.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2 4.5 3.5 3 2v20z"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="3">
                                                <TextBlock Text="{Binding FolioMostrar}"
                                                           Foreground="#0F172A"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Foreground="#64748B"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Fecha}"/><Run Text="  ·  "/><Run Text="{Binding Hora}"/><Run Text="  ·  "/><Run Text="{Binding UsuarioRegistro}"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <Border Grid.Column="2"
                                                    Classes="estado"
                                                    Classes.cancelada="{Binding EstaCancelada}">
                                                <TextBlock Text="{Binding TextoEstado}"/>
                                            </Border>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding TextoTotal}"
                                                       Foreground="#0B1220"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       MinWidth="90"
                                                       TextAlignment="Right"
                                                       VerticalAlignment="Center"/>

                                            <Button Grid.Column="4"
                                                    Classes="boton verde"
                                                    Height="42"
                                                    Padding="16,0"
                                                    VerticalAlignment="Center"
                                                    Command="{Binding #Root.((vm:ReimpresionViewModel)DataContext).ReimprimirCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding PuedeReimprimir}">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <PathIcon Width="15" Height="15"
                                                              Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/>
                                                    <TextBlock Text="Reimprimir" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                    </ScrollViewer>

                </Grid>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
