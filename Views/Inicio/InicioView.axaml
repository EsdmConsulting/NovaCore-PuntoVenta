<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NovaCoreESDM.ViewModels.Inicio"

             x:Class="NovaCoreESDM.Views.Inicio.InicioView"
             x:DataType="vm:InicioViewModel"

             Background="#F4F6F8">

    <!-- ========================================================= -->
    <!-- ESTILOS                                                   -->
    <!-- ========================================================= -->

    <UserControl.Styles>

        <!-- Entrada suave de las secciones -->
        <Style Selector=":is(Control).entrada">
            <Style.Animations>
                <Animation Duration="0:0:0.5"
                           FillMode="Forward"
                           Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="12"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Orbes del banner -->
        <Style Selector="Ellipse.flota">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Style.Animations>
                <Animation Duration="0:0:14"
                           IterationCount="Infinite"
                           PlaybackDirection="Alternate"
                           Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="120"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Botón principal del banner -->
        <Style Selector="Button.heroPrimario">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#22C55E"/>
                    <GradientStop Offset="1" Color="#0E9A46"/>
                </LinearGradientBrush>
            </Setter>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.heroPrimario /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 10 26 -6 #8022C55E"/>
        </Style>

        <Style Selector="Button.heroPrimario:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-2px)"/>
        </Style>

        <Style Selector="Button.heroPrimario:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#2BD268"/>
                    <GradientStop Offset="1" Color="#11A84E"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <!-- Botón secundario del banner (vidrio) -->
        <Style Selector="Button.heroSecundario">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2EFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.heroSecundario:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#26FFFFFF"/>
            <Setter Property="BorderBrush" Value="#4DFFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Tarjetas de indicadores -->
        <Style Selector="Border.kpi">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EAEEF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="22,20"/>
            <Setter Property="BoxShadow" Value="0 1 2 0 #0A0F172A"/>
            <Setter Property="RenderTransform" Value="translateY(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.18"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.kpi:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-3px)"/>
            <Setter Property="BoxShadow" Value="0 14 30 -12 #330F172A"/>
        </Style>

        <Style Selector="Border.iconoKpi">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="CornerRadius" Value="14"/>
        </Style>

        <Style Selector="Border.iconoKpi PathIcon">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>

        <Style Selector="TextBlock.kpiEtiqueta">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.kpiValor">
            <Setter Property="Foreground" Value="#0B1220"/>
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="-0.6"/>
            <Setter Property="Margin" Value="0,14,0,2"/>
        </Style>

        <Style Selector="TextBlock.kpiDetalle">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Tarjetas de sección -->
        <Style Selector="Border.seccion">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EAEEF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BoxShadow" Value="0 1 2 0 #0A0F172A"/>
        </Style>

        <Style Selector="TextBlock.tituloSeccion">
            <Setter Property="Foreground" Value="#0B1220"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBlock.subtituloSeccion">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="LineHeight" Value="17"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Acciones rápidas -->
        <Style Selector="Button.accesoRapido">
            <Setter Property="Height" Value="74"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#EDF1F4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.accesoRapido:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F0FAF4"/>
            <Setter Property="BorderBrush" Value="#BFE6CD"/>
        </Style>

        <Style Selector="Button.accesoRapido PathIcon.flecha">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="RenderTransform" Value="translateX(0px)"/>
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.accesoRapido:pointerover PathIcon.flecha">
            <Setter Property="Foreground" Value="#16A34A"/>
            <Setter Property="RenderTransform" Value="translateX(3px)"/>
        </Style>

        <!-- Botón de actualizar -->
        <Style Selector="Button.actualizar">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#F4F6F8"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.actualizar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EAF7EF"/>
            <Setter Property="Foreground" Value="#0B6B33"/>
        </Style>

        <!-- Filas de detalle del turno -->
        <Style Selector="TextBlock.detalleEtiqueta">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.detalleValor">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

    </UserControl.Styles>


    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28,24,28,28"
                    Spacing="20">


            <!-- ================================================= -->
            <!-- AVISO DE ERROR                                    -->
            <!-- ================================================= -->

            <Border Padding="16,12"
                    CornerRadius="14"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Width="18" Height="18"
                              Foreground="#C61F2B"
                              Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="#9F1239"
                               FontSize="13"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>


            <!-- ================================================= -->
            <!-- BANNER DE BIENVENIDA                              -->
            <!-- ================================================= -->

            <Border Classes="entrada"
                    CornerRadius="24"
                    ClipToBounds="True"
                    Background="#050607"
                    MinHeight="220">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>

                <Panel>

                    <Ellipse Classes="flota"
                             Width="520" Height="520"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-200,-260,0,0">
                        <Ellipse.RenderTransform>
                            <TranslateTransform/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#8816A34A"/>
                                <GradientStop Offset="1" Color="#0016A34A"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="460" Height="460"
                             HorizontalAlignment="Center" VerticalAlignment="Bottom"
                             Margin="200,0,0,-300"
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#66F5C400"/>
                                <GradientStop Offset="1" Color="#00F5C400"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="520" Height="520"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-240,-180,0"
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#88C61F2B"/>
                                <GradientStop Offset="1" Color="#00C61F2B"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="28"
                          Margin="34,30">

                        <!-- SALUDO Y ACCIONES -->
                        <StackPanel Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="0">

                            <Border HorizontalAlignment="Left"
                                    Padding="12,6"
                                    CornerRadius="999"
                                    Background="#14FFFFFF"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="7" Height="7"
                                             Fill="#22C55E"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Foreground="#D9E2EC"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1.2"
                                               VerticalAlignment="Center">
                                        <Run Text="TURNO #"/><Run Text="{Binding IdTurno}"/><Run Text="  ·  "/><Run Text="{Binding EstadoTurno}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{Binding Saludo}"
                                       Foreground="White"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       LetterSpacing="-0.8"
                                       TextWrapping="Wrap"
                                       Margin="0,16,0,0"/>

                            <TextBlock Foreground="#A8B4C2"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0">
                                <Run Text="{Binding Caja}"/><Run Text="  ·  Abierto por "/><Run Text="{Binding UsuarioApertura}" FontWeight="SemiBold" Foreground="White"/>
                            </TextBlock>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="12"
                                        Margin="0,24,0,0">

                                <Button Classes="heroPrimario"
                                        Command="{Binding NuevaVentaCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Width="18" Height="18"
                                                  Foreground="White"
                                                  Data="M7 18c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49A1.003 1.003 0 0 0 20 4H5.21l-.94-2H1zm16 16c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                                        <TextBlock Text="Iniciar nueva venta"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Classes="heroSecundario"
                                        Command="{Binding ConsultarCortesCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <PathIcon Width="16" Height="16"
                                                  Foreground="White"
                                                  Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
                                        <TextBlock Text="Ver cortes"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                            </StackPanel>

                        </StackPanel>

                        <!-- EFECTIVO EN CAJA (vidrio) -->
                        <Border Grid.Column="1"
                                Width="320"
                                VerticalAlignment="Center"
                                Padding="24,22"
                                CornerRadius="20"
                                Background="#12FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1">
                            <StackPanel Spacing="0">
                                <TextBlock Text="EFECTIVO ESPERADO EN CAJA"
                                           Foreground="#A8B4C2"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           LetterSpacing="1.2"
                                           LineHeight="16"/>
                                <TextBlock Text="{Binding EfectivoEsperado, StringFormat='{}{0:C2}'}"
                                           Foreground="White"
                                           FontSize="36"
                                           FontWeight="Bold"
                                           LetterSpacing="-1"
                                           Margin="0,6,0,16"/>
                                <Border Height="1" Background="#1FFFFFFF" Margin="0,0,0,14"/>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                                    <TextBlock Grid.Row="0" Grid.Column="0"
                                               Text="Fondo inicial"
                                               Foreground="#A8B4C2"
                                               FontSize="13"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1"
                                               Text="{Binding FondoInicial, StringFormat='{}{0:C2}'}"
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="Ventas en efectivo"
                                               Foreground="#A8B4C2"
                                               FontSize="13"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding Efectivo, StringFormat='{}{0:C2}'}"
                                               Foreground="#4ADE80"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </Grid>

                </Panel>

            </Border>


            <!-- ================================================= -->
            <!-- INDICADORES                                       -->
            <!-- ================================================= -->

            <Grid ColumnDefinitions="*,*,*,*"
                  ColumnSpacing="16">

                <!-- VENTAS DEL TURNO -->
                <Border Grid.Column="0" Classes="kpi">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="kpiEtiqueta"
                                       Text="Ventas del turno"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Classes="iconoKpi" Background="#EAF7EF">
                                <PathIcon Foreground="#16A34A"
                                          Data="M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z"/>
                            </Border>
                        </Grid>
                        <TextBlock Classes="kpiValor"
                                   Text="{Binding VentasTurno, StringFormat='{}{0:C2}'}"/>
                        <TextBlock Classes="kpiDetalle"
                                   Text="Total vendido durante el turno"/>
                    </StackPanel>
                </Border>

                <!-- TICKETS -->
                <Border Grid.Column="1" Classes="kpi">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="kpiEtiqueta"
                                       Text="Tickets"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Classes="iconoKpi" Background="#FEF7DC">
                                <PathIcon Foreground="#B88A00"
                                          Data="M18 17H6v-2h12v2zm0-4H6v-2h12v2zm0-4H6V7h12v2zM3 22l1.5-1.5L6 22l1.5-1.5L9 22l1.5-1.5L12 22l1.5-1.5L15 22l1.5-1.5L18 22l1.5-1.5L21 22V2l-1.5 1.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2 4.5 3.5 3 2v20z"/>
                            </Border>
                        </Grid>
                        <TextBlock Classes="kpiValor"
                                   Text="{Binding Tickets}"/>
                        <TextBlock Classes="kpiDetalle"
                                   Text="Ventas realizadas"/>
                    </StackPanel>
                </Border>

                <!-- EFECTIVO -->
                <Border Grid.Column="2" Classes="kpi">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="kpiEtiqueta"
                                       Text="Efectivo"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Classes="iconoKpi" Background="#E6F4F2">
                                <PathIcon Foreground="#0F766E"
                                          Data="M19 14V6c0-1.1-.9-2-2-2H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zm-9-1c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm13-6v11c0 1.1-.9 2-2 2H4v-2h17V7h2z"/>
                            </Border>
                        </Grid>
                        <TextBlock Classes="kpiValor"
                                   Text="{Binding Efectivo, StringFormat='{}{0:C2}'}"/>
                        <TextBlock Classes="kpiDetalle"
                                   Text="Pagos recibidos en efectivo"/>
                    </StackPanel>
                </Border>

                <!-- TARJETA -->
                <Border Grid.Column="3" Classes="kpi">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="kpiEtiqueta"
                                       Text="Tarjeta"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Classes="iconoKpi" Background="#FBEEE4">
                                <PathIcon Foreground="#B5651D"
                                          Data="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/>
                            </Border>
                        </Grid>
                        <TextBlock Classes="kpiValor"
                                   Text="{Binding Tarjeta, StringFormat='{}{0:C2}'}"/>
                        <TextBlock Classes="kpiDetalle"
                                   Text="Pagos realizados con tarjeta"/>
                    </StackPanel>
                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- ACTIVIDAD Y PANEL LATERAL                         -->
            <!-- ================================================= -->

            <Grid ColumnDefinitions="1.65*,*"
                  ColumnSpacing="16">


                <!-- ACTIVIDAD DEL TURNO -->
                <Border Grid.Column="0"
                        Classes="seccion"
                        VerticalAlignment="Stretch">

                    <StackPanel Spacing="16">

                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2">
                                <TextBlock Classes="tituloSeccion" Text="Actividad del turno"/>
                                <TextBlock Classes="subtituloSeccion" Text="Últimos movimientos registrados"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Classes="actualizar"
                                    Command="{Binding CargarCommand}"
                                    IsEnabled="{Binding !EstaCargando}"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Width="14" Height="14"
                                              Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                                    <TextBlock Text="Actualizar" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ProgressBar IsIndeterminate="True"
                                     Height="3"
                                     MinHeight="3"
                                     Foreground="#16A34A"
                                     Background="#EAF7EF"
                                     IsVisible="{Binding EstaCargando}"/>

                        <!-- LISTA -->
                        <ItemsControl ItemsSource="{Binding ActividadTurno}"
                                      IsVisible="{Binding TieneActividad}">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border Padding="4,12"
                                            BorderBrush="#F1F4F7"
                                            BorderThickness="0,0,0,1">

                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                              ColumnSpacing="14">

                                            <Border Width="44" Height="44"
                                                    CornerRadius="14"
                                                    Background="#EAF7EF"
                                                    VerticalAlignment="Center">
                                                <PathIcon Width="20" Height="20"
                                                          Foreground="#16A34A"
                                                          Data="M18 17H6v-2h12v2zm0-4H6v-2h12v2zm0-4H6V7h12v2zM3 22l1.5-1.5L6 22l1.5-1.5L9 22l1.5-1.5L12 22l1.5-1.5L15 22l1.5-1.5L18 22l1.5-1.5L21 22V2l-1.5 1.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2 4.5 3.5 3 2v20z"/>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <TextBlock Text="{Binding Titulo}"
                                                           Foreground="#0F172A"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Descripcion}"
                                                           Foreground="#64748B"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Referencia}"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           LetterSpacing="0.6"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Spacing="3">
                                                <TextBlock Text="{Binding Importe, StringFormat='{}{0:C2}'}"
                                                           Foreground="#0F172A"
                                                           FontWeight="Bold"
                                                           FontSize="15"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding Fecha}"
                                                           Foreground="#94A3B8"
                                                           FontSize="11"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <!-- ESTADO VACÍO -->
                        <StackPanel HorizontalAlignment="Center"
                                    Spacing="10"
                                    Margin="0,30"
                                    IsVisible="{Binding NoTieneActividad}">
                            <Border Width="68" Height="68"
                                    CornerRadius="22"
                                    Background="#F4F6F8"
                                    HorizontalAlignment="Center">
                                <PathIcon Width="28" Height="28"
                                          Foreground="#94A3B8"
                                          Data="M18 17H6v-2h12v2zm0-4H6v-2h12v2zm0-4H6V7h12v2zM3 22l1.5-1.5L6 22l1.5-1.5L9 22l1.5-1.5L12 22l1.5-1.5L15 22l1.5-1.5L18 22l1.5-1.5L21 22V2l-1.5 1.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2 4.5 3.5 3 2v20z"/>
                            </Border>
                            <TextBlock Text="Aún no hay movimientos"
                                       Foreground="#334155"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Las ventas y movimientos del turno aparecerán aquí."
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>

                </Border>


                <!-- PANEL LATERAL -->
                <StackPanel Grid.Column="1"
                            Spacing="16">

                    <!-- ACCESOS RÁPIDOS -->
                    <Border Classes="seccion">
                        <StackPanel Spacing="14">

                            <StackPanel Spacing="2">
                                <TextBlock Classes="tituloSeccion" Text="Accesos rápidos"/>
                                <TextBlock Classes="subtituloSeccion" Text="Operaciones frecuentes"/>
                            </StackPanel>

                            <Button Classes="accesoRapido"
                                    Command="{Binding NuevaVentaCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Width="44" Height="44" CornerRadius="14">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                <GradientStop Offset="0" Color="#22C55E"/>
                                                <GradientStop Offset="1" Color="#0B8A3E"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <PathIcon Width="20" Height="20"
                                                  Foreground="White"
                                                  Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Nueva venta"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="Registrar una nueva operación"
                                                   Foreground="#64748B"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <PathIcon Grid.Column="2"
                                              Classes="flecha"
                                              Width="18" Height="18"
                                              Data="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/>
                                </Grid>
                            </Button>

                            <Button Classes="accesoRapido"
                                    Command="{Binding ConsultarCortesCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                    <Border Width="44" Height="44" CornerRadius="14"
                                            Background="#E6F4F2">
                                        <PathIcon Width="20" Height="20"
                                                  Foreground="#0F766E"
                                                  Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="Consultar cortes"
                                                   Foreground="#0F172A"
                                                   FontSize="14"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="Revisar aperturas y cierres"
                                                   Foreground="#64748B"
                                                   FontSize="12"/>
                                    </StackPanel>
                                    <PathIcon Grid.Column="2"
                                              Classes="flecha"
                                              Width="18" Height="18"
                                              Data="M8.59 16.59L10 18l6-6-6-6-1.41 1.41L13.17 12z"/>
                                </Grid>
                            </Button>

                        </StackPanel>
                    </Border>

                    <!-- DETALLE DEL TURNO -->
                    <Border Classes="seccion">
                        <StackPanel Spacing="14">

                            <StackPanel Spacing="2">
                                <TextBlock Classes="tituloSeccion" Text="Detalle del turno"/>
                                <TextBlock Classes="subtituloSeccion" Text="Información de la caja actual"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="Auto,*"
                                  RowDefinitions="Auto,Auto,Auto,Auto"
                                  RowSpacing="12"
                                  ColumnSpacing="16">

                                <TextBlock Grid.Row="0" Classes="detalleEtiqueta" Text="Caja"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Classes="detalleValor" Text="{Binding Caja}"/>

                                <TextBlock Grid.Row="1" Classes="detalleEtiqueta" Text="Abierto por"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Classes="detalleValor" Text="{Binding UsuarioApertura}"/>

                                <TextBlock Grid.Row="2" Classes="detalleEtiqueta" Text="Fondo inicial"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Classes="detalleValor" Text="{Binding FondoInicial, StringFormat='{}{0:C2}'}"/>

                                <TextBlock Grid.Row="3" Classes="detalleEtiqueta" Text="Estado"/>
                                <Border Grid.Row="3" Grid.Column="1"
                                        HorizontalAlignment="Right"
                                        Padding="10,4"
                                        CornerRadius="999"
                                        Background="#EAF7EF">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Width="6" Height="6" Fill="#16A34A" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding EstadoTurno}"
                                                   Foreground="#0B6B33"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>

                            </Grid>

                        </StackPanel>
                    </Border>

                </StackPanel>

            </Grid>

        </StackPanel>

    </ScrollViewer>

</UserControl>
