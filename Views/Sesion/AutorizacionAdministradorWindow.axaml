<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NovaCoreESDM.Models.Cancelaciones"
        x:Class="NovaCoreESDM.Views.Sesion.AutorizacionAdministradorWindow"
        Title="Autorización de administrador"
        Icon="/Assets/Brand/esdm-app-icon.ico"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#F4F6F8">


    <StackPanel>


        <!-- ===================================================== -->
        <!-- ENCABEZADO                                            -->
        <!-- ===================================================== -->

        <Border Padding="28,24,28,20"
                BorderBrush="#E2E8F0"
                BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#F1F5F9"/>
                    <GradientStop Offset="1" Color="#E6ECF2"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="16">

                <Border Width="56" Height="56"
                        CornerRadius="17"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Offset="0" Color="#475569"/>
                            <GradientStop Offset="1" Color="#0F172A"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <PathIcon Width="26" Height="26"
                              Foreground="White"
                              Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="3">
                    <TextBlock Text="AUTORIZACIÓN REQUERIDA"
                               Foreground="#475569"
                               FontSize="11"
                               FontWeight="Bold"
                               LetterSpacing="1.6"
                               LineHeight="16"/>
                    <TextBlock x:Name="TituloTextBlock"
                               Text="Autorización de administrador"
                               Foreground="#0B1220"
                               FontSize="21"
                               FontWeight="Bold"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="DescripcionTextBlock"
                               Text="Selecciona un administrador e ingresa su contraseña para continuar."
                               Foreground="#64748B"
                               FontSize="13"
                               TextWrapping="Wrap"/>
                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- CREDENCIALES                                          -->
        <!-- ===================================================== -->

        <StackPanel Margin="28,22,28,18"
                    Spacing="8">

            <TextBlock Text="Administrador"
                       Classes="etiqueta"/>

            <ComboBox x:Name="AdministradorComboBox"
                      Classes="campo"
                      PlaceholderText="Selecciona un administrador">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:AdministradorItem">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border Width="28" Height="28"
                                    CornerRadius="14"
                                    Background="#EEF2F6">
                                <PathIcon Width="14" Height="14"
                                          Foreground="#475569"
                                          Data="M12 12c2.7 0 4.9-2.2 4.9-4.9S14.7 2.2 12 2.2 7.1 4.4 7.1 7.1 9.3 12 12 12zm0 2.4c-3.3 0-9.8 1.6-9.8 4.9v2.5h19.6v-2.5c0-3.3-6.5-4.9-9.8-4.9z"/>
                            </Border>
                            <TextBlock Text="{Binding Nombre}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Contraseña"
                       Classes="etiqueta"
                       Margin="0,10,0,0"/>

            <TextBox x:Name="PasswordTextBox"
                     Classes="campo revealPasswordButton"
                     PasswordChar="●"
                     PlaceholderText="Contraseña del administrador">
                <TextBox.InnerLeftContent>
                    <PathIcon Width="16" Height="16"
                              Margin="14,0,4,0"
                              Foreground="#94A3B8"
                              Data="M18 8h-1V6c0-2.8-2.2-5-5-5S7 3.2 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.7 1.4-3.1 3.1-3.1s3.1 1.4 3.1 3.1v2z"/>
                </TextBox.InnerLeftContent>
            </TextBox>

            <!-- Mensaje de error (lo muestra / oculta el código) -->
            <Border Margin="0,8,0,0"
                    Padding="12,9"
                    CornerRadius="12"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    IsVisible="{Binding #MensajeTextBlock.IsVisible}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PathIcon Width="16" Height="16"
                              Foreground="#C61F2B"
                              Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                    <TextBlock x:Name="MensajeTextBlock"
                               Foreground="#9F1239"
                               FontSize="13"
                               TextWrapping="Wrap"
                               MaxWidth="420"
                               VerticalAlignment="Center"
                               IsVisible="False"/>
                </StackPanel>
            </Border>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- BOTONES                                               -->
        <!-- ===================================================== -->

        <Border Background="White"
                BorderBrush="#EAEEF2"
                BorderThickness="0,1,0,0"
                Padding="28,14,28,20">

            <StackPanel Spacing="12">

                <StackPanel Orientation="Horizontal"
                            Spacing="18"
                            HorizontalAlignment="Center">
                    <StackPanel Classes="atajo">
                        <Border Classes="tecla"><TextBlock Text="Enter"/></Border>
                        <TextBlock Text="Validar"/>
                    </StackPanel>
                    <StackPanel Classes="atajo">
                        <Border Classes="tecla"><TextBlock Text="Esc"/></Border>
                        <TextBlock Text="Cancelar"/>
                    </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="*,2*"
                      ColumnSpacing="12">

                    <Button x:Name="CancelarButton"
                            Grid.Column="0"
                            Classes="cancelar"
                            IsCancel="True"
                            Click="Cancelar_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Width="14" Height="14"
                                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                            <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="AutorizarButton"
                            Grid.Column="1"
                            Classes="autorizar"
                            IsDefault="True"
                            Click="Autorizar_Click">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <PathIcon x:Name="IconoAutorizar"
                                      Width="16" Height="16"
                                      Data="M12.65 10C11.83 7.67 9.61 6 7 6c-3.31 0-6 2.69-6 6s2.69 6 6 6c2.61 0 4.83-1.67 5.65-4H17v4h4v-4h2v-4H12.65zM7 14c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2z"/>
                            <ProgressBar x:Name="ProgresoAutorizar"
                                         IsIndeterminate="True"
                                         Width="28"
                                         MinWidth="28"
                                         Height="4"
                                         Foreground="White"
                                         Background="#40FFFFFF"
                                         VerticalAlignment="Center"
                                         IsVisible="False"/>
                            <TextBlock x:Name="TextoAutorizar"
                                       Text="Validar y continuar"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </Grid>

            </StackPanel>

        </Border>

    </StackPanel>


    <!-- ========================================================= -->
    <!-- ESTILOS                                                   -->
    <!-- ========================================================= -->

    <Window.Styles>

        <Style Selector="TextBlock.etiqueta">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="ComboBox.campo, TextBox.campo">
            <Setter Property="Height" Value="50"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="ComboBox.campo">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.campo">
            <Setter Property="Padding" Value="4,0,12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.campo:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#16A34A"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="BoxShadow" Value="0 0 0 4 #1F16A34A"/>
        </Style>

        <!-- Atajos -->
        <Style Selector="StackPanel.atajo">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="6"/>
        </Style>

        <Style Selector="StackPanel.atajo > TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.tecla">
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#D5DCE4"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.tecla TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Botones -->
        <Style Selector="Button.cancelar">
            <Setter Property="Height" Value="56"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.cancelar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style Selector="Button.autorizar">
            <Setter Property="Height" Value="56"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#22C55E"/>
                    <GradientStop Offset="1" Color="#0E9A46"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.autorizar /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 10 24 -8 #8022C55E"/>
        </Style>

        <Style Selector="Button.autorizar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#2BD268"/>
                    <GradientStop Offset="1" Color="#11A84E"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.autorizar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0B7A37"/>
        </Style>

        <Style Selector="Button.autorizar:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#7FCF9C"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BoxShadow" Value="none"/>
        </Style>

    </Window.Styles>

</Window>
