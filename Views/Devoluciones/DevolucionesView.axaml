<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NovaCoreESDM.ViewModels.Devoluciones"

    x:Class="NovaCoreESDM.Views.Devoluciones.DevolucionesView"
    x:DataType="vm:DevolucionesViewModel"
    x:Name="Root"

    Background="#F4F6F8">


    <UserControl.Styles>

        <Style Selector="Border.seccion">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EAEEF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BoxShadow" Value="0 1 2 0 #0A0F172A"/>
        </Style>

        <Style Selector="TextBlock.tituloSeccion">
            <Setter Property="Foreground" Value="#0B1220"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBlock.subtituloSeccion">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="TextBlock.etiquetaCampo">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBox.campo, ComboBox.campo">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="TextBox.campo">
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="ComboBox.campo">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.campo:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#16A34A"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="Button.boton">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.verde">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#16A34A"/>
        </Style>
        <Style Selector="Button.verde:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#15803D"/>
        </Style>
        <Style Selector="Button.verde:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#A7D7B8"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.gris">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <Style Selector="Button.paso">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D5DCE4"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.chico">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Background" Value="#F0FBF4"/>
            <Setter Property="Foreground" Value="#15803D"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Border.linea">
            <Setter Property="Background" Value="#FBFCFD"/>
            <Setter Property="BorderBrush" Value="#E6EAEE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>

        <Style Selector="Border.linea.seleccionada">
            <Setter Property="Background" Value="#F0FBF4"/>
            <Setter Property="BorderBrush" Value="#86EFAC"/>
        </Style>

        <Style Selector="Border.dato">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Background" Value="#F1F5F9"/>
        </Style>

        <Style Selector="Border.dato TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

    </UserControl.Styles>


    <Grid ColumnDefinitions="*,380"
          ColumnSpacing="20"
          Margin="24">


        <!-- ===================================================== -->
        <!-- IZQUIERDA: TICKET Y PRODUCTOS                         -->
        <!-- ===================================================== -->

        <Grid RowDefinitions="Auto,*"
              RowSpacing="20">

            <!-- BUSCAR -->
            <Border Classes="seccion">
                <StackPanel Spacing="14">

                    <StackPanel Spacing="2">
                        <TextBlock Classes="tituloSeccion" Text="Buscar ticket"/>
                        <TextBlock Classes="subtituloSeccion"
                                   Text="Escribe el folio que viene impreso en el ticket (abajo, en «Ticket:»). Solo se devuelven ventas pagadas en efectivo."/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto,Auto"
                          ColumnSpacing="10">

                        <TextBox x:Name="CajaBusqueda"
                                 Classes="campo"
                                 Watermark="Folio del ticket, por ejemplo BOD-011-C121-00000021"
                                 Text="{Binding TextoBusqueda, Mode=TwoWay}"
                                 KeyDown="Busqueda_KeyDown"/>

                        <Button Grid.Column="1"
                                Classes="boton verde"
                                Content="Buscar"
                                Command="{Binding BuscarCommand}"/>

                        <Button Grid.Column="2"
                                Classes="boton gris"
                                Content="Nueva"
                                IsVisible="{Binding HayVenta}"
                                Command="{Binding NuevaBusquedaCommand}"/>
                    </Grid>

                    <Border IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Padding="14,10"
                            CornerRadius="12"
                            Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1">
                        <TextBlock Text="{Binding MensajeError}"
                                   Foreground="#B91C1C"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border IsVisible="{Binding MensajeExito, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Padding="14,10"
                            CornerRadius="12"
                            Background="#F0FBF4"
                            BorderBrush="#86EFAC"
                            BorderThickness="1">
                        <TextBlock Text="{Binding MensajeExito}"
                                   Foreground="#15803D"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </Border>


            <!-- PRODUCTOS -->
            <Border Grid.Row="1"
                    Classes="seccion"
                    IsVisible="{Binding HayVenta}">

                <Grid RowDefinitions="Auto,Auto,*"
                      RowSpacing="12">

                    <StackPanel Spacing="2">
                        <TextBlock Classes="tituloSeccion" Text="{Binding TextoVenta}"/>
                        <TextBlock Classes="subtituloSeccion" Text="{Binding TextoFechaVenta}"/>
                        <TextBlock Classes="subtituloSeccion" Text="{Binding TextoPagos}"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            IsVisible="{Binding HayBloqueo}"
                            Padding="14,10"
                            CornerRadius="12"
                            Background="#FFF7E0"
                            BorderBrush="#FBD98A"
                            BorderThickness="1">
                        <TextBlock Text="{Binding MotivoBloqueo}"
                                   Foreground="#7A4E05"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="1"
                            IsVisible="{Binding HayAdvertencia}"
                            Padding="14,10"
                            CornerRadius="12"
                            Background="#EFF6FF"
                            BorderBrush="#BFDBFE"
                            BorderThickness="1">
                        <TextBlock Text="{Binding Advertencia}"
                                   Foreground="#1E40AF"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl ItemsSource="{Binding Lineas}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:LineaDevolucionItem">
                                    <Border Classes="linea"
                                            Classes.seleccionada="{Binding Seleccionado}">
                                        <Grid ColumnDefinitions="*,Auto,Auto"
                                              ColumnSpacing="14">

                                            <StackPanel Spacing="4"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Producto}"
                                                           Foreground="#0B1220"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Presentacion}"
                                                           Foreground="#15803D"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                                <WrapPanel Orientation="Horizontal">
                                                    <Border Classes="dato" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding TextoPrecio}"/>
                                                    </Border>
                                                    <Border Classes="dato" Margin="0,0,6,4">
                                                        <TextBlock Text="{Binding TextoVendida}"/>
                                                    </Border>
                                                    <Border Classes="dato" Margin="0,0,6,4"
                                                            IsVisible="{Binding TieneDevueltas}"
                                                            Background="#FEF3C7">
                                                        <TextBlock Text="{Binding TextoDevuelta}"/>
                                                    </Border>
                                                    <Border Classes="dato" Margin="0,0,6,4"
                                                            Background="#EAF7EF">
                                                        <TextBlock Text="{Binding TextoDisponible}"
                                                                   Foreground="#0B6B33"/>
                                                    </Border>
                                                </WrapPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        VerticalAlignment="Center"
                                                        IsEnabled="{Binding PuedeDevolverse}">
                                                <Button Classes="paso"
                                                        Content="−"
                                                        Command="{Binding MenosCommand}"/>
                                                <TextBlock Text="{Binding TextoCantidad}"
                                                           MinWidth="36"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                                <Button Classes="paso"
                                                        Content="+"
                                                        Command="{Binding MasCommand}"/>
                                                <Button Classes="chico"
                                                        Content="Todo"
                                                        Command="{Binding TodoCommand}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding TextoImporte}"
                                                       MinWidth="90"
                                                       TextAlignment="Right"
                                                       FontSize="17"
                                                       FontWeight="Bold"
                                                       Foreground="#0B1220"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </ScrollViewer>

                </Grid>
            </Border>

        </Grid>


        <!-- ===================================================== -->
        <!-- DERECHA: MOTIVO, TOTAL Y CONFIRMAR                    -->
        <!-- ===================================================== -->

        <Border Grid.Column="1"
                Classes="seccion"
                VerticalAlignment="Top">

            <StackPanel Spacing="16">

                <StackPanel Spacing="2">
                    <TextBlock Classes="tituloSeccion" Text="Devolución"/>
                    <TextBlock Classes="subtituloSeccion"
                               Text="Necesita la autorización de un administrador. La mercancía regresa al inventario y el efectivo sale del turno de esta caja."/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Classes="etiquetaCampo" Text="Motivo"/>
                    <ComboBox Classes="campo"
                              ItemsSource="{Binding Motivos}"
                              SelectedItem="{Binding MotivoSeleccionado, Mode=TwoWay}"
                              IsEnabled="{Binding PuedeDevolver}"
                              PlaceholderText="Busca primero el ticket"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Classes="etiquetaCampo" Text="Observaciones"/>
                    <TextBox Classes="campo"
                             Height="80"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             Padding="14,10"
                             Watermark="Opcional (obligatorio si el motivo es «Otro»)"
                             Text="{Binding Observaciones, Mode=TwoWay}"
                             IsEnabled="{Binding PuedeDevolver}"/>
                </StackPanel>

                <Border Background="#F0FBF4"
                        CornerRadius="16"
                        Padding="18,14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="EFECTIVO A DEVOLVER"
                                   Foreground="#15803D"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   LetterSpacing="1.4"/>
                        <TextBlock Text="{Binding TextoTotal}"
                                   Foreground="#0B1220"
                                   FontSize="34"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Button Classes="boton verde"
                        HorizontalAlignment="Stretch"
                        Height="54"
                        Command="{Binding DevolverCommand}"
                        IsEnabled="{Binding PuedeRegistrar}">
                    <TextBlock Text="{Binding TextoBotonDevolver}"/>
                </Button>

                <ProgressBar IsIndeterminate="True"
                             IsVisible="{Binding EstaCargando}"
                             Height="4"/>

            </StackPanel>
        </Border>

    </Grid>

</UserControl>
