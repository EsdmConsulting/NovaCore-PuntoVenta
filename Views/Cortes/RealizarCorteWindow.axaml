<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    x:Class="NovaCoreESDM.Views.Cortes.RealizarCorteWindow"

    Width="700"
    Height="680"

    MinWidth="560"
    MinHeight="540"

    WindowStartupLocation="CenterOwner"

    CanResize="True"

    Title="Realizar corte"

    Background="#F5F7FA">


    <!-- ========================================================= -->
    <!-- ESTRUCTURA PRINCIPAL                                      -->
    <!--                                                           -->
    <!-- Auto = encabezado                                         -->
    <!-- *    = contenido adaptable / scroll                       -->
    <!-- Auto = footer siempre visible                             -->
    <!-- ========================================================= -->

    <Grid RowDefinitions="Auto,*,Auto">


        <!-- ===================================================== -->
        <!-- HEADER                                                -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="0"

            Background="#17365D"

            Padding="24,18">

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="16">


                <!-- INFORMACIÓN -->

                <StackPanel
                    Grid.Column="0"
                    Spacing="4"
                    VerticalAlignment="Center">

                    <TextBlock
                        Text="Realizar corte"
                        Foreground="White"
                        FontSize="22"
                        FontWeight="Bold"
                        TextWrapping="Wrap"/>


                    <TextBlock
                        x:Name="TxtInformacionTurno"

                        Text="Cierre de caja"

                        Foreground="#DCE7F5"

                        FontSize="12"

                        TextWrapping="Wrap"/>

                </StackPanel>


                <!-- ETIQUETA -->

                <Border
                    Grid.Column="1"

                    Background="#294B73"

                    CornerRadius="8"

                    Padding="11,6"

                    VerticalAlignment="Center">

                    <TextBlock
                        Text="CIERRE DE TURNO"

                        Foreground="White"

                        FontWeight="SemiBold"

                        FontSize="10"/>

                </Border>

            </Grid>

        </Border>



        <!-- ===================================================== -->
        <!-- CONTENIDO                                             -->
        <!-- ===================================================== -->

        <ScrollViewer
            Grid.Row="1"

            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Margin="22,18"
                Spacing="14">


                <!-- ================================================= -->
                <!-- COMPOSICIÓN DEL EFECTIVO                          -->
                <!-- ================================================= -->

                <Border
                    Background="White"

                    BorderBrush="#E2E8F0"
                    BorderThickness="1"

                    CornerRadius="12"

                    Padding="18">

                    <StackPanel Spacing="11">


                        <TextBlock
                            Text="Composición del efectivo"

                            FontSize="15"

                            FontWeight="SemiBold"

                            Foreground="#17365D"/>


                        <!-- FONDO -->

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock
                                Text="Fondo inicial"

                                Foreground="#64748B"

                                FontSize="12"/>

                            <TextBlock
                                Grid.Column="1"

                                x:Name="TxtFondoInicial"

                                Text="$0.00"

                                FontSize="12"

                                FontWeight="SemiBold"

                                Foreground="#1E293B"/>

                        </Grid>


                        <!-- VENTAS -->

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock
                                Text="Ventas en efectivo"

                                Foreground="#64748B"

                                FontSize="12"/>

                            <TextBlock
                                Grid.Column="1"

                                x:Name="TxtVentasEfectivo"

                                Text="$0.00"

                                FontSize="12"

                                FontWeight="SemiBold"

                                Foreground="#1E293B"/>

                        </Grid>


                        <!-- ABONOS -->

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock
                                Text="Abonos de crédito en efectivo"

                                Foreground="#64748B"

                                FontSize="12"

                                TextWrapping="Wrap"/>

                            <TextBlock
                                Grid.Column="1"

                                x:Name="TxtAbonosCreditoEfectivo"

                                Text="$0.00"

                                FontSize="12"

                                FontWeight="SemiBold"

                                Foreground="#1E293B"

                                Margin="12,0,0,0"/>

                        </Grid>


                        <!-- OTROS INGRESOS -->

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock
                                Text="Otros ingresos"

                                Foreground="#64748B"

                                FontSize="12"/>

                            <TextBlock
                                Grid.Column="1"

                                x:Name="TxtOtrosIngresos"

                                Text="$0.00"

                                FontSize="12"

                                FontWeight="SemiBold"

                                Foreground="#1E293B"/>

                        </Grid>


                        <Separator
                            Background="#E2E8F0"
                            Margin="0,2"/>


                        <!-- RETIROS -->

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock
                                Text="Retiros"

                                Foreground="#64748B"

                                FontSize="12"/>

                            <TextBlock
                                Grid.Column="1"

                                x:Name="TxtRetiros"

                                Text="-$0.00"

                                FontSize="12"

                                FontWeight="SemiBold"

                                Foreground="#C61F2B"/>

                        </Grid>


                        <!-- EGRESOS -->

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock
                                Text="Egresos"

                                Foreground="#64748B"

                                FontSize="12"/>

                            <TextBlock
                                Grid.Column="1"

                                x:Name="TxtEgresos"

                                Text="-$0.00"

                                FontSize="12"

                                FontWeight="SemiBold"

                                Foreground="#C61F2B"/>

                        </Grid>


                        <!-- DEVOLUCIONES -->

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock
                                Text="Devoluciones"

                                Foreground="#64748B"

                                FontSize="12"/>

                            <TextBlock
                                Grid.Column="1"

                                x:Name="TxtDevoluciones"

                                Text="-$0.00"

                                FontSize="12"

                                FontWeight="SemiBold"

                                Foreground="#C61F2B"/>

                        </Grid>

                    </StackPanel>

                </Border>



                <!-- ================================================= -->
                <!-- EFECTIVO ESPERADO                                 -->
                <!-- ================================================= -->

                <Border
                    Background="#EDF7F0"

                    BorderBrush="#B7DFC1"
                    BorderThickness="1"

                    CornerRadius="12"

                    Padding="16">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">


                        <StackPanel
                            Grid.Column="0"
                            Spacing="2"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="EFECTIVO ESPERADO"

                                FontSize="10"

                                FontWeight="Bold"

                                Foreground="#15803D"/>


                            <TextBlock
                                Text="Según los movimientos registrados"

                                FontSize="10"

                                Foreground="#64748B"

                                TextWrapping="Wrap"/>

                        </StackPanel>


                        <TextBlock
                            Grid.Column="1"

                            x:Name="TxtEfectivoEsperado"

                            Text="$0.00"

                            FontSize="23"

                            FontWeight="Bold"

                            Foreground="#15803D"

                            VerticalAlignment="Center"/>

                    </Grid>

                </Border>



                <!-- ================================================= -->
                <!-- EFECTIVO CONTADO                                  -->
                <!-- ================================================= -->

                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Efectivo contado físicamente"

                        FontSize="12"

                        FontWeight="SemiBold"

                        Foreground="#334155"/>


                    <TextBlock
                        Text="Ingresa cuánto dinero hay realmente en caja."

                        FontSize="10"

                        Foreground="#64748B"

                        TextWrapping="Wrap"/>


                    <TextBox
                        x:Name="TxtEfectivoContado"

                        Height="48"

                        FontSize="19"

                        FontWeight="SemiBold"

                        Watermark="0.00"

                        HorizontalContentAlignment="Right"

                        VerticalContentAlignment="Center"

                        Padding="12,0"

                        TextChanged="EfectivoContado_TextChanged"/>

                </StackPanel>



                <!-- ================================================= -->
                <!-- DIFERENCIA                                        -->
                <!-- ================================================= -->

                <Border
                    x:Name="BorderDiferencia"

                    Background="#F8FAFC"

                    BorderBrush="#CBD5E1"
                    BorderThickness="1"

                    CornerRadius="12"

                    Padding="15">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="12">


                        <StackPanel Spacing="3">

                            <TextBlock
                                Text="Diferencia"

                                FontSize="11"

                                Foreground="#64748B"/>

                            <TextBlock
                                x:Name="TxtEstadoDiferencia"

                                Text="PENDIENTE"

                                FontSize="12"

                                FontWeight="Bold"

                                Foreground="#64748B"/>

                        </StackPanel>


                        <TextBlock
                            Grid.Column="1"

                            x:Name="TxtDiferencia"

                            Text="$0.00"

                            FontSize="21"

                            FontWeight="Bold"

                            Foreground="#334155"

                            VerticalAlignment="Center"/>

                    </Grid>

                </Border>



                <!-- ================================================= -->
                <!-- OBSERVACIONES                                     -->
                <!-- ================================================= -->

                <StackPanel Spacing="6">

                    <TextBlock
                        Text="Observaciones"

                        FontSize="12"

                        FontWeight="SemiBold"

                        Foreground="#334155"/>

                    <TextBox
                        x:Name="TxtObservaciones"

                        MinHeight="64"
                        MaxHeight="90"

                        AcceptsReturn="True"

                        TextWrapping="Wrap"

                        Padding="10"

                        Watermark="Opcional..."/>

                </StackPanel>



                <!-- ================================================= -->
                <!-- MENSAJE                                           -->
                <!-- ================================================= -->

                <TextBlock
                    x:Name="TxtMensaje"

                    Text=""

                    IsVisible="False"

                    TextWrapping="Wrap"

                    Foreground="#C61F2B"

                    FontSize="11"/>

            </StackPanel>

        </ScrollViewer>



        <!-- ===================================================== -->
        <!-- FOOTER                                                -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="2"

            Background="White"

            BorderBrush="#E2E8F0"
            BorderThickness="0,1,0,0"

            Padding="18">

            <!--
                Nota arriba y botones abajo.
                Mucho más seguro si la ventana se hace angosta.
            -->

            <Grid
                RowDefinitions="Auto,Auto"
                RowSpacing="10">


                <!-- NOTA -->

                <TextBlock
                    Grid.Row="0"

                    Text="El cierre finalizará el turno actual."

                    Foreground="#64748B"

                    FontSize="10"

                    TextWrapping="Wrap"/>


                <!-- BOTONES -->

                <Grid
                    Grid.Row="1"

                    ColumnDefinitions="*,*"

                    ColumnSpacing="10">


                    <!-- CANCELAR -->

                    <Button
                        Grid.Column="0"

                        x:Name="BtnCancelar"

                        Content="Cancelar"

                        Height="48"

                        Click="Cancelar_Click"

                        Background="White"

                        Foreground="#475569"

                        BorderBrush="#CBD5E1"
                        BorderThickness="1"

                        CornerRadius="10"

                        FontSize="12"

                        FontWeight="SemiBold"

                        HorizontalAlignment="Stretch"

                        HorizontalContentAlignment="Center"

                        VerticalContentAlignment="Center"/>


                    <!-- CONFIRMAR -->

                    <Button
                        Grid.Column="1"

                        x:Name="BtnConfirmar"

                        Content="Confirmar corte"

                        Height="48"

                        Background="#16A34A"

                        Foreground="White"

                        BorderThickness="0"

                        CornerRadius="10"

                        FontSize="12"

                        FontWeight="Bold"

                        IsEnabled="False"

                        Click="Confirmar_Click"

                        HorizontalAlignment="Stretch"

                        HorizontalContentAlignment="Center"

                        VerticalContentAlignment="Center"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>