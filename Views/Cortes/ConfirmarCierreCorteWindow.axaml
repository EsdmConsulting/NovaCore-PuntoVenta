<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    x:Class="NovaCoreESDM.Views.Cortes.ConfirmarCierreCorteWindow"

    Width="560"
    SizeToContent="Height"

    CanResize="False"

    WindowStartupLocation="CenterOwner"

    Title="Confirmar cierre"
    Icon="/Assets/Brand/esdm-app-icon.ico"

    Background="#F4F6F8">


    <StackPanel>


        <!-- ===================================================== -->
        <!-- PREGUNTA Y RESUMEN                                    -->
        <!-- ===================================================== -->

        <Border Padding="30,28,30,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#FDECEC"/>
                    <GradientStop Offset="0.55" Color="#F4F6F8"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel Spacing="14">

                <!-- Ícono con pulso -->
                <Panel Width="84" Height="84"
                       HorizontalAlignment="Center">
                    <Ellipse Classes="pulso"
                             Fill="#33E11D48"
                             RenderTransformOrigin="50%,50%">
                        <Ellipse.RenderTransform>
                            <ScaleTransform/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Border Width="62" Height="62"
                            CornerRadius="31">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#EF4444"/>
                                <GradientStop Offset="1" Color="#B91C1C"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <PathIcon Width="28" Height="28"
                                  Foreground="White"
                                  Data="M18 8h-1V6c0-2.8-2.2-5-5-5S7 3.2 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.7 1.4-3.1 3.1-3.1s3.1 1.4 3.1 3.1v2z"/>
                    </Border>
                </Panel>

                <StackPanel Spacing="4"
                            HorizontalAlignment="Center">
                    <TextBlock Text="¿Cerrar el turno?"
                               Foreground="#0B1220"
                               FontSize="25"
                               FontWeight="Bold"
                               LetterSpacing="-0.4"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Revisa los importes antes de finalizar el corte"
                               Foreground="#64748B"
                               FontSize="13"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Resumen -->
                <Border Padding="20,16"
                        CornerRadius="18"
                        Background="White"
                        BorderBrush="#EAEEF2"
                        BorderThickness="1"
                        Margin="0,4,0,0">

                    <StackPanel Spacing="12">

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">

                            <Border Grid.Column="0" Classes="cifra">
                                <StackPanel>
                                    <TextBlock Classes="etiqueta" Text="Efectivo esperado"/>
                                    <TextBlock x:Name="TxtEsperado" Classes="valor"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Classes="cifra">
                                <StackPanel>
                                    <TextBlock Classes="etiqueta" Text="Efectivo contado"/>
                                    <TextBlock x:Name="TxtContado" Classes="valor"/>
                                </StackPanel>
                            </Border>

                        </Grid>

                        <!-- Los colores de la diferencia los pone el código -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="DIFERENCIA"
                                           Foreground="#94A3B8"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           LetterSpacing="1.2"/>
                                <TextBlock x:Name="TxtEstado"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           LetterSpacing="0.8"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       x:Name="TxtDiferencia"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       LetterSpacing="-0.8"
                                       VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>

                </Border>

                <!-- Advertencia -->
                <Border Padding="14,12"
                        CornerRadius="14"
                        Background="#FFF7E0"
                        BorderBrush="#FBD98A"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="10">
                        <PathIcon Width="18" Height="18"
                                  Foreground="#B7791F"
                                  VerticalAlignment="Top"
                                  Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                        <TextBlock Grid.Column="1"
                                   Text="Al confirmar, el turno se cerrará y el corte quedará registrado. Esta operación no debe repetirse."
                                   Foreground="#7A4E05"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

            </StackPanel>

        </Border>


        <!-- ===================================================== -->
        <!-- RESPUESTA                                             -->
        <!-- ===================================================== -->

        <Border Background="White"
                BorderBrush="#EAEEF2"
                BorderThickness="0,1,0,0"
                Padding="30,14,30,20">

            <StackPanel Spacing="12">

                <StackPanel Orientation="Horizontal"
                            Spacing="18"
                            HorizontalAlignment="Center">
                    <StackPanel Classes="atajo">
                        <Border Classes="tecla teclaSi"><TextBlock Text="S"/></Border>
                        <TextBlock Text="Sí, cerrar turno"/>
                    </StackPanel>
                    <StackPanel Classes="atajo">
                        <Border Classes="tecla"><TextBlock Text="Esc"/></Border>
                        <TextBlock Text="Volver"/>
                    </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <Button x:Name="BotonVolver"
                            Grid.Column="0"
                            Classes="volver"
                            IsCancel="True"
                            Click="Volver_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Width="14" Height="14"
                                      Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                            <TextBlock Text="Volver" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Classes="cerrar"
                            Click="Confirmar_Click">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <PathIcon Width="16" Height="16"
                                      Data="M18 8h-1V6c0-2.8-2.2-5-5-5S7 3.2 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.7 1.4-3.1 3.1-3.1s3.1 1.4 3.1 3.1v2z"/>
                            <TextBlock Text="Sí, cerrar turno" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </Grid>

            </StackPanel>

        </Border>

    </StackPanel>


    <!-- ========================================================= -->
    <!-- ESTILOS                                                   -->
    <!-- ========================================================= -->

    <Window.Styles>

        <Style Selector="Ellipse.pulso">
            <Style.Animations>
                <Animation Duration="0:0:1.8"
                           IterationCount="Infinite"
                           Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.75"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.75"/>
                        <Setter Property="Opacity" Value="0.9"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.2"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.2"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.cifra">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#EEF1F4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="TextBlock.etiqueta">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style Selector="TextBlock.valor">
            <Setter Property="Foreground" Value="#0B1220"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Atajos -->
        <Style Selector="StackPanel.atajo">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="6"/>
        </Style>

        <Style Selector="StackPanel.atajo > TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.tecla">
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#D5DCE4"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.tecla TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.tecla.teclaSi">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#F5C2C2"/>
        </Style>

        <Style Selector="Border.tecla.teclaSi TextBlock">
            <Setter Property="Foreground" Value="#B91C1C"/>
        </Style>

        <!-- Botones -->
        <Style Selector="Button.volver">
            <Setter Property="Height" Value="58"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.volver:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style Selector="Button.cerrar">
            <Setter Property="Height" Value="58"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#EF4444"/>
                    <GradientStop Offset="1" Color="#B91C1C"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.cerrar /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 10 24 -8 #80DC2626"/>
        </Style>

        <Style Selector="Button.cerrar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#F25555"/>
                    <GradientStop Offset="1" Color="#C82424"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.cerrar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#991B1B"/>
        </Style>

    </Window.Styles>

</Window>
