<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    x:Class="NovaCoreESDM.Views.Cortes.CorteRealizadoWindow"

    Width="560"
    Height="540"

    MinWidth="460"
    MinHeight="430"

    CanResize="True"

    WindowStartupLocation="CenterOwner"

    Title="Corte realizado"

    Background="#F7F9F8">


    <!-- ========================================================= -->
    <!-- ESTRUCTURA PRINCIPAL                                      -->
    <!--                                                           -->
    <!-- *    = contenido flexible                                 -->
    <!-- Auto = acciones siempre visibles                          -->
    <!-- ========================================================= -->

    <Grid RowDefinitions="*,Auto">


        <!-- ===================================================== -->
        <!-- CONTENIDO                                             -->
        <!-- ===================================================== -->

        <ScrollViewer
            Grid.Row="0"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel
                Margin="28"
                Spacing="16">


                <!-- ================================================= -->
                <!-- ICONO                                             -->
                <!-- ================================================= -->

                <Border
                    Width="68"
                    Height="68"

                    CornerRadius="22"

                    Background="#EAF7EF"

                    HorizontalAlignment="Center">

                    <TextBlock
                        Text="✓"

                        Foreground="#08783D"

                        FontSize="31"

                        FontWeight="Bold"

                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                </Border>


                <!-- ================================================= -->
                <!-- TÍTULO                                            -->
                <!-- ================================================= -->

                <StackPanel
                    Spacing="4"
                    HorizontalAlignment="Center">

                    <TextBlock
                        Text="Corte realizado correctamente"

                        Foreground="#21382A"

                        FontSize="21"

                        FontWeight="SemiBold"

                        HorizontalAlignment="Center"

                        TextAlignment="Center"

                        TextWrapping="Wrap"/>


                    <TextBlock
                        x:Name="TxtCorte"

                        Text="Corte registrado"

                        Foreground="#718078"

                        FontSize="11"

                        HorizontalAlignment="Center"

                        TextAlignment="Center"

                        TextWrapping="Wrap"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- RESUMEN                                           -->
                <!-- ================================================= -->

                <Border
                    Background="White"

                    BorderBrush="#E2E8E4"
                    BorderThickness="1"

                    CornerRadius="13"

                    Padding="17">

                    <StackPanel Spacing="11">


                        <!-- EFECTIVO ESPERADO -->

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <TextBlock
                                Text="Efectivo esperado"

                                Foreground="#718078"

                                FontSize="12"

                                VerticalAlignment="Center"/>


                            <TextBlock
                                Grid.Column="1"

                                x:Name="TxtEsperado"

                                Text="$0.00"

                                Foreground="#21382A"

                                FontSize="13"

                                FontWeight="SemiBold"

                                VerticalAlignment="Center"/>

                        </Grid>


                        <!-- EFECTIVO CONTADO -->

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <TextBlock
                                Text="Efectivo contado"

                                Foreground="#718078"

                                FontSize="12"

                                VerticalAlignment="Center"/>


                            <TextBlock
                                Grid.Column="1"

                                x:Name="TxtDeclarado"

                                Text="$0.00"

                                Foreground="#21382A"

                                FontSize="13"

                                FontWeight="SemiBold"

                                VerticalAlignment="Center"/>

                        </Grid>


                        <!-- DIVISOR -->

                        <Border
                            Height="1"
                            Background="#E6EBE8"
                            Margin="0,2"/>


                        <!-- DIFERENCIA -->

                        <Grid
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">

                            <TextBlock
                                Text="Diferencia"

                                Foreground="#718078"

                                FontSize="12"

                                FontWeight="SemiBold"

                                VerticalAlignment="Center"/>


                            <TextBlock
                                Grid.Column="1"

                                x:Name="TxtDiferencia"

                                Text="$0.00"

                                FontSize="18"

                                FontWeight="Bold"

                                VerticalAlignment="Center"/>

                        </Grid>


                        <!-- ESTADO -->

                        <Border
                            x:Name="BorderEstado"

                            HorizontalAlignment="Right"

                            CornerRadius="9"

                            Padding="11,5">

                            <TextBlock
                                x:Name="TxtEstado"

                                Text="CUADRADO"

                                FontSize="10"

                                FontWeight="Bold"/>

                        </Border>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- MENSAJE                                           -->
                <!-- ================================================= -->

                <Border
                    Background="#F1F8F3"

                    BorderBrush="#D7EBDD"
                    BorderThickness="1"

                    CornerRadius="10"

                    Padding="13">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="9">

                        <Border
                            Grid.Column="0"

                            Width="28"
                            Height="28"

                            CornerRadius="8"

                            Background="#E3F4E8"

                            VerticalAlignment="Top">

                            <TextBlock
                                Text="✓"

                                Foreground="#08783D"

                                FontSize="13"

                                FontWeight="Bold"

                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>


                        <TextBlock
                            Grid.Column="1"

                            Text="El turno ha sido cerrado y el corte quedó registrado en el historial."

                            Foreground="#587363"

                            FontSize="10"

                            TextWrapping="Wrap"

                            VerticalAlignment="Center"/>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- AYUDA                                             -->
                <!-- ================================================= -->

                <TextBlock
                    Text="Puedes cerrar sesión o abrir un nuevo turno para continuar operando."

                    Foreground="#94A39A"

                    FontSize="9"

                    TextAlignment="Center"

                    TextWrapping="Wrap"

                    HorizontalAlignment="Center"/>

            </StackPanel>

        </ScrollViewer>


        <!-- ===================================================== -->
        <!-- ACCIONES                                              -->
        <!-- ===================================================== -->

        <Border
            Grid.Row="1"

            Background="White"

            BorderBrush="#E2E8E4"
            BorderThickness="0,1,0,0"

            Padding="18">

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10">


                <!-- ================================================= -->
                <!-- CERRAR SESIÓN                                     -->
                <!-- ================================================= -->

                <Button
                    Grid.Column="0"

                    Height="48"

                    Content="Cerrar sesión"

                    Background="#C61F2B"

                    Foreground="White"

                    BorderThickness="0"

                    FontSize="12"

                    FontWeight="SemiBold"

                    CornerRadius="10"

                    HorizontalAlignment="Stretch"

                    HorizontalContentAlignment="Center"

                    VerticalContentAlignment="Center"

                    Click="CerrarSesion_Click"/>


                <!-- ================================================= -->
                <!-- ABRIR NUEVO TURNO                                 -->
                <!-- ================================================= -->

                <Button
                    Grid.Column="1"

                    Height="48"

                    Content="Abrir nuevo turno"

                    Background="#08783D"

                    Foreground="White"

                    BorderThickness="0"

                    FontSize="12"

                    FontWeight="SemiBold"

                    CornerRadius="10"

                    HorizontalAlignment="Stretch"

                    HorizontalContentAlignment="Center"

                    VerticalContentAlignment="Center"

                    Click="AbrirNuevoTurno_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>