<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    x:Class="NovaCoreESDM.Views.Cortes.CorteRealizadoWindow"

    Width="580"
    SizeToContent="Height"

    CanResize="False"

    WindowStartupLocation="CenterOwner"

    Title="Corte realizado"
    Icon="/Assets/Brand/esdm-app-icon.ico"

    Background="#F4F6F8">


    <StackPanel>


        <!-- ===================================================== -->
        <!-- CELEBRACIÓN Y RESUMEN                                 -->
        <!-- ===================================================== -->

        <Border Padding="30,28,30,22"
                ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#DDF7E6"/>
                    <GradientStop Offset="0.55" Color="#F4F6F8"/>
                </LinearGradientBrush>
            </Border.Background>

            <Panel>

                <!-- Confeti (decorativo) -->
                <Canvas Height="150"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False">
                    <Border Classes="confeti c1" Canvas.Left="60"  Background="#22C55E"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
                    <Border Classes="confeti c2" Canvas.Left="120" Background="#F5C400"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
                    <Border Classes="confeti c3" Canvas.Left="175" Background="#C61F2B"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
                    <Border Classes="confeti c4" Canvas.Left="345" Background="#B5651D"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
                    <Border Classes="confeti c5" Canvas.Left="400" Background="#22C55E"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
                    <Border Classes="confeti c6" Canvas.Left="460" Background="#F5C400"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
                </Canvas>

                <StackPanel Spacing="14">

                    <!-- Ícono con pulso -->
                    <Panel Width="84" Height="84"
                           HorizontalAlignment="Center">
                        <Ellipse Classes="pulso"
                                 Fill="#3322C55E"
                                 RenderTransformOrigin="50%,50%">
                            <Ellipse.RenderTransform>
                                <ScaleTransform/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Border Width="62" Height="62"
                                CornerRadius="31"
                                BoxShadow="0 10 22 -8 #8016A34A">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Offset="0" Color="#22C55E"/>
                                    <GradientStop Offset="1" Color="#0E9A46"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <PathIcon Width="30" Height="30"
                                      Foreground="White"
                                      Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                        </Border>
                    </Panel>

                    <!-- Título -->
                    <StackPanel Spacing="8"
                                HorizontalAlignment="Center">
                        <TextBlock Text="Corte realizado correctamente"
                                   Foreground="#0B1220"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   LetterSpacing="-0.4"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                        <Border HorizontalAlignment="Center"
                                Padding="12,4"
                                CornerRadius="999"
                                Background="White"
                                BorderBrush="#CDEFD9"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Width="13" Height="13"
                                          Foreground="#16A34A"
                                          Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/>
                                <TextBlock x:Name="TxtCorte"
                                           Text="Corte registrado"
                                           Foreground="#0B6B33"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Resumen -->
                    <Border Padding="20,16"
                            CornerRadius="18"
                            Background="White"
                            BorderBrush="#EAEEF2"
                            BorderThickness="1"
                            BoxShadow="0 1 2 0 #0A0F172A"
                            Margin="0,4,0,0">

                        <StackPanel Spacing="12">

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">

                                <Border Grid.Column="0" Classes="cifra">
                                    <StackPanel>
                                        <TextBlock Classes="etiqueta" Text="Efectivo esperado"/>
                                        <TextBlock x:Name="TxtEsperado" Classes="valor" Text="$0.00"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Classes="cifra">
                                    <StackPanel>
                                        <TextBlock Classes="etiqueta" Text="Efectivo contado"/>
                                        <TextBlock x:Name="TxtDeclarado" Classes="valor" Text="$0.00"/>
                                    </StackPanel>
                                </Border>

                            </Grid>

                            <!-- Los colores de la diferencia los pone el código -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="DIFERENCIA"
                                               Foreground="#94A3B8"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               LetterSpacing="1.2"
                                               LineHeight="16"/>
                                    <Border x:Name="BorderEstado"
                                            HorizontalAlignment="Left"
                                            CornerRadius="999"
                                            Padding="12,4">
                                        <TextBlock x:Name="TxtEstado"
                                                   Text="CUADRADO"
                                                   FontSize="12"
                                                   FontWeight="Bold"
                                                   LetterSpacing="1"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           x:Name="TxtDiferencia"
                                           Text="$0.00"
                                           FontSize="32"
                                           FontWeight="Bold"
                                           LetterSpacing="-0.8"
                                           VerticalAlignment="Center"/>
                            </Grid>

                        </StackPanel>

                    </Border>

                    <!-- Mensaje -->
                    <Border Padding="14,12"
                            CornerRadius="16"
                            Background="#ECFDF3"
                            BorderBrush="#BBF7D0"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">
                            <Border Width="38" Height="38"
                                    CornerRadius="12"
                                    Background="#D1FADF"
                                    VerticalAlignment="Center">
                                <PathIcon Width="20" Height="20"
                                          Foreground="#16A34A"
                                          Data="M18 8h-1V6c0-2.8-2.2-5-5-5S7 3.2 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.7 1.4-3.1 3.1-3.1s3.1 1.4 3.1 3.1v2z"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="El turno ha sido cerrado y el corte quedó registrado en el historial."
                                           Foreground="#14532D"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Puedes cerrar sesión o abrir un nuevo turno para continuar operando."
                                           Foreground="#3F7A55"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                </StackPanel>

            </Panel>

        </Border>


        <!-- ===================================================== -->
        <!-- ACCIONES                                              -->
        <!-- ===================================================== -->

        <Border Background="White"
                BorderBrush="#EAEEF2"
                BorderThickness="0,1,0,0"
                Padding="30,18,30,22">

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">

                <Button Grid.Column="0"
                        Classes="salir"
                        Click="CerrarSesion_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="16" Height="16"
                                  Data="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5-5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z"/>
                        <TextBlock Text="Cerrar sesión" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="1"
                        Classes="turno"
                        Click="AbrirNuevoTurno_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="16" Height="16"
                                  Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                        <TextBlock Text="Abrir nuevo turno" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>

        </Border>

    </StackPanel>


    <!-- ========================================================= -->
    <!-- ESTILOS                                                   -->
    <!-- ========================================================= -->

    <Window.Styles>

        <Style Selector="Ellipse.pulso">
            <Style.Animations>
                <Animation Duration="0:0:1.8"
                           IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.75"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.75"/>
                        <Setter Property="Opacity" Value="0.9"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.25"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.25"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Confeti cayendo con distintos tiempos -->
        <Style Selector="Border.confeti">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Canvas.Top" Value="-14"/>
        </Style>

        <Style Selector="Border.c1">
            <Style.Animations>
                <Animation Duration="0:0:2.6" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0"/><Setter Property="TranslateTransform.X" Value="0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="150"/><Setter Property="TranslateTransform.X" Value="14"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.c2">
            <Style.Animations>
                <Animation Duration="0:0:3.1" Delay="0:0:0.6" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0"/><Setter Property="TranslateTransform.X" Value="0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="150"/><Setter Property="TranslateTransform.X" Value="-12"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.c3">
            <Style.Animations>
                <Animation Duration="0:0:2.8" Delay="0:0:1.2" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0"/><Setter Property="TranslateTransform.X" Value="0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="150"/><Setter Property="TranslateTransform.X" Value="10"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.c4">
            <Style.Animations>
                <Animation Duration="0:0:3" Delay="0:0:0.3" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0"/><Setter Property="TranslateTransform.X" Value="0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="150"/><Setter Property="TranslateTransform.X" Value="-14"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.c5">
            <Style.Animations>
                <Animation Duration="0:0:2.7" Delay="0:0:0.9" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0"/><Setter Property="TranslateTransform.X" Value="0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="150"/><Setter Property="TranslateTransform.X" Value="12"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.c6">
            <Style.Animations>
                <Animation Duration="0:0:3.2" Delay="0:0:1.5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%"><Setter Property="TranslateTransform.Y" Value="0"/><Setter Property="TranslateTransform.X" Value="0"/><Setter Property="Opacity" Value="1"/></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="TranslateTransform.Y" Value="150"/><Setter Property="TranslateTransform.X" Value="-10"/><Setter Property="Opacity" Value="0"/></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.cifra">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#EEF1F4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="TextBlock.etiqueta">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>

        <Style Selector="TextBlock.valor">
            <Setter Property="Foreground" Value="#0B1220"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Botones -->
        <Style Selector="Button.salir, Button.turno">
            <Setter Property="Height" Value="56"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.salir">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#F5C2C2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
        </Style>

        <Style Selector="Button.salir:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#991B1B"/>
        </Style>

        <Style Selector="Button.salir:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#FDE2E2"/>
        </Style>

        <Style Selector="Button.turno">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#22C55E"/>
                    <GradientStop Offset="1" Color="#0E9A46"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.turno /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 10 24 -8 #8016A34A"/>
        </Style>

        <Style Selector="Button.turno:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#2BD468"/>
                    <GradientStop Offset="1" Color="#10A94D"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.turno:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0B7A38"/>
        </Style>

    </Window.Styles>

</Window>
