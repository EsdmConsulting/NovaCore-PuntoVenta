<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NovaCoreESDM.ViewModels.Cortes"

             x:Class="NovaCoreESDM.Views.Cortes.CortesView"
             x:DataType="vm:CortesViewModel"

             Background="#F6F8F7">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="28"
                    Spacing="20">


            <!-- ================================================= -->
            <!-- ENCABEZADO                                        -->
            <!-- ================================================= -->

            <Border Background="#08783D"
                    CornerRadius="18"
                    Padding="28">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="24">

                    <StackPanel Spacing="7"
                                VerticalAlignment="Center">

                        <TextBlock Text="GRUPO LUIS FER"
                                   Foreground="#C9F2D8"
                                   FontSize="11"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Control de caja"
                                   Foreground="White"
                                   FontSize="26"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Consulta aperturas, cierres y resultados de cada turno."
                                   Foreground="#D8F3E2"
                                   FontSize="14"/>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="8"
                                    Margin="0,8,0,0">

                            <Border Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Background="#22C55E"
                                    VerticalAlignment="Center"/>

                            <TextBlock Text="Información del turno actual"
                                       Foreground="#E6F8ED"
                                       FontSize="11"
                                       VerticalAlignment="Center"/>

                        </StackPanel>

                    </StackPanel>


                    <Button Grid.Column="1"
                            Classes="primaryButton"
                            Content="Realizar corte"
                            Width="170"
                            VerticalAlignment="Center"
                            IsEnabled="False"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- ESTADO DEL TURNO                                  -->
            <!-- ================================================= -->

            <Border Classes="sectionCard">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="24">

                    <StackPanel Spacing="8"
                                VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal"
                                    Spacing="10">

                            <Border Width="11"
                                    Height="11"
                                    CornerRadius="6"
                                    Background="#94A39A"
                                    VerticalAlignment="Center"/>

                            <TextBlock Text="Estado del turno"
                                       Foreground="#21382A"
                                       FontSize="19"
                                       FontWeight="SemiBold"/>

                        </StackPanel>

                        <TextBlock Text="Aquí se mostrará la información correspondiente al turno activo."
                                   Foreground="#718078"
                                   FontSize="13"/>

                        <TextBlock Text="Al finalizar podrás realizar el corte y comparar el efectivo esperado contra el efectivo contado."
                                   Foreground="#94A39A"
                                   FontSize="11"/>

                    </StackPanel>


                    <Border Grid.Column="1"
                            Background="#F8FAF9"
                            BorderBrush="#E4EAE6"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="18,12"
                            VerticalAlignment="Center">

                        <StackPanel Spacing="3">

                            <TextBlock Text="Hora de apertura"
                                       Foreground="#94A39A"
                                       FontSize="10"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="--:--"
                                       Foreground="#33443A"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- INDICADORES                                       -->
            <!-- ================================================= -->

            <Grid ColumnDefinitions="*,*,*,*"
                  ColumnSpacing="15">


                <!-- VENTAS -->

                <Border Grid.Column="0"
                        Classes="dashboardCard">

                    <StackPanel Spacing="7">

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock Text="Ventas"
                                       Classes="cardLabel"/>

                            <Border Grid.Column="1"
                                    Width="34"
                                    Height="34"
                                    CornerRadius="10"
                                    Background="#EAF7EF">

                                <TextBlock Text="$"
                                           Foreground="#08783D"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                        </Grid>

                        <TextBlock Text="$0.00"
                                   Classes="cardValue"/>

                        <TextBlock Text="Total del turno actual"
                                   Classes="cardDetail"/>

                    </StackPanel>

                </Border>


                <!-- EFECTIVO -->

                <Border Grid.Column="1"
                        Classes="dashboardCard">

                    <StackPanel Spacing="7">

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock Text="Efectivo"
                                       Classes="cardLabel"/>

                            <Border Grid.Column="1"
                                    Width="34"
                                    Height="34"
                                    CornerRadius="10"
                                    Background="#EAF7EF">

                                <TextBlock Text="$"
                                           Foreground="#16A34A"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                        </Grid>

                        <TextBlock Text="$0.00"
                                   Classes="cardValue"/>

                        <TextBlock Text="Cobros en efectivo"
                                   Classes="cardDetail"/>

                    </StackPanel>

                </Border>


                <!-- TARJETA -->

                <Border Grid.Column="2"
                        Classes="dashboardCard">

                    <StackPanel Spacing="7">

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock Text="Tarjeta"
                                       Classes="cardLabel"/>

                            <Border Grid.Column="1"
                                    Width="34"
                                    Height="34"
                                    CornerRadius="10"
                                    Background="#FFF5EC">

                                <TextBlock Text="▰"
                                           Foreground="#A96932"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                        </Grid>

                        <TextBlock Text="$0.00"
                                   Classes="cardValue"/>

                        <TextBlock Text="Cobros con tarjeta"
                                   Classes="cardDetail"/>

                    </StackPanel>

                </Border>


                <!-- TICKETS -->

                <Border Grid.Column="3"
                        Classes="dashboardCard">

                    <StackPanel Spacing="7">

                        <Grid ColumnDefinitions="*,Auto">

                            <TextBlock Text="Tickets"
                                       Classes="cardLabel"/>

                            <Border Grid.Column="1"
                                    Width="34"
                                    Height="34"
                                    CornerRadius="10"
                                    Background="#F4F7F5">

                                <TextBlock Text="▥"
                                           Foreground="#08783D"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>

                        </Grid>

                        <TextBlock Text="0"
                                   Classes="cardValue"/>

                        <TextBlock Text="Ventas completadas"
                                   Classes="cardDetail"/>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- DESGLOSE E HISTORIAL                              -->
            <!-- ================================================= -->

            <Grid ColumnDefinitions="0.8*,1.2*"
                  ColumnSpacing="18">


                <!-- ================================================= -->
                <!-- RESUMEN DEL TURNO                                 -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Classes="sectionCard">

                    <StackPanel Spacing="16">

                        <TextBlock Text="Resumen del turno"
                                   Classes="sectionTitle"/>


                        <Border Background="#F8FAF9"
                                CornerRadius="12"
                                Padding="16"
                                BorderBrush="#EDF1EE"
                                BorderThickness="1">

                            <StackPanel Spacing="13">


                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock Text="Fondo inicial"
                                               Classes="summaryLabel"/>

                                    <TextBlock Grid.Column="1"
                                               Text="$0.00"
                                               Classes="summaryValue"/>

                                </Grid>


                                <Border Height="1"
                                        Background="#E4EAE6"/>


                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock Text="Ventas en efectivo"
                                               Classes="summaryLabel"/>

                                    <TextBlock Grid.Column="1"
                                               Text="$0.00"
                                               Classes="summaryValue"/>

                                </Grid>


                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock Text="Ventas con tarjeta"
                                               Classes="summaryLabel"/>

                                    <TextBlock Grid.Column="1"
                                               Text="$0.00"
                                               Classes="summaryValue"/>

                                </Grid>


                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock Text="Retiros de caja"
                                               Classes="summaryLabel"/>

                                    <TextBlock Grid.Column="1"
                                               Text="$0.00"
                                               Classes="summaryValue"/>

                                </Grid>


                                <Border Height="1"
                                        Background="#E4EAE6"/>


                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock Text="Efectivo esperado"
                                               Foreground="#21382A"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Grid.Column="1"
                                               Text="$0.00"
                                               Foreground="#08783D"
                                               FontSize="17"
                                               FontWeight="Bold"/>

                                </Grid>

                            </StackPanel>

                        </Border>


                        <Border Background="#FFF8E8"
                                BorderBrush="#F3D89B"
                                BorderThickness="1"
                                CornerRadius="11"
                                Padding="13">

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10">

                                <Border Width="9"
                                        Height="9"
                                        CornerRadius="5"
                                        Background="#C79A3B"
                                        VerticalAlignment="Center"/>

                                <TextBlock Text="La diferencia se calculará al realizar el cierre."
                                           Foreground="#8A6422"
                                           FontSize="10"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </Border>


                <!-- ================================================= -->
                <!-- HISTORIAL                                         -->
                <!-- ================================================= -->

                <Border Grid.Column="1"
                        Classes="sectionCard">

                    <Grid RowDefinitions="Auto,*">


                        <Grid Grid.Row="0"
                              ColumnDefinitions="*,Auto"
                              Margin="0,0,0,16">

                            <StackPanel Spacing="3">

                                <TextBlock Text="Historial de cortes"
                                           Classes="sectionTitle"/>

                                <TextBlock Text="Consulta los cierres realizados anteriormente."
                                           Foreground="#94A39A"
                                           FontSize="10"/>

                            </StackPanel>


                            <Button Grid.Column="1"
                                    Classes="secondaryButton"
                                    Content="Actualizar"
                                    VerticalAlignment="Center"/>

                        </Grid>


                        <Border Grid.Row="1"
                                MinHeight="250"
                                Background="#F8FAF9"
                                BorderBrush="#EDF1EE"
                                BorderThickness="1"
                                CornerRadius="12">

                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="9">

                                <Border Width="66"
                                        Height="66"
                                        CornerRadius="21"
                                        Background="#EAF7EF">

                                    <TextBlock Text="▥"
                                               Foreground="#7CB88B"
                                               FontSize="31"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>


                                <TextBlock Text="Todavía no hay cortes registrados"
                                           Foreground="#44534A"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>


                                <TextBlock Text="Los cierres de caja aparecerán en esta sección."
                                           Foreground="#94A39A"
                                           FontSize="11"/>

                            </StackPanel>

                        </Border>

                    </Grid>

                </Border>

            </Grid>

        </StackPanel>

    </ScrollViewer>


    <!-- ========================================================= -->
    <!-- ESTILOS                                                   -->
    <!-- ========================================================= -->

    <UserControl.Styles>


        <Style Selector="Border.dashboardCard">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="21"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8E4"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="MinHeight"
                    Value="135"/>

        </Style>


        <Style Selector="TextBlock.cardLabel">

            <Setter Property="Foreground"
                    Value="#718078"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="Medium"/>

        </Style>


        <Style Selector="TextBlock.cardValue">

            <Setter Property="Foreground"
                    Value="#21382A"/>

            <Setter Property="FontSize"
                    Value="26"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <Style Selector="TextBlock.cardDetail">

            <Setter Property="Foreground"
                    Value="#94A39A"/>

            <Setter Property="FontSize"
                    Value="10"/>

        </Style>


        <Style Selector="Border.sectionCard">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="CornerRadius"
                    Value="14"/>

            <Setter Property="Padding"
                    Value="21"/>

            <Setter Property="BorderBrush"
                    Value="#E4EAE6"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

        </Style>


        <Style Selector="TextBlock.sectionTitle">

            <Setter Property="Foreground"
                    Value="#21382A"/>

            <Setter Property="FontSize"
                    Value="16"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <Style Selector="TextBlock.summaryLabel">

            <Setter Property="Foreground"
                    Value="#718078"/>

            <Setter Property="FontSize"
                    Value="11"/>

        </Style>


        <Style Selector="TextBlock.summaryValue">

            <Setter Property="Foreground"
                    Value="#33443A"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <!-- ===================================================== -->
        <!-- BOTÓN PRINCIPAL                                      -->
        <!-- ===================================================== -->

        <Style Selector="Button.primaryButton">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Padding"
                    Value="20,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="#16A34A"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <Style Selector="Button.primaryButton:pointerover">

            <Setter Property="Background"
                    Value="#15803D"/>

        </Style>


        <!-- ===================================================== -->
        <!-- BOTÓN SECUNDARIO                                     -->
        <!-- ===================================================== -->

        <Style Selector="Button.secondaryButton">

            <Setter Property="Height"
                    Value="40"/>

            <Setter Property="Padding"
                    Value="15,0"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="#F1F8F3"/>

            <Setter Property="Foreground"
                    Value="#08783D"/>

            <Setter Property="BorderBrush"
                    Value="#D7E9DD"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="9"/>

            <Setter Property="FontSize"
                    Value="11"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <Style Selector="Button.secondaryButton:pointerover">

            <Setter Property="Background"
                    Value="#EAF7EF"/>

        </Style>

    </UserControl.Styles>

</UserControl>