<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NovaCoreESDM.ViewModels.Cortes"

    x:Class="NovaCoreESDM.Views.Cortes.CortesView"
    x:DataType="vm:CortesViewModel"

    Background="#F5F7F6">


    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">


        <StackPanel
            Margin="28"
            Spacing="20">


            <!-- ================================================= -->
            <!-- HERO                                               -->
            <!-- ================================================= -->

            <Border
                Background="#08783D"
                CornerRadius="20"
                Padding="30">


                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="30">


                    <StackPanel
                        Spacing="7"
                        VerticalAlignment="Center">


                        <TextBlock
                            Text="GRUPO LUIS FER"
                            Foreground="#C8F3D9"
                            FontSize="11"
                            FontWeight="Bold"/>


                        <TextBlock
                            Text="Cortes y reportes"
                            Foreground="White"
                            FontSize="28"
                            FontWeight="SemiBold"/>


                        <TextBlock
                            Text="Supervisa el turno activo, revisa movimientos y realiza el cierre de caja."
                            Foreground="#D9F4E3"
                            FontSize="14"/>


                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="8"
                            Margin="0,8,0,0">


                            <Border
                                Width="8"
                                Height="8"
                                CornerRadius="4"
                                Background="#4ADE80"
                                VerticalAlignment="Center"/>


                            <TextBlock
                                Text="Control operativo de caja"
                                Foreground="#E6F8ED"
                                FontSize="11"
                                VerticalAlignment="Center"/>

                        </StackPanel>

                    </StackPanel>


                    <Button
                        Grid.Column="1"
                        Classes="primaryButton"
                        Width="175"
                        VerticalAlignment="Center"

                        Content="Realizar corte"

                        IsEnabled="{Binding PuedeRealizarCorte}"
                        
                        Click="RealizarCorte_Click"/>

                </Grid>

            </Border>



            <!-- ================================================= -->
            <!-- TURNO ACTUAL                                       -->
            <!-- ================================================= -->

            <Border Classes="sectionCard">


                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="24">


                    <StackPanel
                        Spacing="11">


                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="10">


                            <Border
                                Width="11"
                                Height="11"
                                CornerRadius="6"
                                Background="#16A34A"
                                VerticalAlignment="Center"/>


                            <TextBlock
                                Text="{Binding EstadoTurno}"
                                Foreground="#21382A"
                                FontSize="19"
                                FontWeight="SemiBold"/>

                        </StackPanel>


                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6">


                            <TextBlock
                                Text="{Binding CajaNombre}"
                                Foreground="#33443A"
                                FontSize="15"
                                FontWeight="SemiBold"/>


                            <TextBlock
                                Text="·"
                                Foreground="#94A39A"
                                FontSize="15"/>


                            <TextBlock
                                Text="{Binding CajaCodigo}"
                                Foreground="#718078"
                                FontSize="15"/>

                        </StackPanel>


                        <Grid
                            ColumnDefinitions="Auto,24,Auto,24,Auto"
                            Margin="0,4,0,0">


                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Text="TURNO"
                                    Classes="miniLabel"/>

                                <TextBlock
                                    Text="{Binding IdTurno}"
                                    Classes="miniValue"/>

                            </StackPanel>


                            <Border
                                Grid.Column="1"
                                Width="1"
                                Background="#E3E9E5"/>


                            <StackPanel
                                Grid.Column="2"
                                Spacing="3">

                                <TextBlock
                                    Text="ABIERTO POR"
                                    Classes="miniLabel"/>

                                <TextBlock
                                    Text="{Binding UsuarioApertura}"
                                    Classes="miniValue"/>

                            </StackPanel>


                            <Border
                                Grid.Column="3"
                                Width="1"
                                Background="#E3E9E5"/>


                            <StackPanel
                                Grid.Column="4"
                                Spacing="3">

                                <TextBlock
                                    Text="FECHA"
                                    Classes="miniLabel"/>

                                <TextBlock
                                    Text="{Binding FechaApertura}"
                                    Classes="miniValue"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>



                    <Border
                        Grid.Column="1"
                        Background="#F4FAF6"
                        BorderBrush="#DCEDE2"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="22,14"
                        VerticalAlignment="Center">


                        <StackPanel
                            Spacing="4">


                            <TextBlock
                                Text="Hora de apertura"
                                Foreground="#7C8D82"
                                FontSize="10"
                                HorizontalAlignment="Right"/>


                            <TextBlock
                                Text="{Binding HoraApertura}"
                                Foreground="#08783D"
                                FontSize="24"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right"/>

                        </StackPanel>

                    </Border>

                </Grid>

            </Border>



            <!-- ================================================= -->
            <!-- KPIs                                               -->
            <!-- ================================================= -->

            <Grid
                ColumnDefinitions="*,*,*,*"
                ColumnSpacing="15">


                <!-- VENTAS -->

                <Border
                    Grid.Column="0"
                    Classes="dashboardCard">


                    <StackPanel Spacing="8">


                        <Grid ColumnDefinitions="*,Auto">


                            <TextBlock
                                Text="Ventas del turno"
                                Classes="cardLabel"/>


                            <Border
                                Grid.Column="1"
                                Classes="greenIcon">

                                <TextBlock
                                    Text="$"
                                    Classes="greenIconText"/>

                            </Border>

                        </Grid>


                        <TextBlock
                            Text="{Binding TotalVentasTexto}"
                            Classes="cardValue"/>


                        <TextBlock
                            Text="Total de ventas finalizadas"
                            Classes="cardDetail"/>

                    </StackPanel>

                </Border>



                <!-- TICKETS -->

                <Border
                    Grid.Column="1"
                    Classes="dashboardCard">


                    <StackPanel Spacing="8">


                        <Grid ColumnDefinitions="*,Auto">


                            <TextBlock
                                Text="Tickets"
                                Classes="cardLabel"/>


                            <Border
                                Grid.Column="1"
                                Classes="neutralIcon">

                                <TextBlock
                                    Text="▥"
                                    Foreground="#08783D"
                                    FontSize="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </Grid>


                        <TextBlock
                            Text="{Binding TicketsTexto}"
                            Classes="cardValue"/>


                        <TextBlock
                            Text="Operaciones completadas"
                            Classes="cardDetail"/>

                    </StackPanel>

                </Border>



                <!-- EFECTIVO -->

                <Border
                    Grid.Column="2"
                    Classes="dashboardCard">


                    <StackPanel Spacing="8">


                        <Grid ColumnDefinitions="*,Auto">


                            <TextBlock
                                Text="Ventas en efectivo"
                                Classes="cardLabel"/>


                            <Border
                                Grid.Column="1"
                                Classes="greenIcon">

                                <TextBlock
                                    Text="$"
                                    Classes="greenIconText"/>

                            </Border>

                        </Grid>


                        <TextBlock
                            Text="{Binding VentasEfectivoTexto}"
                            Classes="cardValue"/>


                        <TextBlock
                            Text="Cobros de ventas"
                            Classes="cardDetail"/>

                    </StackPanel>

                </Border>



                <!-- TARJETAS -->

                <Border
                    Grid.Column="3"
                    Classes="dashboardCard">


                    <StackPanel Spacing="8">


                        <Grid ColumnDefinitions="*,Auto">


                            <TextBlock
                                Text="Tarjetas"
                                Classes="cardLabel"/>


                            <Border
                                Grid.Column="1"
                                Classes="orangeIcon">

                                <TextBlock
                                    Text="▰"
                                    Foreground="#A96932"
                                    FontSize="15"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>

                            </Border>

                        </Grid>


                        <TextBlock
                            Text="{Binding VentasTarjetaTexto}"
                            Classes="cardValue"/>


                        <TextBlock
                            Text="Cobros con tarjeta"
                            Classes="cardDetail"/>

                    </StackPanel>

                </Border>

            </Grid>



            <!-- ================================================= -->
            <!-- SEGUNDA FILA DE INDICADORES                        -->
            <!-- ================================================= -->

            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="15">


                <!-- TRANSFERENCIAS -->

                <Border
                    Grid.Column="0"
                    Classes="smallDashboardCard">

                    <Grid
                        ColumnDefinitions="*,Auto">


                        <StackPanel Spacing="5">

                            <TextBlock
                                Text="Transferencias"
                                Classes="cardLabel"/>

                            <TextBlock
                                Text="{Binding VentasTransferenciaTexto}"
                                Classes="smallCardValue"/>

                        </StackPanel>


                        <Border
                            Grid.Column="1"
                            Classes="blueIcon">

                            <TextBlock
                                Text="↔"
                                Foreground="#346995"
                                FontSize="17"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>



                <!-- CRÉDITO -->

                <Border
                    Grid.Column="1"
                    Classes="smallDashboardCard">

                    <Grid
                        ColumnDefinitions="*,Auto">


                        <StackPanel Spacing="5">

                            <TextBlock
                                Text="Ventas a crédito"
                                Classes="cardLabel"/>

                            <TextBlock
                                Text="{Binding VentasCreditoTexto}"
                                Classes="smallCardValue"/>

                        </StackPanel>


                        <Border
                            Grid.Column="1"
                            Classes="purpleIcon">

                            <TextBlock
                                Text="C"
                                Foreground="#7656A8"
                                FontWeight="Bold"
                                FontSize="14"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                    </Grid>

                </Border>



                <!-- ABONOS -->

                <Border
                    Grid.Column="2"
                    Classes="smallDashboardCard">

                    <Grid
                        ColumnDefinitions="*,Auto">


                        <StackPanel Spacing="5">

                            <TextBlock
                                Text="Abonos crédito · efectivo"
                                Classes="cardLabel"/>

                            <TextBlock
                                Text="{Binding AbonosCreditoEfectivoTexto}"
                                Classes="smallCardValue"/>

                        </StackPanel>


                        <Border
                            Grid.Column="1"
                            Classes="greenIcon">

                            <TextBlock
                                Text="+"
                                Classes="greenIconText"/>

                        </Border>

                    </Grid>

                </Border>

            </Grid>



            <!-- ================================================= -->
            <!-- RESUMEN + HISTORIAL                                -->
            <!-- ================================================= -->

            <Grid
                ColumnDefinitions="0.85*,1.15*"
                ColumnSpacing="18">


                <!-- ============================================= -->
                <!-- COMPOSICIÓN DEL EFECTIVO                      -->
                <!-- ============================================= -->

                <Border
                    Grid.Column="0"
                    Classes="sectionCard">


                    <StackPanel Spacing="17">


                        <StackPanel Spacing="4">

                            <TextBlock
                                Text="Composición del efectivo"
                                Classes="sectionTitle"/>

                            <TextBlock
                                Text="Movimientos que forman el efectivo físico esperado."
                                Foreground="#94A39A"
                                FontSize="10"/>

                        </StackPanel>



                        <Border
                            Background="#F8FAF9"
                            CornerRadius="12"
                            Padding="17"
                            BorderBrush="#EDF1EE"
                            BorderThickness="1">


                            <StackPanel Spacing="12">


                                <!-- FONDO -->

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        Text="Fondo inicial"
                                        Classes="summaryLabel"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding FondoInicialTexto}"
                                        Classes="summaryValue"/>

                                </Grid>


                                <!-- VENTAS EFECTIVO -->

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        Text="Ventas en efectivo"
                                        Classes="summaryLabel"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding VentasEfectivoTexto}"
                                        Classes="summaryValue"/>

                                </Grid>


                                <!-- ABONOS -->

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        Text="Abonos de crédito en efectivo"
                                        Classes="summaryLabel"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding AbonosCreditoEfectivoTexto}"
                                        Classes="summaryValue"/>

                                </Grid>


                                <!-- INGRESOS -->

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        Text="Otros ingresos"
                                        Classes="summaryLabel"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding OtrosIngresosTexto}"
                                        Classes="summaryValue"/>

                                </Grid>


                                <Border
                                    Height="1"
                                    Background="#E4EAE6"/>


                                <!-- RETIROS -->

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        Text="Retiros"
                                        Classes="summaryLabel"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding RetirosTexto}"
                                        Classes="summaryNegative"/>

                                </Grid>


                                <!-- EGRESOS -->

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        Text="Egresos"
                                        Classes="summaryLabel"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding EgresosTexto}"
                                        Classes="summaryNegative"/>

                                </Grid>


                                <!-- DEVOLUCIONES -->

                                <Grid ColumnDefinitions="*,Auto">

                                    <TextBlock
                                        Text="Devoluciones"
                                        Classes="summaryLabel"/>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding DevolucionesTexto}"
                                        Classes="summaryNegative"/>

                                </Grid>


                                <Border
                                    Height="1"
                                    Background="#DDE5E0"
                                    Margin="0,3"/>



                                <!-- ESPERADO -->

                                <Grid ColumnDefinitions="*,Auto">

                                    <StackPanel Spacing="2">

                                        <TextBlock
                                            Text="Efectivo esperado"
                                            Foreground="#21382A"
                                            FontSize="13"
                                            FontWeight="SemiBold"/>

                                        <TextBlock
                                            Text="Importe que debería existir físicamente."
                                            Foreground="#94A39A"
                                            FontSize="9"/>

                                    </StackPanel>


                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding EfectivoEsperadoTexto}"
                                        Foreground="#08783D"
                                        FontSize="19"
                                        FontWeight="Bold"
                                        VerticalAlignment="Center"/>

                                </Grid>

                            </StackPanel>

                        </Border>



                        <Border
                            Background="#EFF8F2"
                            BorderBrush="#D7EBDD"
                            BorderThickness="1"
                            CornerRadius="11"
                            Padding="13">


                            <TextBlock
                                Text="El efectivo contado se capturará únicamente al realizar el corte."
                                Foreground="#4D7359"
                                FontSize="10"
                                TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>

                </Border>



                <!-- ============================================= -->
                <!-- HISTORIAL                                     -->
                <!-- ============================================= -->

                <Border
                    Grid.Column="1"
                    Classes="sectionCard">


                    <Grid RowDefinitions="Auto,*">


                        <!-- HEADER -->

                        <Grid
                            Grid.Row="0"
                            ColumnDefinitions="*,Auto"
                            Margin="0,0,0,16">


                            <StackPanel Spacing="3">

                                <TextBlock
                                    Text="Historial de cortes"
                                    Classes="sectionTitle"/>

                                <TextBlock
                                    Text="Últimos cierres registrados en caja."
                                    Foreground="#94A39A"
                                    FontSize="10"/>

                            </StackPanel>


                            <Button
                                Grid.Column="1"
                                Classes="secondaryButton"
                                Content="Actualizar"
                                VerticalAlignment="Center"

                                Click="Actualizar_Click"/>

                        </Grid>



                        <!-- LISTADO -->

                        <Border
                            Grid.Row="1"
                            MinHeight="300"
                            Background="#F8FAF9"
                            BorderBrush="#EDF1EE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="10">


                            <Grid>


                                <!-- ITEMS -->

                                <ItemsControl
                                    ItemsSource="{Binding Cortes}">


                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>


                                            <Border
                                                Background="White"
                                                BorderBrush="#E6EBE8"
                                                BorderThickness="1"
                                                CornerRadius="11"
                                                Padding="15"
                                                Margin="0,0,0,8">


                                                <Grid
                                                    ColumnDefinitions="Auto,*,Auto"
                                                    ColumnSpacing="14">


                                                    <!-- ID -->

                                                    <Border
                                                        Width="45"
                                                        Height="45"
                                                        CornerRadius="12"
                                                        Background="#EAF7EF"
                                                        VerticalAlignment="Center">


                                                        <TextBlock
                                                            Text="{Binding IdCorte}"
                                                            Foreground="#08783D"
                                                            FontSize="13"
                                                            FontWeight="Bold"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>

                                                    </Border>



                                                    <!-- INFO -->

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Spacing="3"
                                                        VerticalAlignment="Center">


                                                        <TextBlock
                                                            Text="{Binding Caja}"
                                                            Foreground="#33443A"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"/>


                                                        <StackPanel
                                                            Orientation="Horizontal"
                                                            Spacing="5">


                                                            <TextBlock
                                                                Text="{Binding Fecha}"
                                                                Foreground="#8A9990"
                                                                FontSize="10"/>


                                                            <TextBlock
                                                                Text="·"
                                                                Foreground="#B0BAB4"
                                                                FontSize="10"/>


                                                            <TextBlock
                                                                Text="{Binding Hora}"
                                                                Foreground="#8A9990"
                                                                FontSize="10"/>


                                                            <TextBlock
                                                                Text="· Turno"
                                                                Foreground="#B0BAB4"
                                                                FontSize="10"/>


                                                            <TextBlock
                                                                Text="{Binding IdTurno}"
                                                                Foreground="#8A9990"
                                                                FontSize="10"/>

                                                        </StackPanel>

                                                    </StackPanel>



                                                    <!-- DIFERENCIA -->

                                                    <StackPanel
                                                        Grid.Column="2"
                                                        Spacing="2"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">


                                                        <TextBlock
                                                            Text="Diferencia"
                                                            Foreground="#9AA79F"
                                                            FontSize="9"
                                                            HorizontalAlignment="Right"/>


                                                        <TextBlock
                                                            Text="{Binding DiferenciaTexto}"
                                                            Foreground="#33443A"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            HorizontalAlignment="Right"/>


                                                        <TextBlock
                                                            Text="{Binding EstadoDiferencia}"
                                                            Foreground="#08783D"
                                                            FontSize="9"
                                                            FontWeight="SemiBold"
                                                            HorizontalAlignment="Right"/>

                                                    </StackPanel>

                                                </Grid>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>

                                </ItemsControl>



                                <!-- VACÍO -->

                                <StackPanel
                                    IsVisible="{Binding NoTieneCortes}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="9">


                                    <Border
                                        Width="62"
                                        Height="62"
                                        CornerRadius="20"
                                        Background="#EAF7EF">


                                        <TextBlock
                                            Text="▥"
                                            Foreground="#7CB88B"
                                            FontSize="28"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>


                                    <TextBlock
                                        Text="Todavía no hay cortes registrados"
                                        Foreground="#44534A"
                                        FontSize="14"
                                        FontWeight="SemiBold"/>


                                    <TextBlock
                                        Text="Los cierres realizados aparecerán aquí."
                                        Foreground="#94A39A"
                                        FontSize="11"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </Grid>

                </Border>

            </Grid>



            <!-- ================================================= -->
            <!-- INFORMACIÓN ADICIONAL                              -->
            <!-- ================================================= -->

            <Border
                Classes="sectionCard">


                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="20">


                    <!-- TARJETAS CRÉDITO -->

                    <StackPanel
                        Grid.Column="0"
                        Spacing="5">

                        <TextBlock
                            Text="Abonos crédito · tarjeta"
                            Classes="cardLabel"/>

                        <TextBlock
                            Text="{Binding AbonosCreditoTarjetaTexto}"
                            Classes="smallCardValue"/>

                    </StackPanel>


                    <!-- TRANSFERENCIA CRÉDITO -->

                    <StackPanel
                        Grid.Column="1"
                        Spacing="5">

                        <TextBlock
                            Text="Abonos crédito · transferencia"
                            Classes="cardLabel"/>

                        <TextBlock
                            Text="{Binding AbonosCreditoTransferenciaTexto}"
                            Classes="smallCardValue"/>

                    </StackPanel>


                    <!-- NOTA -->

                    <Border
                        Grid.Column="2"
                        Background="#FFF8E8"
                        BorderBrush="#F3D89B"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12">

                        <TextBlock
                            Text="Los cobros con tarjeta y transferencia no forman parte del efectivo físico de la caja."
                            Foreground="#8A6422"
                            FontSize="10"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"/>

                    </Border>

                </Grid>

            </Border>

        </StackPanel>

    </ScrollViewer>



    <!-- ========================================================= -->
    <!-- ESTILOS                                                    -->
    <!-- ========================================================= -->

    <UserControl.Styles>


        <!-- ===================================================== -->
        <!-- CARDS                                                 -->
        <!-- ===================================================== -->

        <Style Selector="Border.dashboardCard">

            <Setter
                Property="Background"
                Value="White"/>

            <Setter
                Property="CornerRadius"
                Value="14"/>

            <Setter
                Property="Padding"
                Value="21"/>

            <Setter
                Property="BorderBrush"
                Value="#E2E8E4"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="MinHeight"
                Value="135"/>

        </Style>



        <Style Selector="Border.smallDashboardCard">

            <Setter
                Property="Background"
                Value="White"/>

            <Setter
                Property="CornerRadius"
                Value="13"/>

            <Setter
                Property="Padding"
                Value="18"/>

            <Setter
                Property="BorderBrush"
                Value="#E2E8E4"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

            <Setter
                Property="MinHeight"
                Value="92"/>

        </Style>



        <Style Selector="Border.sectionCard">

            <Setter
                Property="Background"
                Value="White"/>

            <Setter
                Property="CornerRadius"
                Value="14"/>

            <Setter
                Property="Padding"
                Value="21"/>

            <Setter
                Property="BorderBrush"
                Value="#E4EAE6"/>

            <Setter
                Property="BorderThickness"
                Value="1"/>

        </Style>



        <!-- ===================================================== -->
        <!-- TEXTOS                                                -->
        <!-- ===================================================== -->

        <Style Selector="TextBlock.cardLabel">

            <Setter
                Property="Foreground"
                Value="#718078"/>

            <Setter
                Property="FontSize"
                Value="12"/>

            <Setter
                Property="FontWeight"
                Value="Medium"/>

        </Style>



        <Style Selector="TextBlock.cardValue">

            <Setter
                Property="Foreground"
                Value="#21382A"/>

            <Setter
                Property="FontSize"
                Value="25"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

        </Style>



        <Style Selector="TextBlock.smallCardValue">

            <Setter
                Property="Foreground"
                Value="#21382A"/>

            <Setter
                Property="FontSize"
                Value="19"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

        </Style>



        <Style Selector="TextBlock.cardDetail">

            <Setter
                Property="Foreground"
                Value="#94A39A"/>

            <Setter
                Property="FontSize"
                Value="10"/>

        </Style>



        <Style Selector="TextBlock.sectionTitle">

            <Setter
                Property="Foreground"
                Value="#21382A"/>

            <Setter
                Property="FontSize"
                Value="16"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

        </Style>



        <Style Selector="TextBlock.summaryLabel">

            <Setter
                Property="Foreground"
                Value="#718078"/>

            <Setter
                Property="FontSize"
                Value="11"/>

        </Style>



        <Style Selector="TextBlock.summaryValue">

            <Setter
                Property="Foreground"
                Value="#33443A"/>

            <Setter
                Property="FontSize"
                Value="12"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

        </Style>



        <Style Selector="TextBlock.summaryNegative">

            <Setter
                Property="Foreground"
                Value="#B54747"/>

            <Setter
                Property="FontSize"
                Value="12"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

        </Style>



        <Style Selector="TextBlock.miniLabel">

            <Setter
                Property="Foreground"
                Value="#97A39C"/>

            <Setter
                Property="FontSize"
                Value="9"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

        </Style>



        <Style Selector="TextBlock.miniValue">

            <Setter
                Property="Foreground"
                Value="#44534A"/>

            <Setter
                Property="FontSize"
                Value="11"/>

            <Setter
                Property="FontWeight"
                Value="SemiBold"/>

        </Style>



        <!-- ===================================================== -->
        <!-- ICONOS                                                -->
        <!-- ===================================================== -->

        <Style Selector="Border.greenIcon">

            <Setter
                Property="Width"
