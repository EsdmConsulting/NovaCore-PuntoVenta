<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NovaCoreESDM.Views.SplashWindow"
        Width="760"
        Height="460"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="#F8FAFC">

    <Grid>

        <!-- Fondo principal -->
        <Border Background="#F8FAFC"/>

        <!-- Franja superior azul -->
        <Border Height="12"
                VerticalAlignment="Top"
                Background="#123B69"/>

        <!-- Acento verde inferior izquierdo -->
        <Ellipse Width="460"
                 Height="460"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Bottom"
                 Margin="-260,0,0,-280"
                 Fill="#17B455"
                 Opacity="0.95"/>

        <!-- Acento rojo inferior derecho -->
        <Ellipse Width="420"
                 Height="420"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-230,-250"
                 Fill="#C61F2B"
                 Opacity="0.95"/>

        <!-- Contenido central -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">

            <Image Source="avares://NovaCoreESDM/Assets/logo_grupo_luisfer.png"
                   Width="255"
                   Height="180"
                   Stretch="Uniform"/>

            <TextBlock Text="PUNTO DE VENTA"
                       Foreground="#123B69"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,6,0,0"/>

            <TextBlock Text="Grupo Luis Fer"
                       Foreground="#64748B"
                       FontSize="15"
                       HorizontalAlignment="Center"/>

            <ProgressBar Width="290"
                         Height="5"
                         Margin="0,26,0,0"
                         IsIndeterminate="True"/>

            <TextBlock Text="Inicializando el sistema..."
                       Foreground="#64748B"
                       FontSize="13"
                       Margin="0,7,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Pie -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,22"
                    Spacing="3">

            <TextBlock Text="Punto de Venta Grupo Luis Fer"
                       Foreground="#475569"
                       FontSize="11"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Desarrollado por ESDM Consulting"
                       Foreground="#94A3B8"
                       FontSize="10"
                       HorizontalAlignment="Center"/>
        </StackPanel>

    </Grid>
</Window>