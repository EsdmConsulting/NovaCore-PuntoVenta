<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NovaCoreESDM.Views.SplashWindow"
        Width="760"
        Height="460"
        CanResize="False"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{StaticResource NovaBlue950Brush}">

    <Grid>
        <!-- Círculos decorativos -->
        <Ellipse Width="540"
                 Height="540"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-270,-300,0,0"
                 Fill="{StaticResource NovaBlue600Brush}"
                 Opacity="0.18"/>

        <Ellipse Width="420"
                 Height="420"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,-210,-250"
                 Fill="{StaticResource NovaBlue600Brush}"
                 Opacity="0.16"/>

        <!-- Contenido -->
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10">

            <Border Width="105"
                    Height="105"
                    CornerRadius="53"
                    Background="{StaticResource NovaBlue600Brush}"
                    HorizontalAlignment="Center">

                <TextBlock Text="N"
                           Foreground="{StaticResource NovaWhiteBrush}"
                           FontSize="58"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <TextBlock Text="NovaCoreESDM"
                       Foreground="{StaticResource NovaWhiteBrush}"
                       FontSize="38"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Punto de Venta"
                       Foreground="{StaticResource NovaTextSoftBrush}"
                       FontSize="18"
                       HorizontalAlignment="Center"/>

            <ProgressBar Width="290"
                         Height="5"
                         Margin="0,30,0,0"
                         IsIndeterminate="True"/>

            <TextBlock Text="Inicializando el sistema..."
                       Foreground="{StaticResource NovaTextSoftBrush}"
                       FontSize="13"
                       Margin="0,7,0,0"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="Desarrollado por ESDM Consulting"
                   Foreground="{StaticResource NovaTextSoftBrush}"
                   FontSize="11"
                   Opacity="0.75"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,22"/>
    </Grid>
</Window>