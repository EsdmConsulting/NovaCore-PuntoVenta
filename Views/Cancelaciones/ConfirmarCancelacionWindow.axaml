<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

    x:Class="NovaCoreESDM.Views.Cancelaciones.ConfirmarCancelacionWindow"

    Width="540"
    SizeToContent="Height"

    CanResize="False"

    WindowStartupLocation="CenterOwner"

    Title="Confirmar cancelación"
    Icon="/Assets/Brand/esdm-app-icon.ico"

    Background="#F4F6F8">


    <StackPanel>


        <!-- ===================================================== -->
        <!-- PREGUNTA Y RESUMEN                                    -->
        <!-- ===================================================== -->

        <Border Padding="30,28,30,22">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#FDECEC"/>
                    <GradientStop Offset="0.55" Color="#F4F6F8"/>
                </LinearGradientBrush>
            </Border.Background>

            <StackPanel Spacing="14">

                <!-- Ícono con pulso -->
                <Panel Width="84" Height="84"
                       HorizontalAlignment="Center">
                    <Ellipse Classes="pulso"
                             Fill="#33E11D48"
                             RenderTransformOrigin="50%,50%">
                        <Ellipse.RenderTransform>
                            <ScaleTransform/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Border Width="62" Height="62"
                            CornerRadius="31">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Offset="0" Color="#EF4444"/>
                                <GradientStop Offset="1" Color="#B91C1C"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <PathIcon Width="28" Height="28"
                                  Foreground="White"
                                  Data="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"/>
                    </Border>
                </Panel>

                <StackPanel Spacing="4"
                            HorizontalAlignment="Center">
                    <TextBlock Text="¿Cancelar esta venta?"
                               Foreground="#0B1220"
                               FontSize="25"
                               FontWeight="Bold"
                               LetterSpacing="-0.4"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Revisa los datos antes de confirmar"
                               Foreground="#64748B"
                               FontSize="13"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Resumen de la venta -->
                <Border Padding="20,16"
                        CornerRadius="18"
                        Background="White"
                        BorderBrush="#EAEEF2"
                        BorderThickness="1"
                        Margin="0,4,0,0">

                    <StackPanel Spacing="14">

                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="14">
                            <Border Width="44" Height="44"
                                    CornerRadius="13"
                                    Background="#FEF2F2"
                                    VerticalAlignment="Center">
                                <PathIcon Width="20" Height="20"
                                          Foreground="#B91C1C"
                                          Data="M18 17H6v-2h12v2zm0-4H6v-2h12v2zm0-4H6V7h12v2zM3 22l1.5-1.5L6 22l1.5-1.5L9 22l1.5-1.5L12 22l1.5-1.5L15 22l1.5-1.5L18 22l1.5-1.5L21 22V2l-1.5 1.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2 4.5 3.5 3 2v20z"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <TextBlock Text="FOLIO"
                                           Foreground="#94A3B8"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           LetterSpacing="1.2"/>
                                <TextBlock x:Name="TextoFolio"
                                           Foreground="#0F172A"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2"
                                       x:Name="TextoTotal"
                                       Foreground="#0B1220"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       LetterSpacing="-0.6"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border x:Name="MotivoBorder"
                                Padding="12,10"
                                CornerRadius="12"
                                Background="#F8FAFB">
                            <StackPanel Spacing="3">
                                <TextBlock Text="MOTIVO"
                                           Foreground="#94A3B8"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           LetterSpacing="1.2"/>
                                <TextBlock x:Name="TextoMotivo"
                                           Foreground="#334155"
                                           FontSize="13"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>

                </Border>

                <!-- Advertencia -->
                <Border Padding="14,12"
                        CornerRadius="14"
                        Background="#FFF7E0"
                        BorderBrush="#FBD98A"
                        BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="10">
                        <PathIcon Width="18" Height="18"
                                  Foreground="#B7791F"
                                  VerticalAlignment="Top"
                                  Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                        <TextBlock Grid.Column="1"
                                   Text="La venta quedará marcada como CANCELADA y las cantidades vendidas regresarán al inventario."
                                   Foreground="#7A4E05"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

            </StackPanel>

        </Border>


        <!-- ===================================================== -->
        <!-- RESPUESTA                                             -->
        <!-- ===================================================== -->

        <Border Background="White"
                BorderBrush="#EAEEF2"
                BorderThickness="0,1,0,0"
                Padding="30,14,30,20">

            <StackPanel Spacing="12">

                <StackPanel Orientation="Horizontal"
                            Spacing="18"
                            HorizontalAlignment="Center">
                    <StackPanel Classes="atajo">
                        <Border Classes="tecla teclaSi"><TextBlock Text="S"/></Border>
                        <TextBlock Text="Sí, cancelar venta"/>
                    </StackPanel>
                    <StackPanel Classes="atajo">
                        <Border Classes="tecla"><TextBlock Text="Esc"/></Border>
                        <TextBlock Text="Volver"/>
                    </StackPanel>
                </StackPanel>

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <Button x:Name="BotonVolver"
                            Grid.Column="0"
                            Classes="volver"
                            IsCancel="True"
                            Click="Volver_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Width="14" Height="14"
                                      Data="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z"/>
                            <TextBlock Text="Volver" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Classes="cancelar"
                            Click="Confirmar_Click">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <PathIcon Width="16" Height="16"
                                      Data="M12 2C6.47 2 2 6.47 2 12s4.47 10 10 10 10-4.47 10-10S17.53 2 12 2zm5 13.59L15.59 17 12 13.41 8.41 17 7 15.59 10.59 12 7 8.41 8.41 7 12 10.59 15.59 7 17 8.41 13.41 12 17 15.59z"/>
                            <TextBlock Text="Sí, cancelar venta" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </Grid>

            </StackPanel>

        </Border>

    </StackPanel>


    <!-- ========================================================= -->
    <!-- ESTILOS                                                   -->
    <!-- ========================================================= -->

    <Window.Styles>

        <Style Selector="Ellipse.pulso">
            <Style.Animations>
                <Animation Duration="0:0:1.8"
                           IterationCount="Infinite"
                           Easing="CubicEaseOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0.75"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.75"/>
                        <Setter Property="Opacity" Value="0.9"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.2"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.2"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Atajos -->
        <Style Selector="StackPanel.atajo">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="6"/>
        </Style>

        <Style Selector="StackPanel.atajo > TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.tecla">
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#D5DCE4"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.tecla TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.tecla.teclaSi">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#F5C2C2"/>
        </Style>

        <Style Selector="Border.tecla.teclaSi TextBlock">
            <Setter Property="Foreground" Value="#B91C1C"/>
        </Style>

        <!-- Botones -->
        <Style Selector="Button.volver">
            <Setter Property="Height" Value="58"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.volver:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style Selector="Button.cancelar">
            <Setter Property="Height" Value="58"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#EF4444"/>
                    <GradientStop Offset="1" Color="#B91C1C"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.cancelar /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 10 24 -8 #80DC2626"/>
        </Style>

        <Style Selector="Button.cancelar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#F25555"/>
                    <GradientStop Offset="1" Color="#C82424"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.cancelar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#991B1B"/>
        </Style>

    </Window.Styles>

</Window>
