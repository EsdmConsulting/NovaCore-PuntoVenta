<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovaCoreESDM.ViewModels.Ventas"

        x:Class="NovaCoreESDM.Views.Ventas.SeleccionarPresentacionWindow"
        x:DataType="vm:SeleccionarPresentacionViewModel"

        Title="Seleccionar presentación"
        Icon="/Assets/Brand/esdm-app-icon.ico"

        Width="560"
        Height="570"

        MinWidth="520"
        MinHeight="500"

        CanResize="False"

        WindowStartupLocation="CenterOwner"

        Background="#F5F7FA">

    <Grid Margin="30"
          RowDefinitions="Auto,*,Auto">


        <!-- ===================================================== -->
        <!-- ENCABEZADO                                            -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="0"
                    Spacing="7"
                    Margin="0,0,0,20">

            <TextBlock Text="Seleccionar presentación"
                       Foreground="#17365D"
                       FontSize="25"
                       FontWeight="SemiBold"/>

            <TextBlock Text="{Binding Producto.NombreComercial}"
                       Foreground="#16803B"
                       FontSize="17"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Selecciona cómo se venderá este producto."
                       Foreground="#64748B"
                       FontSize="12"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- PRESENTACIONES                                        -->
        <!-- ===================================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <ListBox ItemsSource="{Binding Presentaciones}"
                     SelectedItem="{Binding PresentacionSeleccionada}"
                     Background="Transparent"
                     BorderThickness="0">

                <ListBox.ItemTemplate>

                    <DataTemplate x:DataType="vm:PresentacionVentaItem">

                        <Border Classes="presentacionCard">

                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="16">

                                <!-- DATOS -->

                                <StackPanel Grid.Column="0"
                                            Spacing="5">

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8">

                                        <TextBlock Text="{Binding NombrePresentacion}"
                                                   Foreground="#172033"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <Border IsVisible="{Binding EsBase}"
                                                Background="#EAF6EE"
                                                CornerRadius="6"
                                                Padding="6,2">

                                            <TextBlock Text="Base"
                                                       Foreground="#16803B"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"/>

                                        </Border>

                                    </StackPanel>

                                    <TextBlock Text="{Binding UnidadMedida}"
                                               Foreground="#64748B"
                                               FontSize="11"/>

                                    <StackPanel Orientation="Horizontal"
                                                Spacing="5">

                                        <TextBlock Text="Factor:"
                                                   Foreground="#94A3B8"
                                                   FontSize="10"/>

                                        <TextBlock Text="{Binding FactorConversion}"
                                                   Foreground="#64748B"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>

                                    </StackPanel>

                                </StackPanel>


                                <!-- PRECIO -->

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Spacing="3">

                                    <TextBlock Text="{Binding TextoPrecio}"
                                               Foreground="#17365D"
                                               FontSize="19"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Right"/>

                                    <TextBlock Text="Precio de venta"
                                               Foreground="#94A3B8"
                                               FontSize="9"
                                               HorizontalAlignment="Right"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </ScrollViewer>


        <!-- ===================================================== -->
        <!-- BOTONES                                               -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="2"
                    Spacing="10"
                    Margin="0,18,0,0">

            <TextBlock Text="{Binding MensajeError}"
                       Foreground="#C61F2B"
                       FontSize="12"
                       MinHeight="18"
                       TextWrapping="Wrap"/>

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">

                <Button Grid.Column="0"
                        Content="Cancelar"
                        Click="Cancelar_Click"
                        Height="48"
                        Background="White"
                        Foreground="#C61F2B"
                        BorderBrush="#F3A7AD"
                        BorderThickness="1"
                        CornerRadius="9"
                        HorizontalContentAlignment="Center"
                        FontWeight="SemiBold"/>

                <Button Grid.Column="1"
                        Content="Agregar"
                        Command="{Binding ConfirmarCommand}"
                        IsEnabled="{Binding PuedeAgregar}"
                        Height="48"
                        Background="#16A34A"
                        Foreground="White"
                        BorderThickness="0"
                        CornerRadius="9"
                        HorizontalContentAlignment="Center"
                        FontWeight="SemiBold"/>

            </Grid>

        </StackPanel>

    </Grid>


    <Window.Styles>

        <Style Selector="Border.presentacionCard">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="16"/>

            <Setter Property="Margin"
                    Value="0,0,0,10"/>

        </Style>


        <Style Selector="ListBoxItem">

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

        </Style>


        <Style Selector="ListBoxItem:pointerover Border.presentacionCard">

            <Setter Property="BorderBrush"
                    Value="#16A34A"/>

            <Setter Property="Background"
                    Value="#FBFDFC"/>

        </Style>


        <Style Selector="ListBoxItem:selected Border.presentacionCard">

            <Setter Property="BorderBrush"
                    Value="#16A34A"/>

            <Setter Property="BorderThickness"
                    Value="2"/>

            <Setter Property="Background"
                    Value="#EAF6EE"/>

        </Style>

    </Window.Styles>

</Window>