<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovaCoreESDM.ViewModels.Ventas"

        x:Class="NovaCoreESDM.Views.Ventas.SeleccionarPresentacionWindow"
        x:DataType="vm:SeleccionarPresentacionViewModel"

        Title="Seleccionar presentación"
        Icon="/Assets/Brand/esdm-app-icon.ico"

        Width="620"
        Height="580"

        MinWidth="480"
        MinHeight="440"

        CanResize="True"

        WindowStartupLocation="CenterOwner"

        Background="#F4F6F8">


    <!-- ========================================================= -->
    <!-- CONTENIDO GENERAL                                         -->
    <!-- ========================================================= -->

    <Grid RowDefinitions="Auto,*,Auto">


        <!-- ===================================================== -->
        <!-- ENCABEZADO                                            -->
        <!-- ===================================================== -->

        <Border Grid.Row="0"
                Padding="26,24,26,20"
                BorderBrush="#E3F1E8"
                BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#F3FBF6"/>
                    <GradientStop Offset="1" Color="#FFFFFF"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid ColumnDefinitions="Auto,*"
                  ColumnSpacing="16">

                <!-- Imagen del producto -->
                <Border Width="72"
                        Height="72"
                        CornerRadius="18"
                        ClipToBounds="True"
                        Background="White"
                        BorderBrush="#E3F1E8"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <Grid>
                        <Image Source="{Binding Producto.ImagenBitmap}"
                               Stretch="UniformToFill"
                               IsVisible="{Binding Producto.TieneImagenCargada}"/>
                        <PathIcon Width="30" Height="30"
                                  Foreground="#16A34A"
                                  IsVisible="{Binding Producto.MostrarPlaceholderImagen}"
                                  Data="M20 2H4c-1 0-2 .9-2 2v3.01c0 .72.43 1.34 1 1.69V20c0 1.1 1.1 2 2 2h14c.9 0 2-.9 2-2V8.7c.57-.35 1-.97 1-1.69V4c0-1.1-1-2-2-2zm-5 12H9v-2h6v2zm5-7H4V4l16-.02V7z"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="4">

                    <TextBlock Text="AGREGAR A LA VENTA"
                               Foreground="#16A34A"
                               FontSize="11"
                               FontWeight="Bold"
                               LetterSpacing="1.6"
                               LineHeight="16"/>

                    <TextBlock Text="{Binding Producto.NombreComercial}"
                               Foreground="#0B1220"
                               FontSize="21"
                               FontWeight="Bold"
                               LetterSpacing="-0.3"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"/>

                    <StackPanel Orientation="Horizontal"
                                Spacing="8">
                        <TextBlock Text="Elige cómo se venderá este producto"
                                   Foreground="#64748B"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <Border Padding="8,2"
                                CornerRadius="999"
                                Background="#EAF7EF"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding Presentaciones.Count, StringFormat='{}{0} opción(es)'}"
                                       Foreground="#0B6B33"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- PRESENTACIONES                                        -->
        <!-- ===================================================== -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <ListBox x:Name="PresentacionesListBox"
                     ItemsSource="{Binding Presentaciones}"
                     SelectedItem="{Binding PresentacionSeleccionada}"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="20,16,20,4">

                <!-- Sin el fondo azul de selección del tema -->
                <ListBox.Resources>
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentLowBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentMediumBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="SystemControlHighlightListAccentHighBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="SystemControlHighlightListLowBrush" Color="Transparent"/>
                    <SolidColorBrush x:Key="SystemControlHighlightListMediumBrush" Color="Transparent"/>
                </ListBox.Resources>

                <ListBox.ItemTemplate>

                    <DataTemplate x:DataType="vm:PresentacionVentaItem">


                        <!-- ================================================= -->
                        <!-- TARJETA DE PRESENTACIÓN                           -->
                        <!-- ================================================= -->

                        <Border Classes="presentacionCard">

                            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                  ColumnSpacing="14">


                                <!-- Indicador de selección -->
                                <Border Grid.Column="0"
                                        Classes="radio"
                                        VerticalAlignment="Center">
                                    <PathIcon Classes="marcaRadio"
                                              Width="12" Height="12"
                                              Foreground="White"
                                              Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                </Border>


                                <!-- Ícono -->
                                <Border Grid.Column="1"
                                        Classes="iconoPresentacion"
                                        VerticalAlignment="Center">
                                    <PathIcon Width="22" Height="22"
                                              Data="M12 2l-5.5 9h11L12 2zm5.5 11c-2.49 0-4.5 2.01-4.5 4.5S15.01 22 17.5 22s4.5-2.01 4.5-4.5-2.01-4.5-4.5-4.5zM3 21.5h8v-8H3v8z"/>
                                </Border>


                                <!-- Datos -->
                                <StackPanel Grid.Column="2"
                                            Spacing="6"
                                            VerticalAlignment="Center">

                                    <WrapPanel Orientation="Horizontal">

                                        <TextBlock Text="{Binding NombrePresentacion}"
                                                   Foreground="#0F172A"
                                                   FontSize="17"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>

                                        <Border IsVisible="{Binding EsBase}"
                                                Background="#EAF7EF"
                                                CornerRadius="999"
                                                Padding="9,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Base"
                                                       Foreground="#0B6B33"
                                                       FontSize="11"
                                                       FontWeight="Bold"/>
                                        </Border>

                                    </WrapPanel>

                                    <WrapPanel Orientation="Horizontal">

                                        <Border Classes="dato">
                                            <TextBlock Text="{Binding UnidadMedida}"
                                                       Foreground="#334155"
                                                       FontWeight="SemiBold"/>
                                        </Border>

                                        <Border Classes="dato">
                                            <TextBlock Text="{Binding FactorConversion, StringFormat='Factor {0}'}"
                                                       Foreground="#64748B"/>
                                        </Border>

                                        <Border Classes="dato"
                                                IsVisible="{Binding CodigoBarras, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <PathIcon Width="11" Height="11"
                                                          Foreground="#94A3B8"
                                                          Data="M2 6h2v12H2V6zm3 0h1v12H5V6zm2 0h3v12H7V6zm4 0h1v12h-1V6zm3 0h2v12h-2V6zm3 0h3v12h-3V6zm4 0h1v12h-1V6z"/>
                                                <TextBlock Text="{Binding CodigoBarras}"
                                                           Foreground="#64748B"/>
                                            </StackPanel>
                                        </Border>

                                    </WrapPanel>

                                </StackPanel>


                                <!-- Precio -->
                                <StackPanel Grid.Column="3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                            Spacing="2">

                                    <TextBlock Text="{Binding TextoPrecio}"
                                               Classes="precio"
                                               Classes.sinPrecio="{Binding !TienePrecioVisual}"
                                               HorizontalAlignment="Right"
                                               TextAlignment="Right"/>

                                    <TextBlock Text="Precio de venta"
                                               Foreground="#94A3B8"
                                               FontSize="11"
                                               HorizontalAlignment="Right"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </ScrollViewer>


        <!-- ===================================================== -->
        <!-- PARTE INFERIOR                                        -->
        <!-- ===================================================== -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#EAEEF2"
                BorderThickness="0,1,0,0"
                Padding="24,14,24,20">

            <StackPanel Spacing="12">


                <!-- ERROR -->

                <Border Padding="12,9"
                        CornerRadius="12"
                        Background="#FEF2F2"
                        BorderBrush="#FECACA"
                        BorderThickness="1"
                        IsVisible="{Binding MensajeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Width="16" Height="16"
                                  Foreground="#C61F2B"
                                  Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                        <TextBlock Text="{Binding MensajeError}"
                                   Foreground="#9F1239"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>


                <!-- PISTAS DE TECLADO -->

                <StackPanel Orientation="Horizontal"
                            Spacing="16"
                            HorizontalAlignment="Center">
                    <StackPanel Classes="atajo">
                        <Border Classes="tecla"><TextBlock Text="↑ ↓"/></Border>
                        <TextBlock Text="Elegir"/>
                    </StackPanel>
                    <StackPanel Classes="atajo">
                        <Border Classes="tecla"><TextBlock Text="Enter"/></Border>
                        <TextBlock Text="Agregar"/>
                    </StackPanel>
                    <StackPanel Classes="atajo">
                        <Border Classes="tecla"><TextBlock Text="Esc"/></Border>
                        <TextBlock Text="Cancelar"/>
                    </StackPanel>
                </StackPanel>


                <!-- BOTONES -->

                <Grid ColumnDefinitions="*,2*"
                      ColumnSpacing="12">

                    <Button Grid.Column="0"
                            Classes="cancelar"
                            IsCancel="True"
                            Click="Cancelar_Click">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <PathIcon Width="14" Height="14"
                                      Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                            <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Classes="agregar"
                            IsDefault="True"
                            Command="{Binding ConfirmarCommand}"
                            IsEnabled="{Binding PuedeAgregar}">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <PathIcon Width="18" Height="18"
                                      Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                            <TextBlock Text="Agregar a la venta" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </Grid>

            </StackPanel>

        </Border>

    </Grid>


    <!-- ========================================================= -->
    <!-- ESTILOS                                                   -->
    <!-- ========================================================= -->

    <Window.Styles>


        <!-- ===================================================== -->
        <!-- TARJETA DE PRESENTACIÓN                              -->
        <!-- ===================================================== -->

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style Selector="Border.presentacionCard">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E6EAEE"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="16,16,20,16"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BoxShadow" Value="0 1 2 0 #0A0F172A"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBoxItem:pointerover Border.presentacionCard">
            <Setter Property="BorderBrush" Value="#86D5A3"/>
            <Setter Property="BoxShadow" Value="0 10 22 -12 #3316A34A"/>
        </Style>

        <Style Selector="ListBoxItem:selected Border.presentacionCard">
            <Setter Property="BorderBrush" Value="#16A34A"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="#F3FBF6"/>
            <Setter Property="BoxShadow" Value="0 0 0 4 #2216A34A"/>
        </Style>

        <!-- Indicador tipo radio -->
        <Style Selector="Border.radio">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <Style Selector="PathIcon.marcaRadio">
            <Setter Property="IsVisible" Value="False"/>
        </Style>

        <Style Selector="ListBoxItem:selected Border.radio">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="BorderBrush" Value="#16A34A"/>
        </Style>

        <Style Selector="ListBoxItem:selected PathIcon.marcaRadio">
            <Setter Property="IsVisible" Value="True"/>
        </Style>

        <!-- Ícono de la presentación -->
        <Style Selector="Border.iconoPresentacion">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#F1F5F9"/>
        </Style>

        <Style Selector="Border.iconoPresentacion PathIcon">
            <Setter Property="Foreground" Value="#64748B"/>
        </Style>

        <Style Selector="ListBoxItem:selected Border.iconoPresentacion">
            <Setter Property="Background" Value="#16A34A"/>
        </Style>

        <Style Selector="ListBoxItem:selected Border.iconoPresentacion PathIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Datos -->
        <Style Selector="Border.dato">
            <Setter Property="Background" Value="#F4F6F8"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>

        <Style Selector="Border.dato TextBlock">
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Precio -->
        <Style Selector="TextBlock.precio">
            <Setter Property="Foreground" Value="#0B1220"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="LetterSpacing" Value="-0.4"/>
        </Style>

        <Style Selector="TextBlock.precio.sinPrecio">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LetterSpacing" Value="0"/>
        </Style>


        <!-- ===================================================== -->
        <!-- PISTAS DE TECLADO                                    -->
        <!-- ===================================================== -->

        <Style Selector="StackPanel.atajo">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Spacing" Value="6"/>
        </Style>

        <Style Selector="StackPanel.atajo > TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.tecla">
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#D5DCE4"/>
            <Setter Property="BorderThickness" Value="1,1,1,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.tecla TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>


        <!-- ===================================================== -->
        <!-- BOTONES                                              -->
        <!-- ===================================================== -->

        <Style Selector="Button.cancelar">
            <Setter Property="Height" Value="56"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#F5C2C2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#C61F2B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.cancelar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C61F2B"/>
            <Setter Property="BorderBrush" Value="#C61F2B"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.agregar">
            <Setter Property="Height" Value="56"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#22C55E"/>
                    <GradientStop Offset="1" Color="#0E9A46"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.agregar /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 10 24 -8 #8022C55E"/>
        </Style>

        <Style Selector="Button.agregar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#2BD268"/>
                    <GradientStop Offset="1" Color="#11A84E"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.agregar:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0B7A37"/>
        </Style>

        <Style Selector="Button.agregar:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#CFE9D8"/>
            <Setter Property="Foreground" Value="#F7FCF9"/>
            <Setter Property="BoxShadow" Value="none"/>
        </Style>

    </Window.Styles>

</Window>
