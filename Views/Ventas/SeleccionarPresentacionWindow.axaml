<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovaCoreESDM.ViewModels.Ventas"

        x:Class="NovaCoreESDM.Views.Ventas.SeleccionarPresentacionWindow"
        x:DataType="vm:SeleccionarPresentacionViewModel"

        Title="Seleccionar presentación"
        Icon="/Assets/Brand/esdm-app-icon.ico"

        Width="560"
        Height="480"

        MinWidth="440"
        MinHeight="400"

        CanResize="True"

        WindowStartupLocation="CenterOwner"

        Background="#F5F7FA">


    <!-- ========================================================= -->
    <!-- CONTENIDO GENERAL                                         -->
    <!-- ========================================================= -->

    <Grid Margin="24"
          RowDefinitions="Auto,*,Auto"
          RowSpacing="16">


        <!-- ===================================================== -->
        <!-- ENCABEZADO                                            -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="0"
                    Spacing="6">


            <TextBlock Text="Seleccionar presentación"
                       Foreground="#17365D"
                       FontSize="23"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>


            <TextBlock Text="{Binding Producto.NombreComercial}"
                       Foreground="#16803B"
                       FontSize="16"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       MaxLines="2"/>


            <TextBlock Text="Selecciona cómo se venderá este producto."
                       Foreground="#64748B"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,2,0,0"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- PRESENTACIONES                                        -->
        <!-- ===================================================== -->

        <Border Grid.Row="1"
                Background="Transparent">

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <ListBox ItemsSource="{Binding Presentaciones}"
                         SelectedItem="{Binding PresentacionSeleccionada}"
                         Background="Transparent"
                         BorderThickness="0">


                    <ListBox.ItemTemplate>

                        <DataTemplate x:DataType="vm:PresentacionVentaItem">


                            <!-- ================================================= -->
                            <!-- TARJETA DE PRESENTACIÓN                           -->
                            <!-- ================================================= -->

                            <Border Classes="presentacionCard">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="14">


                                    <!-- ================================================= -->
                                    <!-- DATOS                                             -->
                                    <!-- ================================================= -->

                                    <StackPanel Grid.Column="0"
                                                Spacing="5"
                                                VerticalAlignment="Center">


                                        <!-- ================================================= -->
                                        <!-- NOMBRE + BASE                                     -->
                                        <!-- ================================================= -->

                                        <WrapPanel Orientation="Horizontal">

                                            <TextBlock Text="{Binding NombrePresentacion}"
                                                       Foreground="#172033"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,0,8,4"/>


                                            <Border IsVisible="{Binding EsBase}"
                                                    Background="#EAF6EE"
                                                    CornerRadius="6"
                                                    Padding="7,3"
                                                    Margin="0,0,0,4"
                                                    VerticalAlignment="Center">

                                                <TextBlock Text="Base"
                                                           Foreground="#16803B"
                                                           FontSize="9"
                                                           FontWeight="SemiBold"/>

                                            </Border>

                                        </WrapPanel>


                                        <!-- ================================================= -->
                                        <!-- UNIDAD                                            -->
                                        <!-- ================================================= -->

                                        <TextBlock Text="{Binding UnidadMedida}"
                                                   Foreground="#64748B"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>


                                        <!-- ================================================= -->
                                        <!-- FACTOR                                            -->
                                        <!-- ================================================= -->

                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="5">

                                            <TextBlock Text="Factor:"
                                                       Foreground="#94A3B8"
                                                       FontSize="10"/>

                                            <TextBlock Text="{Binding FactorConversion}"
                                                       Foreground="#64748B"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"/>

                                        </StackPanel>

                                    </StackPanel>


                                    <!-- ================================================= -->
                                    <!-- PRECIO                                            -->
                                    <!-- ================================================= -->

                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Spacing="3"
                                                MinWidth="120">

                                        <TextBlock Text="{Binding TextoPrecio}"
                                                   Foreground="#17365D"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"
                                                   TextAlignment="Right"/>

                                        <TextBlock Text="Precio de venta"
                                                   Foreground="#94A3B8"
                                                   FontSize="9"
                                                   HorizontalAlignment="Right"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ListBox.ItemTemplate>

                </ListBox>

            </ScrollViewer>

        </Border>


        <!-- ===================================================== -->
        <!-- PARTE INFERIOR                                        -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="2"
                    Spacing="10">


            <!-- ================================================= -->
            <!-- ERROR                                             -->
            <!-- ================================================= -->

            <TextBlock Text="{Binding MensajeError}"
                       Foreground="#C61F2B"
                       FontSize="11"
                       MinHeight="16"
                       TextWrapping="Wrap"/>


            <!-- ================================================= -->
            <!-- BOTONES                                           -->
            <!-- ================================================= -->

            <Grid ColumnDefinitions="*,*"
                  ColumnSpacing="12">


                <!-- ================================================= -->
                <!-- CANCELAR                                          -->
                <!-- ================================================= -->

                <Button Grid.Column="0"
                        Content="Cancelar"
                        Click="Cancelar_Click"

                        Height="50"

                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"

                        Background="White"
                        Foreground="#C61F2B"

                        BorderBrush="#F3A7AD"
                        BorderThickness="1"

                        CornerRadius="10"

                        FontSize="13"
                        FontWeight="SemiBold"/>


                <!-- ================================================= -->
                <!-- AGREGAR                                           -->
                <!-- ================================================= -->

                <Button Grid.Column="1"
                        Content="Agregar"

                        Command="{Binding ConfirmarCommand}"
                        IsEnabled="{Binding PuedeAgregar}"

                        Height="50"

                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"

                        Background="#16A34A"
                        Foreground="White"

                        BorderThickness="0"

                        CornerRadius="10"

                        FontSize="13"
                        FontWeight="SemiBold"/>

            </Grid>

        </StackPanel>

    </Grid>


    <!-- ========================================================= -->
    <!-- ESTILOS                                                   -->
    <!-- ========================================================= -->

    <Window.Styles>


        <!-- ===================================================== -->
        <!-- TARJETA DE PRESENTACIÓN                              -->
        <!-- ===================================================== -->

        <Style Selector="Border.presentacionCard">

            <Setter Property="Background"
                    Value="White"/>

            <Setter Property="BorderBrush"
                    Value="#E2E8F0"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="CornerRadius"
                    Value="12"/>

            <Setter Property="Padding"
                    Value="15"/>

            <Setter Property="Margin"
                    Value="0,0,0,10"/>

        </Style>


        <!-- ===================================================== -->
        <!-- LISTBOX                                               -->
        <!-- ===================================================== -->

        <Style Selector="ListBoxItem">

            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Margin"
                    Value="0"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

        </Style>


        <!-- ===================================================== -->
        <!-- HOVER                                                 -->
        <!-- ===================================================== -->

        <Style Selector="ListBoxItem:pointerover Border.presentacionCard">

            <Setter Property="BorderBrush"
                    Value="#86C99A"/>

            <Setter Property="Background"
                    Value="#FBFDFC"/>

        </Style>


        <!-- ===================================================== -->
        <!-- SELECCIONADA                                          -->
        <!-- ===================================================== -->

        <Style Selector="ListBoxItem:selected Border.presentacionCard">

            <Setter Property="BorderBrush"
                    Value="#16A34A"/>

            <Setter Property="BorderThickness"
                    Value="2"/>

            <Setter Property="Background"
                    Value="#EAF6EE"/>

        </Style>

    </Window.Styles>

</Window>