<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        x:Class="NovaCoreESDM.Views.Ventas.CobroWindow"

        Title="Cobrar venta"

        Icon="/Assets/Brand/esdm-app-icon.ico"

        Width="820"
        Height="640"

        MinWidth="640"
        MinHeight="520"

        CanResize="True"

        WindowStartupLocation="CenterOwner"

        Background="#F3F6FA">


    <!-- ========================================================= -->
    <!-- CONTENEDOR GENERAL                                        -->
    <!-- ========================================================= -->

    <Border Margin="12"
            Padding="26"
            Background="White"
            CornerRadius="18">

        <!--
            Auto = encabezado
            Auto = total
            Auto = título métodos
            *    = métodos de pago -> zona flexible / scroll
            Auto = pie -> SIEMPRE visible
        -->

        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto"
              RowSpacing="18">


            <!-- ================================================= -->
            <!-- ENCABEZADO                                        -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Spacing="4">

                <TextBlock Text="Cobrar venta"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#0B3D6E"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Selecciona el método con el que se realizará el cobro"
                           FontSize="13"
                           Foreground="#5F7591"
                           TextWrapping="Wrap"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- TOTAL                                             -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="#4B36DD"
                    CornerRadius="15"
                    Padding="20">

                <Grid ColumnDefinitions="58,*,Auto"
                      ColumnSpacing="16">


                    <!-- ICONO -->

                    <Border Grid.Column="0"
                            Width="54"
                            Height="54"
                            Background="#25FFFFFF"
                            CornerRadius="13"
                            VerticalAlignment="Center">

                        <TextBlock Text="🛒"
                                   FontSize="26"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                    </Border>


                    <!-- INFORMACIÓN -->

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="3">

                        <TextBlock Text="Total a pagar"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#E8E7FF"/>

                        <TextBlock Text="Importe total de la venta actual"
                                   FontSize="10"
                                   Foreground="#CFCBFF"
                                   TextWrapping="Wrap"/>

                    </StackPanel>


                    <!-- TOTAL -->

                    <TextBlock Grid.Column="2"
                               x:Name="TextoTotal"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- TÍTULO MÉTODOS                                    -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="2"
                        Spacing="3">

                <TextBlock Text="Método de pago"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#17365D"/>

                <TextBlock Text="Selecciona una opción para continuar"
                           FontSize="11"
                           Foreground="#64748B"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- MÉTODOS DE PAGO                                   -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <Grid RowDefinitions="Auto,Auto"
                      ColumnDefinitions="*,*"
                      RowSpacing="14"
                      ColumnSpacing="14"
                      Margin="0,2,0,2">


                    <!-- ================================================= -->
                    <!-- EFECTIVO                                          -->
                    <!-- ================================================= -->

                    <Button Grid.Row="0"
                            Grid.Column="0"

                            Click="Efectivo_Click"

                            MinHeight="108"

                            Background="#F3FBF5"
                            Foreground="#16803B"

                            BorderBrush="#A9E3BA"
                            BorderThickness="1"

                            CornerRadius="14"

                            Padding="16"

                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">

                        <Grid ColumnDefinitions="52,*,38"
                              ColumnSpacing="12">


                            <Border Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    Background="#DDF5E5"
                                    CornerRadius="11"
                                    VerticalAlignment="Center">

                                <TextBlock Text="💵"
                                           FontSize="23"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4">

                                <TextBlock Text="Efectivo"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#16803B"/>

                                <TextBlock Text="Cobro directo en caja"
                                           FontSize="10"
                                           Foreground="#4F765C"
                                           TextWrapping="Wrap"/>

                            </StackPanel>


                            <Border Grid.Column="2"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="#DDF5E5"
                                    VerticalAlignment="Center">

                                <TextBlock Text="›"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Foreground="#16803B"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-3,0,0"/>

                            </Border>

                        </Grid>

                    </Button>


                    <!-- ================================================= -->
                    <!-- TARJETA / MERCADO PAGO                            -->
                    <!-- ================================================= -->

                    <Button Grid.Row="0"
                            Grid.Column="1"

                            Click="Tarjeta_Click"

                            MinHeight="108"

                            Background="#F4F8FF"
                            Foreground="#2563EB"

                            BorderBrush="#BFDBFE"
                            BorderThickness="1"

                            CornerRadius="14"

                            Padding="16"

                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">

                        <Grid ColumnDefinitions="52,*,38"
                              ColumnSpacing="12">


                            <Border Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    Background="#DBEAFE"
                                    CornerRadius="11"
                                    VerticalAlignment="Center">

                                <TextBlock Text="💳"
                                           FontSize="23"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4">

                                <TextBlock Text="Tarjeta"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#2563EB"/>

                                <TextBlock Text="Cobrar con terminal Mercado Pago"
                                           FontSize="10"
                                           Foreground="#5273A8"
                                           TextWrapping="Wrap"/>

                            </StackPanel>


                            <Border Grid.Column="2"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="#DBEAFE"
                                    VerticalAlignment="Center">

                                <TextBlock Text="›"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Foreground="#2563EB"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-3,0,0"/>

                            </Border>

                        </Grid>

                    </Button>


                        <!-- ================================================= -->
                        <!-- TRANSFERENCIA                                     -->
                        <!-- ================================================= -->

                        <Button Grid.Row="1"
                                Grid.Column="0"

                                Click="Transferencia_Click"

                                MinHeight="108"

                                Background="#F0FDFA"
                                Foreground="#0F766E"

                                BorderBrush="#99F6E4"
                                BorderThickness="1"

                                CornerRadius="14"

                                Padding="16"

                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">

                            <Grid ColumnDefinitions="52,*,38"
                                  ColumnSpacing="12">

                                <!-- ICONO -->

                                <Border Grid.Column="0"
                                        Width="48"
                                        Height="48"
                                        Background="#CCFBF1"
                                        CornerRadius="11"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="🏦"
                                               FontSize="23"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>


                                <!-- INFORMACIÓN -->

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="4">

                                    <TextBlock Text="Transferencia"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="#0F766E"/>

                                    <TextBlock Text="Pago mediante transferencia bancaria"
                                               FontSize="10"
                                               Foreground="#477C77"
                                               TextWrapping="Wrap"/>

                                </StackPanel>


                                <!-- FLECHA -->

                                <Border Grid.Column="2"
                                        Width="36"
                                        Height="36"
                                        CornerRadius="18"
                                        Background="#CCFBF1"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="›"
                                               FontSize="25"
                                               FontWeight="Bold"
                                               Foreground="#0F766E"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="0,-3,0,0"/>

                                </Border>

                            </Grid>

                        </Button>


                    <!-- ================================================= -->
                    <!-- CRÉDITO                                           -->
                    <!-- ================================================= -->

                    <Button Grid.Row="1"
                            Grid.Column="1"

                            Click="Credito_Click"

                            MinHeight="108"

                            Background="#F8F6FF"
                            Foreground="#4938D6"

                            BorderBrush="#CFC7FF"
                            BorderThickness="1"

                            CornerRadius="14"

                            Padding="16"

                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">

                        <Grid ColumnDefinitions="52,*,38"
                              ColumnSpacing="12">


                            <Border Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    Background="#EBE7FF"
                                    CornerRadius="11"
                                    VerticalAlignment="Center">

                                <TextBlock Text="📋"
                                           FontSize="23"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="4">

                                <TextBlock Text="Pagar con crédito"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#4938D6"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="Usar línea de crédito del cliente"
                                           FontSize="10"
                                           Foreground="#7065B5"
                                           TextWrapping="Wrap"/>

                            </StackPanel>


                            <Border Grid.Column="2"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="#EBE7FF"
                                    VerticalAlignment="Center">

                                <TextBlock Text="›"
                                           FontSize="25"
                                           FontWeight="Bold"
                                           Foreground="#4938D6"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,-3,0,0"/>

                            </Border>

                        </Grid>

                    </Button>

                </Grid>

            </ScrollViewer>


            <!-- ================================================= -->
            <!-- PIE                                               -->
            <!-- ================================================= -->

            <Grid Grid.Row="4"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="14">


                <!-- ================================================= -->
                <!-- CERRAR                                            -->
                <!-- ================================================= -->

                <Button Grid.Column="0"
                        Height="48"

                        MinWidth="135"

                        Content="✕   Cerrar"

                        Click="Cerrar_Click"

                        Background="White"
                        Foreground="#53657D"

                        BorderBrush="#BCC8D6"
                        BorderThickness="1"

                        CornerRadius="10"

                        FontSize="13"
                        FontWeight="SemiBold"

                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>


                <!-- ================================================= -->
                <!-- ESTADO                                            -->
                <!-- ================================================= -->

                <Border Grid.Column="1"
                        Height="48"

                        Background="#F2FBF4"
                        BorderBrush="#B8E8C3"
                        BorderThickness="1"

                        CornerRadius="10"
                        Padding="14,7">

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="9"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">

                        <Border Width="9"
                                Height="9"
                                CornerRadius="5"
                                Background="#16A34A"
                                VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1"
                                   Text="Sistema listo para cobrar"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#16803B"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>

                    </Grid>

                </Border>

            </Grid>

        </Grid>

    </Border>

</Window>

<!-- ================================================= -->