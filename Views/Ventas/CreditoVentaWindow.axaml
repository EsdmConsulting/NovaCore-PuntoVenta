<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        x:Class="NovaCoreESDM.Views.Ventas.CreditoVentaWindow"

        Title="Venta a crédito"

        Icon="/Assets/Brand/esdm-app-icon.ico"

        Width="940"
        Height="760"

        MinWidth="720"
        MinHeight="600"

        CanResize="True"

        WindowStartupLocation="CenterOwner"

        Background="#F3F6FA">


    <Border Margin="12"
            Padding="24"
            Background="White"
            CornerRadius="18">

        <!--
            Auto = encabezado
            Auto = cliente + total
            *    = contenido central con scroll
            Auto = botones siempre visibles
        -->

        <Grid RowDefinitions="Auto,Auto,*,Auto"
              RowSpacing="16">


            <!-- ================================================= -->
            <!-- ENCABEZADO                                        -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Spacing="4">

                <TextBlock Text="Venta a crédito"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#0B3D6E"
                           TextWrapping="Wrap"/>

                <TextBlock Text="Revisa la información antes de confirmar la operación"
                           FontSize="13"
                           Foreground="#5F7591"
                           TextWrapping="Wrap"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- CLIENTE + TOTAL                                   -->
            <!-- ================================================= -->

            <Grid Grid.Row="1"
                  ColumnDefinitions="1.2*,*"
                  ColumnSpacing="16">


                <!-- ================================================= -->
                <!-- CLIENTE                                           -->
                <!-- ================================================= -->

                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#D7E0EB"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="17">

                    <Grid ColumnDefinitions="56,*"
                          ColumnSpacing="14">

                        <Border Width="50"
                                Height="50"
                                Background="#EEF0FF"
                                CornerRadius="12"
                                VerticalAlignment="Center">

                            <TextBlock Text="👤"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel Grid.Column="1"
                                    Spacing="4"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Cliente"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#4338CA"/>

                            <TextBlock x:Name="TextoCliente"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#17253B"
                                       TextWrapping="Wrap"
                                       MaxLines="2"/>

                            <WrapPanel Orientation="Horizontal">

                                <TextBlock x:Name="TextoCodigoCliente"
                                           FontSize="10"
                                           Foreground="#64748B"
                                           Margin="0,0,8,0"/>

                                <TextBlock Text="•"
                                           Foreground="#94A3B8"
                                           Margin="0,0,8,0"/>

                                <TextBlock x:Name="TextoRfcCliente"
                                           FontSize="10"
                                           Foreground="#64748B"/>

                            </WrapPanel>

                        </StackPanel>

                    </Grid>

                </Border>


                <!-- ================================================= -->
                <!-- TOTAL                                             -->
                <!-- ================================================= -->

                <Border Grid.Column="1"
                        Background="#4B36DD"
                        CornerRadius="14"
                        Padding="18">

                    <Grid ColumnDefinitions="56,*"
                          ColumnSpacing="14">

                        <Border Width="50"
                                Height="50"
                                Background="#22FFFFFF"
                                CornerRadius="12"
                                VerticalAlignment="Center">

                            <TextBlock Text="🛒"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>


                        <StackPanel Grid.Column="1"
                                    Spacing="5"
                                    VerticalAlignment="Center">

                            <TextBlock Text="Total de la venta"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#E8E7FF"/>

                            <TextBlock x:Name="TextoTotalVenta"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Right"/>

                        </StackPanel>

                    </Grid>

                </Border>

            </Grid>


            <!-- ================================================= -->
            <!-- CONTENIDO CENTRAL                                 -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="16"
                            Margin="0,2,0,2">


                    <!-- ================================================= -->
                    <!-- ESTADO ACTUAL + PROYECCIÓN                        -->
                    <!-- ================================================= -->

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="16">


                        <!-- ================================================= -->
                        <!-- ESTADO ACTUAL                                     -->
                        <!-- ================================================= -->

                        <Border Grid.Column="0"
                                Background="White"
                                BorderBrush="#D7E0EB"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16">

                            <StackPanel Spacing="12">

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10">

                                    <Border Width="38"
                                            Height="38"
                                            Background="#E7F8EC"
                                            CornerRadius="9">

                                        <TextBlock Text="💳"
                                                   FontSize="19"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="Estado actual del crédito"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#17365D"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>

                                </Grid>


                                <Border Height="1"
                                        Background="#E5E7EB"/>


                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      RowSpacing="10">

                                    <TextBlock Grid.Row="0"
                                               Text="Límite de crédito"
                                               FontSize="11"
                                               Foreground="#64748B"/>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               x:Name="TextoLimiteCredito"
                                               FontWeight="Bold"
                                               Foreground="#17253B"/>


                                    <TextBlock Grid.Row="1"
                                               Text="Saldo utilizado"
                                               FontSize="11"
                                               Foreground="#64748B"/>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="1"
                                               x:Name="TextoSaldoDeudor"
                                               FontWeight="Bold"
                                               Foreground="#17253B"/>


                                    <Border Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Background="#EFFAF2"
                                            CornerRadius="9"
                                            Padding="10">

                                        <Grid ColumnDefinitions="*,Auto">

                                            <TextBlock Text="Disponible"
                                                       Foreground="#15803D"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Grid.Column="1"
                                                       x:Name="TextoDisponible"
                                                       Foreground="#15803D"
                                                       FontWeight="Bold"/>

                                        </Grid>

                                    </Border>

                                </Grid>

                            </StackPanel>

                        </Border>


                        <!-- ================================================= -->
                        <!-- PROYECCIÓN                                        -->
                        <!-- ================================================= -->

                        <Border Grid.Column="1"
                                Background="White"
                                BorderBrush="#D7E0EB"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16">

                            <StackPanel Spacing="12">

                                <Grid ColumnDefinitions="Auto,*"
                                      ColumnSpacing="10">

                                    <Border Width="38"
                                            Height="38"
                                            Background="#F0ECFF"
                                            CornerRadius="9">

                                        <TextBlock Text="📊"
                                                   FontSize="19"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="Después de esta venta"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#17365D"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"/>

                                </Grid>


                                <Border Height="1"
                                        Background="#E5E7EB"/>


                                <Grid RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      RowSpacing="10">

                                    <TextBlock Grid.Row="0"
                                               Text="Saldo proyectado"
                                               FontSize="11"
                                               Foreground="#64748B"/>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="1"
                                               x:Name="TextoSaldoProyectado"
                                               FontWeight="Bold"
                                               Foreground="#17253B"/>


                                    <Border Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            Background="#F6F4FF"
                                            BorderBrush="#D7D0FF"
                                            BorderThickness="1"
                                            CornerRadius="9"
                                            Padding="10">

                                        <Grid ColumnDefinitions="*,Auto">

                                            <TextBlock Text="Disponible proyectado"
                                                       Foreground="#4938D6"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Grid.Column="1"
                                                       x:Name="TextoDisponibleProyectado"
                                                       Foreground="#4938D6"
                                                       FontWeight="Bold"/>

                                        </Grid>

                                    </Border>

                                </Grid>

                            </StackPanel>

                        </Border>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- CONDICIONES                                       -->
                    <!-- ================================================= -->

                    <Border Background="#FBFCFE"
                            BorderBrush="#CFE0F3"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="16">

                        <StackPanel Spacing="12">

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10">

                                <Border Width="38"
                                        Height="38"
                                        Background="#E8F2FF"
                                        CornerRadius="9">

                                    <TextBlock Text="📅"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>

                                <TextBlock Grid.Column="1"
                                           Text="Condiciones y estatus del crédito"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="#17365D"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"/>

                            </Grid>


                            <!--
                                En vez de 5 columnas súper apretadas,
                                usamos 3 arriba y 2 abajo.
                            -->

                            <Grid ColumnDefinitions="*,*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="12">


                                <!-- PLAZO -->

                                <StackPanel Grid.Row="0"
                                            Grid.Column="0"
                                            HorizontalAlignment="Center"
                                            Spacing="3">

                                    <TextBlock Text="Plazo de crédito"
                                               FontSize="10"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>

                                    <TextBlock x:Name="TextoDiasCredito"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#17365D"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>


                                <!-- TOLERANCIA -->

                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            HorizontalAlignment="Center"
                                            Spacing="3">

                                    <TextBlock Text="Tolerancia"
                                               FontSize="10"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="TextoTolerancia"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#17365D"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>


                                <!-- INICIO -->

                                <StackPanel Grid.Row="0"
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            Spacing="3">

                                    <TextBlock Text="Fecha de inicio"
                                               FontSize="10"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="TextoFechaInicio"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#17365D"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>


                                <!-- VENCIMIENTO -->

                                <StackPanel Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            HorizontalAlignment="Center"
                                            Spacing="3">

                                    <TextBlock Text="Fecha de vencimiento"
                                               FontSize="10"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"/>

                                    <TextBlock x:Name="TextoFechaVencimiento"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#17365D"
                                               HorizontalAlignment="Center"/>

                                </StackPanel>


                                <!-- SEMÁFORO -->

                                <StackPanel Grid.Row="1"
                                            Grid.Column="2"
                                            HorizontalAlignment="Center"
                                            Spacing="4">

                                    <TextBlock Text="Semáforo"
                                               FontSize="10"
                                               Foreground="#64748B"
                                               HorizontalAlignment="Center"/>

                                    <Border x:Name="SemaforoBorder"
                                            Background="#EAF9EE"
                                            CornerRadius="12"
                                            Padding="12,5">

                                        <TextBlock x:Name="TextoSemaforo"
                                                   Foreground="#16803B"
                                                   FontWeight="Bold"
                                                   FontSize="11"/>

                                    </Border>

                                </StackPanel>

                            </Grid>

                        </StackPanel>

                    </Border>


                    <!-- ================================================= -->
                    <!-- AUTORIZADO                                        -->
                    <!-- ================================================= -->

                    <Border Background="#EFFAF2"
                            BorderBrush="#B8E8C3"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14">

                        <Grid ColumnDefinitions="42,*"
                              ColumnSpacing="10">

                            <TextBlock Text="✓"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#15803D"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1"
                                        Spacing="3"
                                        VerticalAlignment="Center">

                                <TextBlock Text="Crédito autorizado para esta venta"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="#15803D"
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="El cliente cuenta con disponibilidad suficiente para cubrir el monto de la venta."
                                           FontSize="10"
                                           Foreground="#476458"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                </StackPanel>

            </ScrollViewer>


            <!-- ================================================= -->
            <!-- BOTONES                                           -->
            <!-- ================================================= -->

            <Grid Grid.Row="3"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12">

                <Button Grid.Column="0"
                        Height="52"
                        Content="✕   Cancelar operación"
                        Click="Cancelar_Click"

                        Background="White"
                        Foreground="#53657D"

                        BorderBrush="#BCC8D6"
                        BorderThickness="1"

                        CornerRadius="10"

                        FontSize="13"
                        FontWeight="SemiBold"

                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>


                <Button Grid.Column="1"
                        Height="52"
                        Content="✓   Confirmar venta a crédito"
                        Click="Confirmar_Click"

                        Background="#4B36DD"
                        Foreground="White"

                        BorderThickness="0"

                        CornerRadius="10"

                        FontSize="13"
                        FontWeight="Bold"

                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"/>

            </Grid>

        </Grid>

    </Border>

</Window>