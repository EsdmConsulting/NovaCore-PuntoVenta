<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="NovaCoreESDM.Views.Ventas.EditarPesoWindow"
    Width="380"
    Height="280"
    WindowStartupLocation="CenterOwner"
    CanResize="False"
    Title="Editar peso">

    <Grid
        Margin="24"
        RowDefinitions="Auto,Auto,Auto,*">

        <TextBlock
            Grid.Row="0"
            Text="Editar peso"
            FontSize="22"
            FontWeight="SemiBold" />

        <TextBlock
            x:Name="TextoPesoActual"
            Grid.Row="1"
            Margin="0,14,0,8"
            FontSize="14" />

        <TextBox
            x:Name="PesoTextBox"
            Grid.Row="2"
            Height="44"
            FontSize="18"
            VerticalContentAlignment="Center"
            Watermark="Ej. 0.638" />

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Spacing="10"
            Margin="0,20,0,0">

            <Button
                Content="Cancelar"
                Width="100"
                Click="Cancelar_Click" />

            <Button
                Content="Aceptar"
                Width="100"
                Click="Aceptar_Click" />

        </StackPanel>

    </Grid>
</Window>