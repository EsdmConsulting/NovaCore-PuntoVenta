<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        x:Class="NovaCoreESDM.Views.Ventas.EntregaTicketWindow"

        Title="Entrega de ticket"

        Icon="/Assets/Brand/esdm-app-icon.ico"

        Width="560"
        Height="460"

        MinWidth="500"
        MinHeight="400"

        CanResize="True"

        WindowStartupLocation="CenterOwner"

        Background="#F6F8F7">


    <!-- ========================================================= -->
    <!-- CONTENEDOR GENERAL                                        -->
    <!-- ========================================================= -->

    <Border Background="White"
            Margin="12"
            Padding="24"
            CornerRadius="18">

        <Grid RowDefinitions="Auto,Auto,*"
              RowSpacing="16">


            <!-- ================================================= -->
            <!-- VENTA COMPLETADA                                  -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Spacing="7">


                <!-- ICONO -->

                <Border Width="54"
                        Height="54"
                        CornerRadius="27"
                        Background="#EAF7EF">

                    <TextBlock Text="✓"
                               Foreground="#16A34A"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <!-- TÍTULO -->

                <TextBlock Text="Venta completada"
                           Foreground="#21382A"
                           FontSize="22"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>


                <!-- SUBTÍTULO -->

                <TextBlock Text="Selecciona cómo deseas entregar el ticket al cliente."
                           Foreground="#718078"
                           FontSize="11"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- DATOS DEL TICKET                                  -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="#F8FAF9"
                    BorderBrush="#E4EAE6"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14">

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="18">


                    <!-- TICKET -->

                    <StackPanel Spacing="3">

                        <TextBlock Text="Ticket"
                                   Foreground="#94A39A"
                                   FontSize="9"/>

                        <TextBlock x:Name="FolioTicketTextBlock"
                                   Text="PV-001-B-00000001"
                                   Foreground="#08783D"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   TextTrimming="CharacterEllipsis"/>

                    </StackPanel>


                    <!-- TOTAL -->

                    <StackPanel Grid.Column="1"
                                Spacing="3"
                                HorizontalAlignment="Right">

                        <TextBlock Text="Total"
                                   Foreground="#94A39A"
                                   FontSize="9"
                                   HorizontalAlignment="Right"/>

                        <TextBlock x:Name="TotalTextBlock"
                                   Text="$0.00"
                                   Foreground="#21382A"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Right"/>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- OPCIONES                                          -->
            <!-- ================================================= -->

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <StackPanel Spacing="12"
                            Margin="0,2,0,0">


                    <!-- ================================================= -->
                    <!-- OPCIONES PRINCIPALES                              -->
                    <!-- ================================================= -->

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">


                        <!-- ================================================= -->
                        <!-- IMPRIMIR                                          -->
                        <!-- ================================================= -->

                        <Button Grid.Column="0"
                                Click="Imprimir_Click"

                                MinHeight="86"

                                Background="#EAF7EF"
                                Foreground="#08783D"

                                BorderBrush="#9BDCAF"
                                BorderThickness="1"

                                CornerRadius="14"

                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="12"
                                  Margin="14">


                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="12"
                                        Background="#D9F1E1"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="🖨"
                                               FontSize="21"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>


                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="3">

                                    <TextBlock Text="Imprimir ticket"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#08783D"/>

                                    <TextBlock Text="Enviar a la impresora"
                                               FontSize="9"
                                               Foreground="#5F816A"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                            </Grid>

                        </Button>


                        <!-- ================================================= -->
                        <!-- WHATSAPP                                          -->
                        <!-- ================================================= -->

                        <Button Grid.Column="1"
                                Click="WhatsApp_Click"

                                MinHeight="86"

                                Background="#F1F8F3"
                                Foreground="#16803B"

                                BorderBrush="#B7DFC3"
                                BorderThickness="1"

                                CornerRadius="14"

                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="12"
                                  Margin="14">


                                <Border Width="42"
                                        Height="42"
                                        CornerRadius="12"
                                        Background="#DDF5E5"
                                        VerticalAlignment="Center">

                                    <TextBlock Text="●"
                                               Foreground="#25D366"
                                               FontSize="21"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                </Border>


                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="3">

                                    <TextBlock Text="Enviar por WhatsApp"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#16803B"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="Compartir ticket al cliente"
                                               FontSize="9"
                                               Foreground="#6C8C75"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                            </Grid>

                        </Button>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- FINALIZAR SIN TICKET                              -->
                    <!-- ================================================= -->

                    <Button Click="SinTicket_Click"

                            MinHeight="64"

                            Background="White"
                            Foreground="#526158"

                            BorderBrush="#CBD5CE"
                            BorderThickness="1"

                            CornerRadius="12"

                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"

                            Padding="14,10">

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">


                            <!-- ICONO -->

                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="#F3F6F4"
                                    VerticalAlignment="Center">

                                <TextBlock Text="×"
                                           Foreground="#718078"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Border>


                            <!-- TEXTO -->

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="2">

                                <TextBlock Text="Finalizar sin ticket"
                                           Foreground="#526158"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>

                                <TextBlock Text="La venta permanecerá registrada aunque no se entregue un ticket."
                                           Foreground="#94A39A"
                                           FontSize="9"
                                           TextWrapping="Wrap"/>

                            </StackPanel>

                        </Grid>

                    </Button>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Border>

</Window>