<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        x:Class="NovaCoreESDM.Views.Ventas.CapturarPesoWindow"

        Title="Capturar peso"
        Icon="/Assets/Brand/esdm-app-icon.ico"

        Width="420"
        Height="370"

        MinWidth="360"
        MinHeight="320"

        CanResize="False"

        WindowStartupLocation="CenterOwner"

        Background="#F5F7FA">


    <!-- ========================================================= -->
    <!-- CONTENIDO                                                   -->
    <!-- ========================================================= -->

    <Grid Margin="28" RowDefinitions="Auto,*,Auto" RowSpacing="20">


        <!-- ===================================================== -->
        <!-- ENCABEZADO                                             -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="0" Spacing="4">

            <TextBlock x:Name="TituloTextBlock"
                       Text="Capturar peso"
                       Foreground="#17365D"
                       FontSize="22"
                       FontWeight="SemiBold"/>

            <TextBlock x:Name="NombreProductoTextBlock"
                       Foreground="#16803B"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       MaxLines="2"/>

            <TextBlock x:Name="UnidadTextBlock"
                       Foreground="#64748B"
                       FontSize="11"
                       Margin="0,2,0,0"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- ZONA CENTRAL: ENTRADA + RESULTADO                      -->
        <!-- ===================================================== -->

        <StackPanel Grid.Row="1" Spacing="16" VerticalAlignment="Center">

            <!-- LABEL -->
            <TextBlock x:Name="LabelPesoTextBlock"
                       Text="Peso (kg):"
                       Foreground="#374151"
                       FontSize="13"
                       FontWeight="SemiBold"/>

            <!-- INPUT DE PESO -->
            <TextBox x:Name="PesoTextBox"
                     Watermark="0.000"
                     HorizontalContentAlignment="Center"
                     FontSize="26"
                     FontWeight="Bold"
                     Foreground="#17365D"
                     Height="60"
                     CornerRadius="12"
                     BorderBrush="#CBD5E1"
                     BorderThickness="2"
                     TextChanged="PesoTextBox_TextChanged"
                     KeyDown="PesoTextBox_KeyDown"/>

            <!-- RESULTADO EN TIEMPO REAL -->
            <Border Background="#EAF6EE"
                    CornerRadius="10"
                    Padding="16,12">

                <Grid ColumnDefinitions="*,Auto">

                    <TextBlock Grid.Column="0"
                               Text="Importe calculado:"
                               Foreground="#374151"
                               FontSize="13"
                               VerticalAlignment="Center"/>

                    <TextBlock Grid.Column="1"
                               x:Name="ImporteTextBlock"
                               Text="$0.00"
                               Foreground="#16803B"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>

                </Grid>

            </Border>

            <!-- DETALLE PRECIO/KG -->
            <TextBlock x:Name="DetallePrecioTextBlock"
                       Foreground="#94A3B8"
                       FontSize="11"
                       HorizontalAlignment="Center"/>

        </StackPanel>


        <!-- ===================================================== -->
        <!-- BOTONES                                                 -->
        <!-- ===================================================== -->

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">

            <Button Grid.Column="0"
                    Content="Cancelar"
                    Click="Cancelar_Click"
                    Height="50"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="White"
                    Foreground="#C61F2B"
                    BorderBrush="#F3A7AD"
                    BorderThickness="1"
                    CornerRadius="10"
                    FontSize="13"
                    FontWeight="SemiBold"/>

            <Button Grid.Column="1"
                    x:Name="AgregarButton"
                    Content="Agregar al carrito"
                    Click="Agregar_Click"
                    IsEnabled="False"
                    Height="50"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#16A34A"
                    Foreground="White"
                    BorderThickness="0"
                    CornerRadius="10"
                    FontSize="13"
                    FontWeight="SemiBold"/>

        </Grid>

    </Grid>

</Window>

