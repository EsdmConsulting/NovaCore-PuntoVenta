<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovaCoreESDM.ViewModels"

        x:Class="NovaCoreESDM.Views.MainWindow"
        x:DataType="vm:MainViewModel"

        Title="Grupo Luis Fer - Punto de Venta"
        Icon="/Assets/Brand/esdm-app-icon-2.ico"

        Width="1380"
        Height="820"

        MinWidth="1100"
        MinHeight="680"

        WindowStartupLocation="CenterScreen"

        Background="#F6F8F7">


    <Grid ColumnDefinitions="220,*">


        <!-- ===================================================== -->
        <!-- SIDEBAR                                               -->
        <!-- ===================================================== -->

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E4EAE6"
                BorderThickness="0,0,1,0">

            <Grid RowDefinitions="Auto,*,Auto">


                <!-- ================================================= -->
                <!-- IDENTIDAD                                          -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="0"
                            Margin="16,18,16,14"
                            Spacing="9">

                    <Image Source="avares://NovaCoreESDM/Assets/logo_grupo_luisfer.png"
                           Width="154"
                           Height="90"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"/>

                    <TextBlock Text="PUNTO DE VENTA"
                               Foreground="#08783D"
                               FontSize="12"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                    <Border Height="1"
                            Margin="6,7,6,0"
                            Background="#E4EAE6"/>

                </StackPanel>


                <!-- ================================================= -->
                <!-- NAVEGACIÓN                                         -->
                <!-- ================================================= -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="12,8"
                                Spacing="6">

                        <TextBlock Text="OPERACIÓN"
                                   Foreground="#94A39A"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="12,0,0,4"/>


                        <!-- ================================================= -->
                        <!-- NUEVA VENTA                                       -->
                        <!-- ================================================= -->

                        <Button Classes="newSaleButton"
                                Classes.active="{Binding EsNuevaVenta}"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="NuevaVenta">

                            <Grid ColumnDefinitions="30,*">

                                <TextBlock Text="+"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="Nueva venta"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>

                            </Grid>

                        </Button>


                        <!-- ================================================= -->
                        <!-- RESUMEN                                           -->
                        <!-- ================================================= -->

                        <Button Classes="menuItem"
                                Classes.active="{Binding EsInicio}"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="Inicio">

                            <Grid ColumnDefinitions="30,*">

                                <TextBlock Text="⌂"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="Resumen"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Button>


                        <!-- ================================================= -->
                        <!-- PAGAR CRÉDITO                                     -->
                        <!-- ================================================= -->

                        <Button Classes="menuItem"
                                Classes.active="{Binding EsPagoCredito}"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="PagoCredito">

                            <Grid ColumnDefinitions="30,*">

                                <TextBlock Text="$"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="Pagar crédito"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>

                            </Grid>

                        </Button>


                        <!-- ================================================= -->
                        <!-- CORTES                                            -->
                        <!-- ================================================= -->

                        <Button Classes="menuItem"
                                Classes.active="{Binding EsCortes}"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="Cortes">

                            <Grid ColumnDefinitions="30,*">

                                <TextBlock Text="▥"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1"
                                           Text="Cortes y reportes"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Button>

                    </StackPanel>

                </ScrollViewer>


                <!-- ================================================= -->
                <!-- PARTE INFERIOR DEL MENÚ                            -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="2"
                            Margin="12,0,12,14"
                            Spacing="8">


                    <!-- SEPARADOR -->

                    <Border Height="1"
                            Margin="8,0,8,4"
                            Background="#E4EAE6"/>


                    <!-- ================================================= -->
                    <!-- CERRAR SESIÓN                                      -->
                    <!-- ================================================= -->

                    <Button Classes="logoutButton"
                            Click="CerrarSesion_Click">

                            <Grid ColumnDefinitions="28,*"
                                  ColumnSpacing="8">

                                    <TextBlock Text="↪"
                                               Foreground="White"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1"
                                               Text="Cerrar sesión"
                                               Foreground="White"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                            </Grid>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- ÁREA PRINCIPAL                                        -->
        <!-- ===================================================== -->

        <Grid Grid.Column="1"
              RowDefinitions="70,*">


            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E4EAE6"
                    BorderThickness="0,0,0,1">

                <Grid Margin="26,0"
                      ColumnDefinitions="*,Auto">


                    <!-- ================================================= -->
                    <!-- TITULO                                             -->
                    <!-- ================================================= -->

                    <StackPanel VerticalAlignment="Center"
                                Spacing="2">

                        <TextBlock Text="{Binding TituloPagina}"
                                   Foreground="#21382A"
                                   FontSize="21"
                                   FontWeight="SemiBold"/>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="7">

                            <TextBlock Text="{Binding SubtituloPagina}"
                                       Foreground="#718078"
                                       FontSize="11"/>

                            <TextBlock Text="•"
                                       Foreground="#CBD5CE"
                                       FontSize="11"/>

                            <TextBlock Text="{Binding FechaActual}"
                                       Foreground="#94A39A"
                                       FontSize="11"/>

                        </StackPanel>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- POS / USUARIO                                     -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="18"
                                VerticalAlignment="Center">


                        <!-- SUCURSAL -->

                        <StackPanel VerticalAlignment="Center"
                                    Spacing="1">

                            <TextBlock Text="{Binding NombreSucursal}"
                                       Foreground="#08783D"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Punto de Venta"
                                       Foreground="#94A39A"
                                       FontSize="9"
                                       HorizontalAlignment="Right"/>

                        </StackPanel>


                        <Border Width="1"
                                Height="30"
                                Background="#E4EAE6"/>


                        <!-- USUARIO -->

                        <StackPanel VerticalAlignment="Center"
                                    Spacing="1">

                            <TextBlock Text="{Binding NombreUsuario}"
                                       Foreground="#26372C"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Usuario activo"
                                       Foreground="#94A39A"
                                       FontSize="9"
                                       HorizontalAlignment="Right"/>

                        </StackPanel>


                        <!-- AVATAR -->

                        <Border Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="#16A34A">

                            <TextBlock Text="A"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- CONTENIDO                                         -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="#F6F8F7">

                <ContentControl Content="{Binding VistaActual}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>

            </Border>

        </Grid>

    </Grid>


    <!-- ========================================================= -->
    <!-- ESTILOS                                                   -->
    <!-- ========================================================= -->

    <Window.Styles>


        <!-- ===================================================== -->
        <!-- NUEVA VENTA                                          -->
        <!-- ===================================================== -->

        <Style Selector="Button.newSaleButton">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Margin"
                    Value="0,3,0,7"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="#16A34A"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="FontSize"
                    Value="12"/>

        </Style>


        <Style Selector="Button.newSaleButton:pointerover">

            <Setter Property="Background"
                    Value="#15803D"/>

        </Style>


        <Style Selector="Button.newSaleButton:pressed">

            <Setter Property="Background"
                    Value="#166534"/>

        </Style>


        <!-- ===================================================== -->
        <!-- MENÚ NORMAL                                          -->
        <!-- ===================================================== -->

        <Style Selector="Button.menuItem">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Margin"
                    Value="0,1"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#526158"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="CornerRadius"
                    Value="9"/>

            <Setter Property="FontSize"
                    Value="12"/>

        </Style>


        <!-- Hover -->

        <Style Selector="Button.menuItem:pointerover">

            <Setter Property="Background"
                    Value="#F1F7F3"/>

            <Setter Property="Foreground"
                    Value="#08783D"/>

        </Style>


        <!-- Presionado -->

        <Style Selector="Button.menuItem:pressed">

            <Setter Property="Background"
                    Value="#E6F2E9"/>

        </Style>


        <!-- Activo -->

        <Style Selector="Button.menuItem.active">

            <Setter Property="Background"
                    Value="#EAF7EF"/>

            <Setter Property="Foreground"
                    Value="#08783D"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>


        <!-- ===================================================== -->
        <!-- CERRAR SESIÓN                                         -->
        <!-- ===================================================== -->

        <Style Selector="Button.logoutButton">

                <Setter Property="Height"
                        Value="44"/>

                <Setter Property="Padding"
                        Value="12,0"/>

                <Setter Property="HorizontalAlignment"
                        Value="Stretch"/>

                <Setter Property="HorizontalContentAlignment"
                        Value="Stretch"/>

                <Setter Property="VerticalContentAlignment"
                        Value="Center"/>

                <Setter Property="Background"
                        Value="#C61F2B"/>

                <Setter Property="Foreground"
                        Value="White"/>

                <Setter Property="BorderThickness"
                        Value="0"/>

                <Setter Property="CornerRadius"
                        Value="10"/>

                <Setter Property="FontSize"
                        Value="11"/>

        </Style>


        <Style Selector="Button.logoutButton:pointerover">

                <Setter Property="Background"
                        Value="#A91D26"/>

        </Style>


        <Style Selector="Button.logoutButton:pressed">

                <Setter Property="Background"
                        Value="#8F1720"/>

        </Style>

    </Window.Styles>

</Window>