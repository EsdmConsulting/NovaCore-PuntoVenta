<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NovaCoreESDM.ViewModels"

        x:Class="NovaCoreESDM.Views.MainWindow"
        x:DataType="vm:MainViewModel"

        Title="Grupo Luis Fer - Punto de Venta"
        Icon="/Assets/Brand/esdm-app-icon-2.ico"

        Width="1380"
        Height="820"

        MinWidth="1000"
        MinHeight="650"

        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"

        Background="#F6F8F7">


    <!-- ========================================================= -->
    <!-- LAYOUT PRINCIPAL                                          -->
    <!-- ========================================================= -->

    <Grid x:Name="MainLayout">

        <Grid.ColumnDefinitions>

            <ColumnDefinition Width="220"/>

            <ColumnDefinition Width="*"/>

        </Grid.ColumnDefinitions>


        <!-- ===================================================== -->
        <!-- SIDEBAR                                               -->
        <!-- ===================================================== -->

        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E4EAE6"
                BorderThickness="0,0,1,0">

            <Grid RowDefinitions="Auto,*,Auto">


                <!-- ================================================= -->
                <!-- IDENTIDAD                                         -->
                <!-- ================================================= -->

                <Grid Grid.Row="0"
                      Margin="8,14,8,10"
                      RowDefinitions="Auto,Auto">


                    <!-- ================================================= -->
                    <!-- BOTÓN COLAPSAR                                    -->
                    <!-- ================================================= -->

                    <Button x:Name="ToggleSidebarButton"
                            Grid.Row="0"
                            Width="38"
                            Height="38"
                            HorizontalAlignment="Right"
                            Margin="0,0,2,8"

                            Click="ToggleSidebar_Click"

                            Background="#F1F7F3"
                            Foreground="#08783D"

                            BorderThickness="0"
                            CornerRadius="9"

                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"

                            FontSize="18"
                            FontWeight="SemiBold"

                            Content="‹"/>


                    <!-- ================================================= -->
                    <!-- IDENTIDAD EXPANDIDA                               -->
                    <!-- ================================================= -->

                    <StackPanel x:Name="IdentidadExpandida"
                                Grid.Row="1"
                                Spacing="8">

                        <Image Source="avares://NovaCoreESDM/Assets/logo_grupo_luisfer.png"
                               Width="154"
                               Height="90"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"/>

                        <TextBlock Text="PUNTO DE VENTA"
                                   Foreground="#08783D"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"/>

                        <Border Height="1"
                                Margin="6,7,6,0"
                                Background="#E4EAE6"/>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- IDENTIDAD COLAPSADA                               -->
                    <!-- ================================================= -->

                    <StackPanel x:Name="IdentidadColapsada"
                                Grid.Row="1"
                                IsVisible="False"
                                Spacing="7">

                        <Image Source="avares://NovaCoreESDM/Assets/logo_grupo_luisfer.png"
                               Width="48"
                               Height="48"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"/>

                        <Border Height="1"
                                Margin="5,4,5,0"
                                Background="#E4EAE6"/>

                    </StackPanel>

                </Grid>


                <!-- ================================================= -->
                <!-- NAVEGACIÓN                                       -->
                <!-- ================================================= -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="12,8"
                                Spacing="6">


                        <!-- ================================================= -->
                        <!-- TÍTULO OPERACIÓN                                  -->
                        <!-- ================================================= -->

                        <TextBlock x:Name="OperacionTextBlock"
                                   Text="OPERACIÓN"
                                   Foreground="#94A39A"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Margin="12,0,0,4"/>


                        <!-- ================================================= -->
                        <!-- NUEVA VENTA                                       -->
                        <!-- ================================================= -->

                        <Button Classes="newSaleButton"
                                Classes.active="{Binding EsNuevaVenta}"

                                Command="{Binding NavegarCommand}"
                                CommandParameter="NuevaVenta"

                                Click="NuevaVenta_Click">

                            <Grid ColumnDefinitions="30,*">

                                <TextBlock Text="+"
                                           FontSize="21"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="NuevaVentaText"
                                           Grid.Column="1"
                                           Text="Nueva venta"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>

                            </Grid>

                        </Button>


                        <!-- ================================================= -->
                        <!-- RESUMEN                                           -->
                        <!-- ================================================= -->

                        <Button Classes="menuItem"
                                Classes.active="{Binding EsInicio}"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="Inicio">

                            <Grid ColumnDefinitions="30,*">

                                <TextBlock Text="⌂"
                                           FontSize="17"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="ResumenText"
                                           Grid.Column="1"
                                           Text="Resumen"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Button>


                        <!-- ================================================= -->
                        <!-- PAGAR CRÉDITO                                     -->
                        <!-- ================================================= -->

                        <Button Classes="menuItem"
                                Classes.active="{Binding EsPagoCredito}"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="PagoCredito">

                            <Grid ColumnDefinitions="30,*">

                                <TextBlock Text="$"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="PagarCreditoText"
                                           Grid.Column="1"
                                           Text="Pagar crédito"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>

                            </Grid>

                        </Button>


                        <!-- ================================================= -->
                        <!-- CORTES                                            -->
                        <!-- ================================================= -->

                        <Button Classes="menuItem"
                                Classes.active="{Binding EsCortes}"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="Cortes">

                            <Grid ColumnDefinitions="30,*">

                                <TextBlock Text="▥"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="CortesText"
                                           Grid.Column="1"
                                           Text="Cortes y reportes"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Button>


                        <!-- ================================================= -->
                        <!-- CANCELAR VENTAS                                   -->
                        <!-- ================================================= -->

                        <Button Classes="menuItem"
                                Classes.active="{Binding EsCancelaciones}"
                                Command="{Binding NavegarCommand}"
                                CommandParameter="Cancelaciones">

                            <Grid ColumnDefinitions="30,*">

                                <TextBlock Text="×"
                                           FontSize="19"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBlock x:Name="CancelarVentasText"
                                           Grid.Column="1"
                                           Text="Cancelar ventas"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"/>

                            </Grid>

                        </Button>

                    </StackPanel>

                </ScrollViewer>


                <!-- ================================================= -->
                <!-- PARTE INFERIOR DEL MENÚ                          -->
                <!-- ================================================= -->

                <StackPanel Grid.Row="2"
                            Margin="12,0,12,14"
                            Spacing="8">



                        <Button x:Name="CambiarCajaButton"
                                Classes="CambiarCaja"
                                Click="CambiarCaja_Click">

                                <Grid ColumnDefinitions="28,*"
                                        ColumnSpacing="8">

                                        <TextBlock Text="⇄"
                                                Foreground="White"
                                                FontSize="16"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"/>

                                        <TextBlock x:Name="CambiarCajaText"
                                                Grid.Column="1"
                                                Text="Cambiar caja"
                                                Foreground="White"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis"/>

                                </Grid>

                        </Button>


                    <Border Height="1"
                            Margin="8,0,8,4"
                            Background="#E4EAE6"/>


                    <!-- ================================================= -->
                    <!-- CERRAR SESIÓN                                      -->
                    <!-- ================================================= -->

                    <Button Classes="logoutButton"
                            Click="CerrarSesion_Click">

                        <Grid ColumnDefinitions="28,*"
                              ColumnSpacing="8">

                            <TextBlock Text="↪"
                                       Foreground="White"
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <TextBlock x:Name="CerrarSesionText"
                                       Grid.Column="1"
                                       Text="Cerrar sesión"
                                       Foreground="White"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>

                        </Grid>

                    </Button>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ===================================================== -->
        <!-- ÁREA PRINCIPAL                                        -->
        <!-- ===================================================== -->

        <Grid Grid.Column="1"
              RowDefinitions="70,*">


            <!-- ================================================= -->
            <!-- HEADER                                            -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E4EAE6"
                    BorderThickness="0,0,0,1">

                <Grid Margin="24,0"
                      ColumnDefinitions="*,Auto">


                    <!-- ================================================= -->
                    <!-- TÍTULO                                             -->
                    <!-- ================================================= -->

                    <StackPanel VerticalAlignment="Center"
                                Spacing="2">

                        <TextBlock Text="{Binding TituloPagina}"
                                   Foreground="#21382A"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"/>

                        <StackPanel Orientation="Horizontal"
                                    Spacing="7">

                            <TextBlock Text="{Binding SubtituloPagina}"
                                       Foreground="#718078"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock Text="•"
                                       Foreground="#CBD5CE"
                                       FontSize="11"/>

                            <TextBlock Text="{Binding FechaActual}"
                                       Foreground="#94A39A"
                                       FontSize="11"/>

                        </StackPanel>

                    </StackPanel>


                    <!-- ================================================= -->
                    <!-- POS / USUARIO                                     -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="16"
                                VerticalAlignment="Center">


                        <!-- ================================================= -->
                        <!-- SUCURSAL                                          -->
                        <!-- ================================================= -->

                        <StackPanel VerticalAlignment="Center"
                                    Spacing="1">

                            <TextBlock Text="{Binding NombreSucursal}"
                                       Foreground="#08783D"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Punto de Venta"
                                       Foreground="#94A39A"
                                       FontSize="9"
                                       HorizontalAlignment="Right"/>

                        </StackPanel>


                        <Border Width="1"
                                Height="30"
                                Background="#E4EAE6"/>


                        <!-- ================================================= -->
                        <!-- USUARIO                                           -->
                        <!-- ================================================= -->

                        <StackPanel VerticalAlignment="Center"
                                    Spacing="1">

                            <TextBlock Text="{Binding NombreUsuario}"
                                       Foreground="#26372C"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Right"/>

                            <TextBlock Text="Usuario activo"
                                       Foreground="#94A39A"
                                       FontSize="9"
                                       HorizontalAlignment="Right"/>

                        </StackPanel>


                        <!-- ================================================= -->
                        <!-- AVATAR                                            -->
                        <!-- ================================================= -->

                        <Border Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="#16A34A">

                            <TextBlock Text="A"
                                       Foreground="White"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Border>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- CONTENIDO                                         -->
            <!-- ================================================= -->

            <Border Grid.Row="1"
                    Background="#F6F8F7">

                <ContentControl Content="{Binding VistaActual}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"/>

            </Border>

        </Grid>

    </Grid>


    <!-- ========================================================= -->
    <!-- ESTILOS                                                   -->
    <!-- ========================================================= -->

    <Window.Styles>


        <!-- ===================================================== -->
        <!-- BOTÓN COLAPSAR                                       -->
        <!-- ===================================================== -->

        <Style Selector="Button#ToggleSidebarButton:pointerover">

            <Setter Property="Background"
                    Value="#E5F3EA"/>

        </Style>


        <Style Selector="Button#ToggleSidebarButton:pressed">

            <Setter Property="Background"
                    Value="#D5EBDD"/>

        </Style>


        <!-- ===================================================== -->
        <!-- NUEVA VENTA                                          -->
        <!-- ===================================================== -->

        <Style Selector="Button.newSaleButton">

            <Setter Property="Height"
                    Value="48"/>

            <Setter Property="Margin"
                    Value="0,3,0,7"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="#16A34A"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="FontSize"
                    Value="12"/>

        </Style>


        <Style Selector="Button.newSaleButton:pointerover">

            <Setter Property="Background"
                    Value="#15803D"/>

        </Style>


        <Style Selector="Button.newSaleButton:pressed">

            <Setter Property="Background"
                    Value="#166534"/>

        </Style>


        <!-- ===================================================== -->
        <!-- MENÚ NORMAL                                          -->
        <!-- ===================================================== -->

        <Style Selector="Button.menuItem">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Margin"
                    Value="0,1"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="Transparent"/>

            <Setter Property="Foreground"
                    Value="#526158"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="CornerRadius"
                    Value="9"/>

            <Setter Property="FontSize"
                    Value="12"/>

        </Style>


        <Style Selector="Button.menuItem:pointerover">

            <Setter Property="Background"
                    Value="#F1F7F3"/>

            <Setter Property="Foreground"
                    Value="#08783D"/>

        </Style>


        <Style Selector="Button.menuItem:pressed">

            <Setter Property="Background"
                    Value="#E6F2E9"/>

        </Style>


        <Style Selector="Button.menuItem.active">

            <Setter Property="Background"
                    Value="#EAF7EF"/>

            <Setter Property="Foreground"
                    Value="#08783D"/>

            <Setter Property="FontWeight"
                    Value="SemiBold"/>

        </Style>

        <!-- ===================================================== -->
        <!-- CAMBIAR CAJA                                          -->
        <!-- ===================================================== -->

        <Style Selector="Button.CambiarCaja">

        <Setter Property="Height"
                Value="44"/>

        <Setter Property="Padding"
                Value="12,0"/>

        <Setter Property="HorizontalAlignment"
                Value="Stretch"/>

        <Setter Property="HorizontalContentAlignment"
                Value="Stretch"/>

        <Setter Property="VerticalContentAlignment"
                Value="Center"/>

        <Setter Property="Background"
                Value="#0F766E"/>

        <Setter Property="Foreground"
                Value="White"/>

        <Setter Property="BorderThickness"
                Value="0"/>

        <Setter Property="CornerRadius"
                Value="10"/>

        <Setter Property="FontSize"
                Value="11"/>

        </Style>

        <Style Selector="Button.CambiarCaja:pointerover">

        <Setter Property="Background"
                Value="#0D5F5A"/>

        </Style>

        <Style Selector="Button.CambiarCaja:pressed">

        <Setter Property="Background"
                Value="#0A4A46"/>

        </Style>


        <!-- ===================================================== -->
        <!-- CERRAR SESIÓN                                         -->
        <!-- ===================================================== -->

        <Style Selector="Button.logoutButton">

            <Setter Property="Height"
                    Value="44"/>

            <Setter Property="Padding"
                    Value="12,0"/>

            <Setter Property="HorizontalAlignment"
                    Value="Stretch"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="Background"
                    Value="#C61F2B"/>

            <Setter Property="Foreground"
                    Value="White"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="CornerRadius"
                    Value="10"/>

            <Setter Property="FontSize"
                    Value="11"/>

        </Style>


        <Style Selector="Button.logoutButton:pointerover">

            <Setter Property="Background"
                    Value="#A91D26"/>

        </Style>


        <Style Selector="Button.logoutButton:pressed">

            <Setter Property="Background"
                    Value="#8F1720"/>

        </Style>

    </Window.Styles>

</Window>