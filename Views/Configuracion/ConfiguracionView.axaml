<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NovaCoreESDM.ViewModels.Configuracion"
    xmlns:controls="using:NovaCoreESDM.Controls"
    xmlns:cfg="using:NovaCoreESDM.Models.Configuration"

    x:Class="NovaCoreESDM.Views.Configuracion.ConfiguracionView"
    x:DataType="vm:ConfiguracionViewModel"

    Background="#F4F6F8">


    <!-- ========================================================= -->
    <!-- ESTILOS                                                   -->
    <!-- ========================================================= -->

    <UserControl.Styles>

        <Style Selector="Border.seccion">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EAEEF2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BoxShadow" Value="0 1 2 0 #0A0F172A"/>
        </Style>

        <Style Selector="TextBlock.tituloSeccion">
            <Setter Property="Foreground" Value="#0B1220"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBlock.subtituloSeccion">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="17"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Pasos de la guía -->
        <Style Selector="Border.paso">
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#F8FAFB"/>
            <Setter Property="BorderBrush" Value="#EEF1F4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style Selector="Border.numeroPaso">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style Selector="Border.numeroPaso TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBlock.tituloPaso">
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBlock.detallePaso">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Botones -->
        <Style Selector="Button.boton">
            <Setter Property="Height" Value="50"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.verde">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#22C55E"/>
                    <GradientStop Offset="1" Color="#0E9A46"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Button.verde /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BoxShadow" Value="0 8 20 -8 #8022C55E"/>
        </Style>

        <Style Selector="Button.verde:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#16A34A"/>
        </Style>

        <Style Selector="Button.gris">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#334155"/>
        </Style>

        <Style Selector="Button.gris:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style Selector="Button.rojo">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#F5C2C2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#C61F2B"/>
        </Style>

        <Style Selector="Button.rojo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C61F2B"/>
            <Setter Property="BorderBrush" Value="#C61F2B"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Estado de la impresora (verde si está lista, ámbar si no se encuentra) -->
        <Style Selector="Border.estadoImpresora">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Background" Value="#FFF7E0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style Selector="Border.estadoImpresora TextBlock">
            <Setter Property="Foreground" Value="#92600A"/>
        </Style>

        <Style Selector="Border.estadoImpresora Ellipse">
            <Setter Property="Fill" Value="#F59E0B"/>
        </Style>

        <Style Selector="Border.estadoImpresora.ok">
            <Setter Property="Background" Value="#EAF7EF"/>
        </Style>

        <Style Selector="Border.estadoImpresora.ok TextBlock">
            <Setter Property="Foreground" Value="#0B6B33"/>
        </Style>

        <Style Selector="Border.estadoImpresora.ok Ellipse">
            <Setter Property="Fill" Value="#16A34A"/>
        </Style>

        <Style Selector="Border.iconoImpresora">
            <Setter Property="Background" Value="#FEF3C7"/>
        </Style>

        <Style Selector="Border.iconoImpresora PathIcon">
            <Setter Property="Foreground" Value="#B7791F"/>
        </Style>

        <Style Selector="Border.iconoImpresora.ok">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#22C55E"/>
                    <GradientStop Offset="1" Color="#0B8A3E"/>
                </LinearGradientBrush>
            </Setter>
        </Style>

        <Style Selector="Border.iconoImpresora.ok PathIcon">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Interruptor de la báscula en verde -->
        <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="#16A34A"/>
            <Setter Property="BorderBrush" Value="#16A34A"/>
        </Style>

        <Style Selector="ToggleSwitch:checked:pointerover /template/ Border#SwitchKnobBounds">
            <Setter Property="Background" Value="#0E9A46"/>
            <Setter Property="BorderBrush" Value="#0E9A46"/>
        </Style>

        <Style Selector="ToggleSwitch">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Lista de impresoras -->
        <Style Selector="ComboBox.campo">
            <Setter Property="Height" Value="52"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="CornerRadius" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Styles>


    <ScrollViewer
        VerticalScrollBarVisibility="Auto"
        HorizontalScrollBarVisibility="Disabled">

        <StackPanel
            Margin="28,24,28,28"
            Spacing="20">


            <!-- ================================================= -->
            <!-- ENCABEZADO                                        -->
            <!-- ================================================= -->

            <Border x:Name="BannerConfiguracion"
                    CornerRadius="24"
                    ClipToBounds="True"
                    Background="#050607"
                    MinHeight="160">

                <Panel>

                    <Ellipse Width="520" Height="520"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-200,-280,0,0"
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#8816A34A"/>
                                <GradientStop Offset="1" Color="#0016A34A"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="460" Height="460"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-160,-300"
                             IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Offset="0" Color="#66F5C400"/>
                                <GradientStop Offset="1" Color="#00F5C400"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="24"
                          Margin="34,28">

                        <StackPanel VerticalAlignment="Center">

                            <Border HorizontalAlignment="Left"
                                    Padding="12,6"
                                    CornerRadius="999"
                                    Background="#14FFFFFF"
                                    BorderBrush="#24FFFFFF"
                                    BorderThickness="1">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Width="12" Height="12"
                                              Foreground="#86EFAC"
                                              Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
                                    <TextBlock Text="AJUSTES DE ESTE EQUIPO"
                                               Foreground="#D9E2EC"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               LetterSpacing="1.2"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Configuración del equipo"
                                       Foreground="White"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       LetterSpacing="-0.8"
                                       Margin="0,14,0,0"/>

                            <TextBlock Text="Impresora de tickets, cajón de dinero y báscula de este punto de venta."
                                       Foreground="#A8B4C2"
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,6,0,0"/>

                        </StackPanel>

                        <!-- Escena animada: equipo, impresora y cajón -->
                        <controls:EscenaConfiguracionAnimada x:Name="EscenaConfiguracion"
                                                             Grid.Column="1"
                                                             MaxWidth="420"
                                                             VerticalAlignment="Center"/>

                        <!-- Estado rápido -->
                        <Border Grid.Column="2"
                                VerticalAlignment="Center"
                                Padding="18,14"
                                CornerRadius="18"
                                Background="#12FFFFFF"
                                BorderBrush="#22FFFFFF"
                                BorderThickness="1">
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="12"
                                            IsVisible="{Binding HayImpresoraConfigurada}">
                                    <Border Width="40" Height="40"
                                            CornerRadius="20"
                                            Background="#22C55E">
                                        <PathIcon Width="18" Height="18"
                                                  Foreground="White"
                                                  Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="IMPRESORA FIJADA"
                                                   Foreground="#86EFAC"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   LetterSpacing="1.2"/>
                                        <TextBlock Text="{Binding ImpresoraConfigurada}"
                                                   Foreground="White"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   MaxWidth="260"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="12"
                                            IsVisible="{Binding NoHayImpresoraConfigurada}">
                                    <Border Width="40" Height="40"
                                            CornerRadius="20"
                                            Background="#33FFFFFF">
                                        <PathIcon Width="18" Height="18"
                                                  Foreground="White"
                                                  Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="SIN IMPRESORA"
                                                   Foreground="#FCD34D"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   LetterSpacing="1.2"/>
                                        <TextBlock Text="Pendiente de configurar"
                                                   Foreground="White"
                                                   FontSize="15"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>

                </Panel>

            </Border>


            <!-- ================================================= -->
            <!-- MENSAJES                                          -->
            <!-- ================================================= -->

            <Border Padding="16,12"
                    CornerRadius="14"
                    Background="#FEF2F2"
                    BorderBrush="#FECACA"
                    BorderThickness="1"
                    IsVisible="{Binding HayError}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Width="18" Height="18"
                              Foreground="#C61F2B"
                              Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                    <TextBlock Text="{Binding MensajeError}"
                               Foreground="#9F1239"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Padding="16,12"
                    CornerRadius="14"
                    Background="#EAF7EF"
                    BorderBrush="#BFE6CD"
                    BorderThickness="1"
                    IsVisible="{Binding HayExito}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Width="18" Height="18"
                              Foreground="#16A34A"
                              Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    <TextBlock Text="{Binding MensajeExito}"
                               Foreground="#0B6B33"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Padding="16,12"
                    CornerRadius="14"
                    Background="#EEF4FB"
                    IsVisible="{Binding EstaOcupado}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <PathIcon Width="16" Height="16"
                              Foreground="#2563EB"
                              Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/>
                    <TextBlock Text="Comunicándose con la impresora…"
                               Foreground="#1E4F8A"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True"
                                 Width="80"
                                 MinWidth="80"
                                 Height="4"
                                 Foreground="#2563EB"
                                 Background="#DCE8F8"
                                 VerticalAlignment="Center"/>
                </StackPanel>
            </Border>


            <!-- ================================================= -->
            <!-- IMPRESORA DE TICKETS                              -->
            <!-- ================================================= -->

            <Border Classes="seccion">

                <StackPanel Spacing="20">

                    <StackPanel Spacing="2">
                        <TextBlock Classes="tituloSeccion" Text="Impresora de tickets"/>
                        <TextBlock Classes="subtituloSeccion"
                                   Text="Cada punto de venta tiene su propia impresora. Una vez fijada, se usa para los tickets, las pruebas y la apertura del cajón hasta que se quite."/>
                    </StackPanel>

                    <!-- ¿Cómo funciona? -->
                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="12">

                        <Border Grid.Column="0" Classes="paso">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Classes="numeroPaso"><TextBlock Text="1"/></Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="tituloPaso" Text="Lee las impresoras"/>
                                    <TextBlock Classes="detallePaso" Text="El sistema consulta las impresoras instaladas en Windows."/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Classes="paso">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Classes="numeroPaso"><TextBlock Text="2"/></Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="tituloPaso" Text="Elige y fíjala"/>
                                    <TextBlock Classes="detallePaso" Text="Se guarda en este equipo y se usa siempre para imprimir."/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Classes="paso">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border Classes="numeroPaso"><TextBlock Text="3"/></Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Classes="tituloPaso" Text="Pruébala"/>
                                    <TextBlock Classes="detallePaso" Text="Imprime una prueba y abre el cajón para confirmar."/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </Grid>


                    <!-- ============ CON IMPRESORA FIJADA ============ -->

                    <Border IsVisible="{Binding HayImpresoraConfigurada}"
                            Padding="20,18"
                            CornerRadius="18"
                            Background="#F8FAFB"
                            BorderBrush="#EEF1F4"
                            BorderThickness="1">

                        <StackPanel Spacing="18">

                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="16">

                                <Border Classes="iconoImpresora"
                                        Classes.ok="{Binding EstadoImpresoraOk}"
                                        Width="60" Height="60"
                                        CornerRadius="18"
                                        VerticalAlignment="Center">
                                    <PathIcon Width="28" Height="28"
                                              Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="5">
                                    <TextBlock Text="IMPRESORA FIJA DE ESTE EQUIPO"
                                               Foreground="#94A3B8"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               LetterSpacing="1.2"/>
                                    <TextBlock Text="{Binding ImpresoraConfigurada}"
                                               Foreground="#0B1220"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>
                                    <Border Classes="estadoImpresora"
                                            Classes.ok="{Binding EstadoImpresoraOk}">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Ellipse Width="7" Height="7"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding EstadoImpresora}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                            </Grid>

                            <WrapPanel Orientation="Horizontal">

                                <Button Classes="boton verde"
                                        Command="{Binding ImprimirPruebaCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="16" Height="16"
                                                  Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/>
                                        <TextBlock Text="Imprimir prueba" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Classes="boton gris"
                                        Command="{Binding AbrirCajonCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="16" Height="16"
                                                  Data="M19 14V6c0-1.1-.9-2-2-2H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zm-9-1c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm13-6v11c0 1.1-.9 2-2 2H4v-2h17V7h2z"/>
                                        <TextBlock Text="Probar cajón" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Classes="boton rojo"
                                        Command="{Binding QuitarImpresoraCommand}"
                                        ToolTip.Tip="Requiere autorización de un administrador">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Width="15" Height="15"
                                                  Data="M18 8h-1V6c0-2.8-2.2-5-5-5S7 3.2 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.7 1.4-3.1 3.1-3.1s3.1 1.4 3.1 3.1v2z"/>
                                        <TextBlock Text="Quitar impresora" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                            </WrapPanel>

                            <TextBlock Text="Para quitar o cambiar la impresora se pide la autorización de un administrador."
                                       Foreground="#94A3B8"
                                       FontSize="12"
                                       Margin="0,-8,0,0"/>

                        </StackPanel>

                    </Border>


                    <!-- ============ SIN IMPRESORA ============ -->

                    <StackPanel IsVisible="{Binding NoHayImpresoraConfigurada}"
                                Spacing="14">

                        <Border Padding="14,12"
                                CornerRadius="14"
                                Background="#FFF7E0"
                                BorderBrush="#FBD98A"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <PathIcon Width="18" Height="18"
                                          Foreground="#B7791F"
                                          Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                                <TextBlock Text="Este equipo todavía no tiene impresora. Elige una de la lista y presiona «Fijar impresora»."
                                           Foreground="#7A4E05"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="8">
                            <TextBlock Text="Impresoras instaladas en Windows"
                                       Foreground="#334155"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <ComboBox Classes="campo"
                                      ItemsSource="{Binding ImpresorasDisponibles}"
                                      SelectedItem="{Binding ImpresoraSeleccionada, Mode=TwoWay}"
                                      PlaceholderText="Selecciona una impresora"/>
                        </StackPanel>

                        <WrapPanel Orientation="Horizontal">

                            <Button Classes="boton verde"
                                    Command="{Binding GuardarImpresoraCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Width="16" Height="16"
                                              Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                    <TextBlock Text="Fijar impresora" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Classes="boton gris"
                                    Command="{Binding LeerImpresorasCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <PathIcon Width="15" Height="15"
                                              Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                                    <TextBlock Text="Volver a leer impresoras" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                        </WrapPanel>

                    </StackPanel>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- BÁSCULA                                           -->
            <!-- ================================================= -->

            <Border Classes="seccion">

                <StackPanel Spacing="20">

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="14">

                        <Border Classes="iconoImpresora"
                                Classes.ok="{Binding BasculaHabilitada}"
                                Width="48" Height="48"
                                CornerRadius="15"
                                VerticalAlignment="Center">
                            <PathIcon Width="24" Height="24"
                                      Data="M12 3c-1.27 0-2.4.8-2.82 2H3v2h1.95L2 14c-.47 2 1 3 3.5 3s4.06-1 3.5-3L6.05 7h3.12c.33.85.98 1.5 1.83 1.83V20H2v2h20v-2h-9V8.82c.85-.32 1.5-.97 1.82-1.82h3.13L15 14c-.47 2 1 3 3.5 3s4.06-1 3.5-3l-2.95-7H21V5h-6.17C14.4 3.8 13.27 3 12 3zM5.53 14 6 12l.47 2H5.53zm13 0 .47-2 .47 2h-.94zM12 5c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1z"/>
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Spacing="2"
                                    VerticalAlignment="Center">
                            <TextBlock Classes="tituloSeccion" Text="Báscula"
                                       ClipToBounds="False"/>
                            <TextBlock Classes="subtituloSeccion"
                                       Text="Báscula conectada por USB (por ejemplo Noval N40). Al vender por KG el peso aparece solo en «Capturar peso»."/>
                        </StackPanel>

                        <ToggleSwitch Grid.Column="2"
                                      VerticalAlignment="Center"
                                      IsVisible="{Binding HayBasculaGuardada}"
                                      IsChecked="{Binding BasculaHabilitada, Mode=TwoWay}"
                                      OnContent="Activa"
                                      OffContent="Desactivada"/>

                    </Grid>

                    <Border Classes="estadoImpresora"
                            Classes.ok="{Binding BasculaHabilitada}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Ellipse Width="7" Height="7"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ResumenBascula}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>


                    <!-- Datos de conexión + lectura en vivo -->
                    <Grid ColumnDefinitions="*,300"
                          ColumnSpacing="16">

                        <StackPanel Spacing="12">

                            <StackPanel Spacing="8">
                                <TextBlock Text="Puerto de la báscula"
                                           Foreground="#334155"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <ComboBox Classes="campo"
                                          ItemsSource="{Binding PuertosDisponibles}"
                                          SelectedItem="{Binding PuertoSeleccionado, Mode=TwoWay}"
                                          PlaceholderText="Conecta la báscula y elige su puerto (COM…)"/>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12">

                                <StackPanel Spacing="8">
                                    <TextBlock Text="Velocidad (baudios)"
                                               Foreground="#334155"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    <ComboBox Classes="campo"
                                              ItemsSource="{Binding VelocidadesDisponibles}"
                                              SelectedItem="{Binding VelocidadSeleccionada, Mode=TwoWay}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Comando para pedir el peso"
                                               Foreground="#334155"
                                               FontSize="13"
                                               FontWeight="SemiBold"/>
                                    <TextBox Text="{Binding ComandoBascula, Mode=TwoWay}"
                                             PlaceholderText="Vacío = la báscula lo manda sola"
                                             Height="52"
                                             FontSize="15"
                                             CornerRadius="13"
                                             VerticalContentAlignment="Center"
                                             Padding="14,0"/>
                                </StackPanel>

                            </Grid>

                        </StackPanel>

                        <!-- Lectura en vivo -->
                        <Border Grid.Column="1"
                                Padding="18,16"
                                CornerRadius="18"
                                Background="#0B1220">
                            <StackPanel Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="LECTURA DE LA BÁSCULA"
                                       ClipToBounds="False"
                                           Foreground="#86EFAC"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           LetterSpacing="1.2"/>
                                <TextBlock Text="{Binding PesoPrueba}"
                                           IsVisible="{Binding !NoHayLecturaBascula}"
                                           Foreground="White"
                                           FontSize="38"
                                           FontWeight="Bold"
                                           LetterSpacing="-0.8"/>
                                <TextBlock Text="— kg"
                                           IsVisible="{Binding NoHayLecturaBascula}"
                                           Foreground="#475569"
                                           FontSize="38"
                                           FontWeight="Bold"/>
                                <TextBlock Text="{Binding EstadoPesoPrueba}"
                                           Foreground="#A8B4C2"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Presiona «Probar lectura» y pon algo en la báscula."
                                           IsVisible="{Binding !ProbandoBascula}"
                                           Foreground="#64748B"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                    </Grid>


                    <!-- Buscando la báscula -->
                    <Border Padding="16,12"
                            CornerRadius="14"
                            Background="#EEF4FB"
                            IsVisible="{Binding DetectandoBascula}">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding ProgresoDeteccion}"
                                       Foreground="#1E4F8A"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <ProgressBar IsIndeterminate="True"
                                         Width="80"
                                         MinWidth="80"
                                         Height="4"
                                         Foreground="#2563EB"
                                         Background="#DCE8F8"
                                         VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>


                    <WrapPanel Orientation="Horizontal">

                        <Button Classes="boton verde"
                                Command="{Binding DetectarBasculaCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Width="16" Height="16"
                                          Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                                <TextBlock Text="Detectar báscula"
                                           IsVisible="{Binding !DetectandoBascula}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Cancelar búsqueda"
                                           IsVisible="{Binding DetectandoBascula}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="boton gris"
                                IsEnabled="{Binding !DetectandoBascula}"
                                Command="{Binding ProbarBasculaCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Width="15" Height="15"
                                          Data="M8 5v14l11-7z"/>
                                <TextBlock Text="Probar lectura"
                                           IsVisible="{Binding !ProbandoBascula}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="Detener prueba"
                                           IsVisible="{Binding ProbandoBascula}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="boton verde"
                                IsEnabled="{Binding !DetectandoBascula}"
                                Command="{Binding GuardarBasculaCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Width="16" Height="16"
                                          Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                <TextBlock Text="Guardar báscula" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="boton gris"
                                IsEnabled="{Binding !DetectandoBascula}"
                                Command="{Binding LeerPuertosCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Width="15" Height="15"
                                          Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                                <TextBlock Text="Volver a leer puertos" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="boton rojo"
                                IsVisible="{Binding HayBasculaGuardada}"
                                Command="{Binding QuitarBasculaCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Width="15" Height="15"
                                          Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                <TextBlock Text="Quitar báscula" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </WrapPanel>


                    <!-- Lo que manda la báscula (para diagnóstico) -->
                    <Border IsVisible="{Binding HayTramasBascula}"
                            Padding="16,14"
                            CornerRadius="14"
                            Background="#F8FAFB"
                            BorderBrush="#EEF1F4"
                            BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Text="DATOS RECIBIDOS DE LA BÁSCULA"
                                       ClipToBounds="False"
                                       Foreground="#94A3B8"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       LetterSpacing="1.2"/>
                            <ItemsControl ItemsSource="{Binding TramasBascula}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <SelectableTextBlock Text="{Binding}"
                                                             FontFamily="Menlo, Consolas, monospace"
                                                             FontSize="12"
                                                             Foreground="#334155"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- TERMINALES DE COBRO CON TARJETA                   -->
            <!-- ================================================= -->

            <Border Classes="seccion">

                <Border.Styles>

                    <Style Selector="TextBox.campoT">
                        <Setter Property="Height" Value="46"/>
                        <Setter Property="FontSize" Value="14"/>
                        <Setter Property="CornerRadius" Value="12"/>
                        <Setter Property="Padding" Value="12,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>

                    <Style Selector="TextBlock.etiquetaT">
                        <Setter Property="Foreground" Value="#334155"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Margin" Value="0,0,0,6"/>
                    </Style>

                    <Style Selector="Border.tarjetaTerminal">
                        <Setter Property="Padding" Value="16,14"/>
                        <Setter Property="CornerRadius" Value="14"/>
                        <Setter Property="Background" Value="#F8FAFB"/>
                        <Setter Property="BorderBrush" Value="#EEF1F4"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>

                    <Style Selector="Border.insigniaTerminal">
                        <Setter Property="Padding" Value="10,3"/>
                        <Setter Property="CornerRadius" Value="999"/>
                        <Setter Property="Background" Value="#E8F0FE"/>
                        <Setter Property="HorizontalAlignment" Value="Left"/>
                    </Style>

                    <Style Selector="Border.insigniaTerminal TextBlock">
                        <Setter Property="Foreground" Value="#1D4ED8"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Style>

                    <Style Selector="Border.mensajeTerminal">
                        <Setter Property="Padding" Value="14,12"/>
                        <Setter Property="CornerRadius" Value="14"/>
                        <Setter Property="Background" Value="#EEF4FF"/>
                        <Setter Property="BorderBrush" Value="#C7D8F5"/>
                        <Setter Property="BorderThickness" Value="1"/>
                    </Style>
                    <Style Selector="Border.mensajeTerminal TextBlock">
                        <Setter Property="Foreground" Value="#1E4F8A"/>
                    </Style>
                    <Style Selector="Border.mensajeTerminal.error">
                        <Setter Property="Background" Value="#FDECEC"/>
                        <Setter Property="BorderBrush" Value="#F5C2C2"/>
                    </Style>
                    <Style Selector="Border.mensajeTerminal.error TextBlock">
                        <Setter Property="Foreground" Value="#9B1C1C"/>
                    </Style>

                    <Style Selector="Button.chico">
                        <Setter Property="Height" Value="38"/>
                        <Setter Property="Padding" Value="14,0"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Margin" Value="0,0,8,0"/>
                    </Style>

                </Border.Styles>

                <StackPanel Spacing="18">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="tituloSeccion" Text="Terminales de cobro con tarjeta"/>
                            <TextBlock Classes="subtituloSeccion"
                                       Text="Vincula las terminales bancarias de este equipo. Las inalámbricas reciben el importe por la red y devuelven el resultado solas; las alámbricas se cobran capturando las terminaciones del número de pago."/>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Classes="boton verde"
                                Margin="0"
                                VerticalAlignment="Top"
                                Command="{Binding NuevaTerminalCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Width="14" Height="14"
                                          Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                                <TextBlock Text="Agregar terminal" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>


                    <!-- Mensaje de la sección -->
                    <Border Classes="mensajeTerminal"
                            Classes.error="{Binding MensajeTerminalEsError}"
                            IsVisible="{Binding HayMensajeTerminal}">
                        <TextBlock Text="{Binding MensajeTerminal}"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>


                    <!-- Sin terminales -->
                    <Border IsVisible="{Binding NoHayTerminalesPago}"
                            Padding="14,12"
                            CornerRadius="14"
                            Background="#FFF7E0"
                            BorderBrush="#FBD98A"
                            BorderThickness="1">
                        <TextBlock Text="Este equipo no tiene terminales. Mientras no agregues una, el cobro con tarjeta usa Mercado Pago."
                                   Foreground="#7A4E05"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </Border>


                    <!-- Lista -->
                    <ItemsControl ItemsSource="{Binding TerminalesPago}"
                                  IsVisible="{Binding HayTerminalesPago}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="cfg:TerminalPagoConfiguration">
                                <Border Classes="tarjetaTerminal" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">

                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Nombre}"
                                                           Foreground="#0F172A"
                                                           FontSize="15"
                                                           FontWeight="Bold"/>
                                                <Border Classes="insigniaTerminal">
                                                    <TextBlock Text="{Binding TipoTexto}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Resumen}"
                                                       Foreground="#64748B"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="Desactivada: no se ofrece al cobrar"
                                                       IsVisible="{Binding !Activa}"
                                                       Foreground="#B45309"
                                                       FontSize="12"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Classes="boton gris chico"
                                                    IsVisible="{Binding EsInalambrica}"
                                                    Command="{Binding $parent[ItemsControl].((vm:ConfiguracionViewModel)DataContext).ProbarTerminalCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="Probar conexión"/>
                                            <Button Classes="boton gris chico"
                                                    Command="{Binding $parent[ItemsControl].((vm:ConfiguracionViewModel)DataContext).EditarTerminalCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="Editar"/>
                                            <Button Classes="boton rojo chico"
                                                    Margin="0"
                                                    Command="{Binding $parent[ItemsControl].((vm:ConfiguracionViewModel)DataContext).QuitarTerminalCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="Quitar"/>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>


                    <!-- Formulario alta / edición -->
                    <Border IsVisible="{Binding FormularioTerminalVisible}"
                            Padding="20"
                            CornerRadius="16"
                            Background="#FFFFFF"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1">

                        <StackPanel Spacing="16">

                            <TextBlock Classes="tituloPaso"
                                       FontSize="15"
                                       Text="{Binding TituloFormularioTerminal}"/>

                            <StackPanel>
                                <TextBlock Classes="etiquetaT" Text="Tipo de conexión"/>
                                <StackPanel Orientation="Horizontal" Spacing="24">
                                    <RadioButton GroupName="TipoTerminal"
                                                 Content="Inalámbrica (red / Wi-Fi)"
                                                 IsChecked="{Binding FormEsInalambrica, Mode=TwoWay}"/>
                                    <RadioButton GroupName="TipoTerminal"
                                                 Content="Alámbrica (cobro manual)"
                                                 IsChecked="{Binding FormEsAlambrica, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Classes="etiquetaT" Text="Nombre de la terminal"/>
                                <TextBox Classes="campoT"
                                         Text="{Binding FormNombreTerminal, Mode=TwoWay}"
                                         Watermark="Ej. Terminal caja 1"
                                         MaxLength="60"/>
                            </StackPanel>

                            <!-- Solo inalámbricas: datos de red -->
                            <StackPanel Spacing="16" IsVisible="{Binding FormEsInalambrica}">

                                <Grid ColumnDefinitions="*,140,Auto" ColumnSpacing="12">
                                    <StackPanel>
                                        <TextBlock Classes="etiquetaT" Text="IP o host de la terminal"/>
                                        <TextBox Classes="campoT"
                                                 Text="{Binding FormHostTerminal, Mode=TwoWay}"
                                                 Watermark="192.168.1.50"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="etiquetaT" Text="Puerto"/>
                                        <TextBox Classes="campoT"
                                                 Text="{Binding FormPuertoTerminal, Mode=TwoWay}"
                                                 MaxLength="5"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2"
                                              Content="Usar HTTPS"
                                              VerticalAlignment="Bottom"
                                              Margin="0,0,0,8"
                                              IsChecked="{Binding FormUsarHttps, Mode=TwoWay}"/>
                                </Grid>

                                <Grid ColumnDefinitions="*,140" ColumnSpacing="12">
                                    <StackPanel>
                                        <TextBlock Classes="etiquetaT" Text="Código de la terminal"/>
                                        <TextBox Classes="campoT"
                                                 Text="{Binding FormCodigoTerminal, Mode=TwoWay}"
                                                 Watermark="Ej. TERM-01"
                                                 MaxLength="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Classes="etiquetaT" Text="Espera (seg.)"/>
                                        <TextBox Classes="campoT"
                                                 Text="{Binding FormTimeoutTerminal, Mode=TwoWay}"
                                                 MaxLength="2"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel>
                                    <TextBlock Classes="etiquetaT" Text="Clave de acceso de la terminal"/>
                                    <TextBox Classes="campoT"
                                             PasswordChar="●"
                                             Text="{Binding FormClaveTerminal, Mode=TwoWay}"
                                             Watermark="Clave que entrega la terminal (mínimo 16 caracteres)"
                                             MaxLength="200"/>
                                </StackPanel>

                            </StackPanel>

                            <CheckBox Content="Terminal activa (se ofrece al cobrar con tarjeta)"
                                      IsChecked="{Binding FormActivaTerminal, Mode=TwoWay}"/>

                            <WrapPanel Orientation="Horizontal">
                                <Button Classes="boton verde"
                                        Command="{Binding GuardarTerminalCommand}"
                                        Content="Guardar terminal"/>
                                <Button Classes="boton gris"
                                        IsVisible="{Binding FormEsInalambrica}"
                                        Command="{Binding ProbarFormularioTerminalCommand}"
                                        Content="Probar conexión"/>
                                <Button Classes="boton gris"
                                        Command="{Binding CancelarFormularioTerminalCommand}"
                                        Content="Cancelar"/>
                            </WrapPanel>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </Border>


            <!-- ================================================= -->
            <!-- FORMATO DEL TICKET                                -->
            <!-- ================================================= -->
            <!-- Sección desactivada por el autor original. Si se   -->
            <!-- reactiva, usar ImprimirMuestraCommand y           -->
            <!-- RutaFormatoTicket del ViewModel.                  -->

        </StackPanel>

    </ScrollViewer>

</UserControl>
