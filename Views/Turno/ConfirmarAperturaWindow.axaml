<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        x:Class="NovaCoreESDM.Views.Turno.ConfirmarAperturaWindow"

        Title="Confirmar apertura"

        Icon="/Assets/Brand/esdm-app-icon.ico"

        Width="520"
        Height="390"

        MinWidth="420"
        MinHeight="340"

        CanResize="True"
        WindowStartupLocation="CenterOwner"

        Background="#F6F8F7">


    <!-- ========================================================= -->
    <!-- CONTENEDOR GENERAL                                        -->
    <!-- ========================================================= -->

    <Border Background="White"
            CornerRadius="18"
            Margin="14"
            Padding="28">


        <Grid RowDefinitions="Auto,*,Auto"
              RowSpacing="18">


            <!-- ================================================= -->
            <!-- ENCABEZADO                                        -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="0"
                        Spacing="10">


                <Border Width="54"
                        Height="54"
                        CornerRadius="27"
                        Background="#EAF7EF"
                        HorizontalAlignment="Left">

                    <TextBlock Text="?"
                               Foreground="#08783D"
                               FontSize="27"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                </Border>


                <TextBlock Text="Confirmar apertura de turno"
                           Foreground="#21382A"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- MENSAJE                                           -->
            <!-- ================================================= -->

            <StackPanel Grid.Row="1"
                        VerticalAlignment="Center"
                        Spacing="8">


                <TextBlock Text="¿Estás seguro de iniciar tu turno con un fondo inicial de:"
                           Foreground="#718078"
                           FontSize="14"
                           TextWrapping="Wrap"/>


                <TextBlock x:Name="MontoTextBlock"
                           Text="$0.00"
                           Foreground="#08783D"
                           FontSize="30"
                           FontWeight="Bold"
                           TextWrapping="Wrap"/>


                <TextBlock Text="Una vez confirmado, comenzarás las operaciones de caja."
                           Foreground="#94A39A"
                           FontSize="11"
                           TextWrapping="Wrap"
                           LineHeight="17"/>

            </StackPanel>


            <!-- ================================================= -->
            <!-- BOTONES                                           -->
            <!-- ================================================= -->

            <Grid Grid.Row="2"
                  ColumnDefinitions="*,*"
                  ColumnSpacing="12">


                <Button Grid.Column="0"
                        Content="Cancelar"
                        Click="Cancelar_Click"

                        MinWidth="130"
                        Height="48"

                        Background="White"
                        Foreground="#B51F2A"

                        BorderBrush="#F0B5BA"
                        BorderThickness="1"

                        CornerRadius="9"

                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"

                        FontSize="14"
                        FontWeight="SemiBold"/>


                <Button Grid.Column="1"
                        Content="Sí, iniciar turno"
                        Click="Confirmar_Click"

                        MinWidth="150"
                        Height="48"

                        Background="#16A34A"
                        Foreground="White"

                        BorderThickness="0"

                        CornerRadius="9"

                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"

                        FontSize="14"
                        FontWeight="SemiBold"/>

            </Grid>

        </Grid>

    </Border>

</Window>