<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NovaCoreESDM.Controls.EscenaReimpresionAnimada"
             IsHitTestVisible="False">

    <!-- ========================================================= -->
    <!-- ESCENA ANIMADA DE REIMPRESIÓN                             -->
    <!-- ========================================================= -->
    <!-- Una lupa recorre el historial y encuentra un ticket; la   -->
    <!-- impresora saca la "COPIA". Vectorial y escalable (lienzo  -->
    <!-- de diseño de 560 x 180). Ciclo de 5 s.                    -->
    <!-- ========================================================= -->

    <UserControl.Styles>

        <!-- Lupa recorriendo los tickets -->
        <Style Selector="Panel.lupa">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="-10"/>
                    </KeyFrame>
                    <KeyFrame Cue="18%">
                        <Setter Property="TranslateTransform.X" Value="104"/>
                    </KeyFrame>
                    <KeyFrame Cue="30%">
                        <Setter Property="TranslateTransform.X" Value="52"/>
                    </KeyFrame>
                    <KeyFrame Cue="90%">
                        <Setter Property="TranslateTransform.X" Value="52"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="-10"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Ticket encontrado: se ilumina en verde -->
        <Style Selector="Border.encontrado">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="28%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="33%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="88%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Puntos viajando hacia la impresora -->
        <Style Selector="Line.flujo">
            <Style.Animations>
                <Animation Duration="0:0:0.5" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="StrokeDashOffset" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="StrokeDashOffset" Value="-12"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Line.flujo">
            <Setter Property="Opacity" Value="0"/>
        </Style>

        <Style Selector="Panel.flujoVisible">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="32%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="38%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="62%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="68%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Copia saliendo de la impresora -->
        <Style Selector="Border.copia">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="48%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="78%">
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="90%">
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- LED de la impresora mientras imprime -->
        <Style Selector="Ellipse.led">
            <Style.Animations>
                <Animation Duration="0:0:0.5"
                           IterationCount="Infinite"
                           PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.3"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Tickets del historial -->
        <Style Selector="Border.historial">
            <Setter Property="Width" Value="62"/>
            <Setter Property="Height" Value="84"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="8,9"/>
            <Setter Property="BoxShadow" Value="0 8 18 -8 #CC000000"/>
        </Style>

    </UserControl.Styles>


    <Viewbox Stretch="Uniform">

        <Canvas Width="560" Height="180">

            <!-- Superficie -->
            <Border Canvas.Left="20" Canvas.Top="162"
                    Width="520" Height="6"
                    CornerRadius="3"
                    Background="#1AFFFFFF"/>


            <!-- ============ HISTORIAL DE TICKETS ============ -->

            <Border Classes="historial" Canvas.Left="40" Canvas.Top="72" Opacity="0.75">
                <Border.RenderTransform>
                    <RotateTransform Angle="-6"/>
                </Border.RenderTransform>
                <StackPanel Spacing="6">
                    <Border Height="3" CornerRadius="2" Background="#94A3B8"/>
                    <Border Height="3" CornerRadius="2" Background="#CBD5E1" Margin="0,0,12,0"/>
                    <Border Height="3" CornerRadius="2" Background="#CBD5E1"/>
                    <Border Height="3" CornerRadius="2" Background="#CBD5E1" Margin="0,0,16,0"/>
                </StackPanel>
            </Border>

            <Border Classes="historial" Canvas.Left="96" Canvas.Top="66" Background="#F8FAFC">
                <Panel>
                    <StackPanel Spacing="6">
                        <Border Height="3" CornerRadius="2" Background="#94A3B8"/>
                        <Border Height="3" CornerRadius="2" Background="#CBD5E1" Margin="0,0,12,0"/>
                        <Border Height="3" CornerRadius="2" Background="#CBD5E1"/>
                        <Border Height="3" CornerRadius="2" Background="#CBD5E1" Margin="0,0,16,0"/>
                        <Border Height="5" Width="22" CornerRadius="2" Background="#16A34A" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                    </StackPanel>
                </Panel>
            </Border>

            <!-- Marco verde del ticket encontrado -->
            <Border Classes="encontrado"
                    Canvas.Left="91" Canvas.Top="61"
                    Width="72" Height="94"
                    CornerRadius="9"
                    BorderBrush="#22C55E"
                    BorderThickness="3"
                    BoxShadow="0 0 18 0 #8022C55E"/>

            <Border Classes="historial" Canvas.Left="152" Canvas.Top="72" Opacity="0.75">
                <Border.RenderTransform>
                    <RotateTransform Angle="6"/>
                </Border.RenderTransform>
                <StackPanel Spacing="6">
                    <Border Height="3" CornerRadius="2" Background="#94A3B8"/>
                    <Border Height="3" CornerRadius="2" Background="#CBD5E1" Margin="0,0,12,0"/>
                    <Border Height="3" CornerRadius="2" Background="#CBD5E1"/>
                    <Border Height="3" CornerRadius="2" Background="#CBD5E1" Margin="0,0,16,0"/>
                </StackPanel>
            </Border>

            <!-- Lupa -->
            <Panel Classes="lupa"
                   Canvas.Left="70" Canvas.Top="22"
                   Width="64" Height="64">
                <Panel.RenderTransform>
                    <TranslateTransform/>
                </Panel.RenderTransform>
                <PathIcon Width="60" Height="60"
                          Foreground="White"
                          Data="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </Panel>


            <!-- ============ FLUJO HACIA LA IMPRESORA ============ -->

            <Panel Classes="flujoVisible"
                   Canvas.Left="0" Canvas.Top="0"
                   Width="560" Height="180">
                <Line Classes="flujo"
                      StartPoint="230,112" EndPoint="352,60"
                      Stroke="#22C55E"
                      StrokeThickness="4"
                      StrokeLineCap="Round"
                      StrokeDashArray="0.1,3"
                      Opacity="1"/>
            </Panel>


            <!-- ============ IMPRESORA Y COPIA ============ -->

            <!-- Copia -->
            <Border Classes="copia"
                    Canvas.Left="388" Canvas.Top="56"
                    Width="96" Height="102"
                    CornerRadius="0,0,6,6"
                    Background="#F8FAFC"
                    Padding="10,10"
                    RenderTransformOrigin="50%,0%">
                <Border.RenderTransform>
                    <ScaleTransform/>
                </Border.RenderTransform>
                <StackPanel Spacing="6">
                    <Border HorizontalAlignment="Center"
                            Padding="8,1"
                            CornerRadius="4"
                            Background="#DCFCE7"
                            BorderBrush="#16A34A"
                            BorderThickness="1">
                        <TextBlock Text="COPIA"
                                   Foreground="#0B6B33"
                                   FontSize="10"
                                   FontWeight="Black"
                                   LetterSpacing="1.5"/>
                    </Border>
                    <Border Height="3" CornerRadius="2" Background="#CBD5E1"/>
                    <Border Height="3" CornerRadius="2" Background="#CBD5E1" Margin="0,0,18,0"/>
                    <Border Height="3" CornerRadius="2" Background="#CBD5E1" Margin="0,0,8,0"/>
                    <Border Height="1" Background="#94A3B8" Margin="0,2,0,0"/>
                    <Border Height="7" Width="30" CornerRadius="2" Background="#16A34A" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <!-- Cuerpo de la impresora -->
            <Border Canvas.Left="366" Canvas.Top="14"
                    Width="140" Height="46"
                    CornerRadius="14"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#3A4250"/>
                        <GradientStop Offset="1" Color="#1E242E"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ColumnDefinitions="Auto,*" Margin="14,0">
                    <Ellipse Classes="led"
                             Width="9" Height="9"
                             Fill="#3B82F6"
                             VerticalAlignment="Center"/>
                    <PathIcon Grid.Column="1"
                              Width="20" Height="20"
                              Foreground="#D9E2EC"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Data="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/>
                </Grid>
            </Border>

            <!-- Ranura -->
            <Border Canvas.Left="382" Canvas.Top="54"
                    Width="108" Height="5"
                    CornerRadius="3"
                    Background="#0B0F14"/>

        </Canvas>

    </Viewbox>

</UserControl>
