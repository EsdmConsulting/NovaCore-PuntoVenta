            <!-- ============ RESULTADO ============ -->

            <Border Canvas.Left="414" Canvas.Top="26"
                    Width="128" Height="132"
                    CornerRadius="16"
                    Background="#14FFFFFF"
                    BorderBrush="#2AFFFFFF"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,*" Margin="12,12,12,10">
                    <StackPanel Spacing="4">
                        <Border Width="46" Height="4" CornerRadius="2"
                                Background="#7FFFFFFF" HorizontalAlignment="Left"/>
                        <Border Width="70" Height="7" CornerRadius="3"
                                Background="#E6FFFFFF" HorizontalAlignment="Left"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Center">
                        <Border Classes="barra r1" Height="58">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0" Color="#4ADE80"/>
                                    <GradientStop Offset="1" Color="#16A34A"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Classes="barra r2" Height="40">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0" Color="#60A5FA"/>
                                    <GradientStop Offset="1" Color="#2563EB"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Classes="barra r3" Height="26">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0" Color="#FDE047"/>
                                    <GradientStop Offset="1" Color="#E0A800"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Classes="barra r4" Height="46">
                            <Border.RenderTransform>
                                <ScaleTransform/>
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Offset="0" Color="#A78BFA"/>
                                    <GradientStop Offset="1" Color="#6D4AE0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sello -->
            <Border Classes="sello"
                    Canvas.Left="452" Canvas.Top="10"
                    Padding="9,4"
                    CornerRadius="999"
                    Background="#F5C400"
                    BoxShadow="0 6 16 -4 #99F5C400"
                    RenderTransformOrigin="50%,50%">
                <Border.RenderTransform>
