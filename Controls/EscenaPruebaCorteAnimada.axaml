<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NovaCoreESDM.Controls.EscenaPruebaCorteAnimada"
             IsHitTestVisible="False">

    <!-- ========================================================= -->
    <!-- ESCENA ANIMADA DE PRUEBA DE CORTE                         -->
    <!-- ========================================================= -->
    <!-- Se marca un rango en el calendario, los tickets viajan    -->
    <!-- al simulador (anillo girando) y salen las barras del      -->
    <!-- resultado con su sello "SIMULADO". Vectorial y escalable  -->
    <!-- (lienzo de diseño de 560 x 180). Ciclo de 5 s.            -->
    <!-- ========================================================= -->

    <UserControl.Styles>

        <!-- Rango que se va marcando en el calendario -->
        <Style Selector="Border.rango">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="22%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="90%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.rangoDos">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="14%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="28%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="90%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Tickets viajando del calendario al simulador -->
        <Style Selector="Border.ticket">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="5,6"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="BoxShadow" Value="0 6 14 -6 #99000000"/>
        </Style>

        <Style Selector="Border.t1">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="24%">
                        <Setter Property="TranslateTransform.X" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="27%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="34%">
                        <Setter Property="TranslateTransform.X" Value="58"/>
                        <Setter Property="TranslateTransform.Y" Value="-22"/>
                    </KeyFrame>
                    <KeyFrame Cue="42%">
                        <Setter Property="TranslateTransform.X" Value="118"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="45%">
                        <Setter Property="TranslateTransform.X" Value="128"/>
                        <Setter Property="TranslateTransform.Y" Value="4"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="128"/>
                        <Setter Property="TranslateTransform.Y" Value="4"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.t2">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="31%">
                        <Setter Property="TranslateTransform.X" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="34%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="41%">
                        <Setter Property="TranslateTransform.X" Value="58"/>
                        <Setter Property="TranslateTransform.Y" Value="-26"/>
                    </KeyFrame>
                    <KeyFrame Cue="49%">
                        <Setter Property="TranslateTransform.X" Value="118"/>
                        <Setter Property="TranslateTransform.Y" Value="-8"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="52%">
                        <Setter Property="TranslateTransform.X" Value="128"/>
                        <Setter Property="TranslateTransform.Y" Value="-4"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="128"/>
                        <Setter Property="TranslateTransform.Y" Value="-4"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.t3">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="TranslateTransform.X" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="38%">
                        <Setter Property="TranslateTransform.X" Value="0"/>
                        <Setter Property="TranslateTransform.Y" Value="0"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="41%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="48%">
                        <Setter Property="TranslateTransform.X" Value="58"/>
                        <Setter Property="TranslateTransform.Y" Value="-18"/>
                    </KeyFrame>
                    <KeyFrame Cue="56%">
                        <Setter Property="TranslateTransform.X" Value="118"/>
                        <Setter Property="TranslateTransform.Y" Value="6"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="59%">
                        <Setter Property="TranslateTransform.X" Value="128"/>
                        <Setter Property="TranslateTransform.Y" Value="10"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="TranslateTransform.X" Value="128"/>
                        <Setter Property="TranslateTransform.Y" Value="10"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Anillo del simulador girando sin parar -->
        <Style Selector="Ellipse.anillo">
            <Style.Animations>
                <Animation Duration="0:0:4" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Ellipse.anilloContrario">
            <Style.Animations>
                <Animation Duration="0:0:6" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="360"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Brillo del simulador mientras procesa -->
        <Style Selector="Ellipse.brillo">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.25"/>
                    </KeyFrame>
                    <KeyFrame Cue="30%">
                        <Setter Property="Opacity" Value="0.25"/>
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="64%">
                        <Setter Property="Opacity" Value="0.4"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.25"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Flechas que llevan el resultado a la gráfica -->
        <Style Selector="Line.flujo">
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="StrokeDashOffset" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="StrokeDashOffset" Value="-8"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Panel.flujoVisible">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="52%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="56%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="82%">
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="88%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Barras del resultado creciendo una tras otra -->
        <Style Selector="Border.barra">
            <Setter Property="Width" Value="18"/>
            <Setter Property="CornerRadius" Value="5,5,2,2"/>
            <Setter Property="RenderTransformOrigin" Value="50%,100%"/>
        </Style>

        <Style Selector="Border.r1">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0.08"/>
                    </KeyFrame>
                    <KeyFrame Cue="56%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0.08"/>
                    </KeyFrame>
                    <KeyFrame Cue="64%">
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="92%">
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0.08"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.r2">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0.08"/>
                    </KeyFrame>
                    <KeyFrame Cue="60%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0.08"/>
                    </KeyFrame>
                    <KeyFrame Cue="68%">
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="92%">
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0.08"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.r3">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0.08"/>
                    </KeyFrame>
                    <KeyFrame Cue="64%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0.08"/>
                    </KeyFrame>
                    <KeyFrame Cue="72%">
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="92%">
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0.08"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.r4">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0.08"/>
                    </KeyFrame>
                    <KeyFrame Cue="68%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0.08"/>
                    </KeyFrame>
                    <KeyFrame Cue="76%">
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="92%">
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleY" Value="0.08"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Sello "SIMULADO" -->
        <Style Selector="Border.sello">
            <Style.Animations>
                <Animation Duration="0:0:5" IterationCount="Infinite" FillMode="Both">
                    <KeyFrame Cue="0%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="77%">
                        <Setter Property="ScaleTransform.ScaleX" Value="0"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                    <KeyFrame Cue="81%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1.15"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.15"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="84%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="92%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                        <Setter Property="Opacity" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                        <Setter Property="Opacity" Value="0"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Destellos -->
        <Style Selector="PathIcon.destello">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Data" Value="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z"/>
            <Style.Animations>
                <Animation Duration="0:0:1.6" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0.1"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.5"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.5"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1.1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1.1"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="PathIcon.destelloLento">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Data" Value="M12 0l2.6 9.4L24 12l-9.4 2.6L12 24l-2.6-9.4L0 12l9.4-2.6z"/>
            <Style.Animations>
                <Animation Duration="0:0:2.3" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.15"/>
                        <Setter Property="ScaleTransform.ScaleX" Value="0.5"/>
                        <Setter Property="ScaleTransform.ScaleY" Value="0.5"/>
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Días del calendario -->
        <Style Selector="Border.dia">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="#1FFFFFFF"/>
        </Style>

    </UserControl.Styles>


    <Viewbox Stretch="Uniform">

        <Canvas Width="560" Height="180">

            <!-- Superficie -->
            <Border Canvas.Left="20" Canvas.Top="166"
                    Width="520" Height="6"
                    CornerRadius="3"
                    Background="#1AFFFFFF"/>


            <!-- ============ CALENDARIO ============ -->

            <Border Canvas.Left="22" Canvas.Top="18"
                    Width="156" Height="140"
                    CornerRadius="16"
                    ClipToBounds="True"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Offset="0" Color="#323A47"/>
                        <GradientStop Offset="1" Color="#1B2029"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid RowDefinitions="34,*">

                    <!-- Encabezado con los aros -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                <GradientStop Offset="0" Color="#E0313D"/>
                                <GradientStop Offset="1" Color="#B3141F"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid ColumnDefinitions="*,Auto" Margin="12,0">
                            <Border Width="56" Height="6" CornerRadius="3"
                                    Background="#CCFFFFFF"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Fill="#66FFFFFF"/>
                                <Ellipse Width="7" Height="7" Fill="#66FFFFFF"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Días -->
                    <Panel Grid.Row="1" Margin="12,10,12,10">

                        <!-- Rango marcado (dos renglones) -->
                        <Canvas>
                            <Border Classes="rango"
                                    Canvas.Left="40" Canvas.Top="20"
                                    Width="92" Height="18"
                                    CornerRadius="9"
                                    RenderTransformOrigin="0%,50%">
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Offset="0" Color="#9922C55E"/>
                                        <GradientStop Offset="1" Color="#7722C55E"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Border Classes="rangoDos"
                                    Canvas.Left="-2" Canvas.Top="41"
                                    Width="88" Height="18"
                                    CornerRadius="9"
                                    RenderTransformOrigin="0%,50%">
                                <Border.RenderTransform>
                                    <ScaleTransform/>
                                </Border.RenderTransform>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                        <GradientStop Offset="0" Color="#7722C55E"/>
                                        <GradientStop Offset="1" Color="#99F5C400"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Canvas>

                        <UniformGrid Columns="6" Rows="4">
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia" Background="#F8FAFC"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia" Background="#FACC15"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                            <Border Classes="dia"/>
                        </UniformGrid>

                    </Panel>

                </Grid>
            </Border>


            <!-- ============ TICKETS VIAJANDO ============ -->

            <Border Classes="ticket t1" Canvas.Left="168" Canvas.Top="72">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <StackPanel Spacing="4">
                    <Border Height="3" CornerRadius="2" Background="#94A3B8"/>
                    <Border Height="2" CornerRadius="1" Background="#CBD5E1" Margin="0,0,6,0"/>
                    <Border Height="2" CornerRadius="1" Background="#CBD5E1"/>
                    <Border Height="4" Width="12" CornerRadius="2" Background="#16A34A" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <Border Classes="ticket t2" Canvas.Left="168" Canvas.Top="72">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <StackPanel Spacing="4">
                    <Border Height="3" CornerRadius="2" Background="#94A3B8"/>
                    <Border Height="2" CornerRadius="1" Background="#CBD5E1"/>
                    <Border Height="2" CornerRadius="1" Background="#CBD5E1" Margin="0,0,8,0"/>
                    <Border Height="4" Width="12" CornerRadius="2" Background="#2563EB" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>

            <Border Classes="ticket t3" Canvas.Left="168" Canvas.Top="72">
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>
                <StackPanel Spacing="4">
                    <Border Height="3" CornerRadius="2" Background="#94A3B8"/>
                    <Border Height="2" CornerRadius="1" Background="#CBD5E1" Margin="0,0,4,0"/>
                    <Border Height="2" CornerRadius="1" Background="#CBD5E1"/>
                    <Border Height="4" Width="12" CornerRadius="2" Background="#8B5CF6" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>


            <!-- ============ SIMULADOR ============ -->

            <!-- Halo -->
            <Ellipse Classes="brillo"
                     Canvas.Left="262" Canvas.Top="30"
                     Width="120" Height="120">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Offset="0" Color="#9922C55E"/>
                        <GradientStop Offset="0.6" Color="#3322C55E"/>
                        <GradientStop Offset="1" Color="#0022C55E"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- Anillos -->
            <Ellipse Classes="anillo"
                     Canvas.Left="277" Canvas.Top="45"
                     Width="90" Height="90"
                     Stroke="#22C55E"
                     StrokeThickness="3"
                     StrokeDashArray="6,4"
                     StrokeLineCap="Round"
                     RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform>
                    <RotateTransform/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <Ellipse Classes="anilloContrario"
                     Canvas.Left="289" Canvas.Top="57"
                     Width="66" Height="66"
                     Stroke="#FACC15"
                     StrokeThickness="2"
                     StrokeDashArray="2,5"
                     StrokeLineCap="Round"
                     RenderTransformOrigin="50%,50%">
                <Ellipse.RenderTransform>
                    <RotateTransform/>
                </Ellipse.RenderTransform>
            </Ellipse>

            <!-- Núcleo con el matraz -->
            <Border Canvas.Left="298" Canvas.Top="66"
                    Width="48" Height="48"
                    CornerRadius="24"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="#22C55E"/>
                        <GradientStop Offset="1" Color="#0E7A3B"/>
                    </LinearGradientBrush>
                </Border.Background>
                <PathIcon Width="22" Height="22"
                          Foreground="White"
                          Data="M19.8 18.4L14 10.67V6.5l1.35-1.69c.26-.33.03-.81-.39-.81H9.04c-.42 0-.65.48-.39.81L10 6.5v4.17L4.2 18.4c-.49.66-.02 1.6.8 1.6h14c.82 0 1.29-.94.8-1.6z"/>
            </Border>


            <!-- ============ FLUJO HACIA EL RESULTADO ============ -->

            <Panel Classes="flujoVisible">
                <Canvas>
                    <Line Classes="flujo"
                          StartPoint="372,90" EndPoint="410,90"
                          Stroke="#8022C55E"
                          StrokeThickness="3"
                          StrokeDashArray="1,3"
                          StrokeLineCap="Round"/>
