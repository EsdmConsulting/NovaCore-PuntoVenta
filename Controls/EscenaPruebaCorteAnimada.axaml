                           FontSize="10"
                           FontWeight="Bold"
                           LetterSpacing="1"/>
            </Border>


            <!-- ============ DESTELLOS ============ -->

            <PathIcon Classes="destello" Canvas.Left="240" Canvas.Top="28" Foreground="#FACC15">
